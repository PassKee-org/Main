@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col bg-slate-100 text-slate-900 font-sans">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
            <a href="/" class="flex items-center gap-2.5 font-bold text-xl text-blue-600 hover:text-blue-700 transition">
                <i class="fa-solid fa-shield-halved text-2xl text-blue-600"></i>
                <span class="tracking-tight text-slate-900 font-extrabold">Pass<span class="text-blue-600">Kee</span></span>
            </a>

            <div class="flex items-center gap-3">
                <a href="/login" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-semibold text-slate-700 shadow-xs transition hover:border-slate-300 hover:bg-slate-50">
                    <i class="fa-solid fa-arrow-right-to-bracket text-xs text-slate-400"></i>
                    <span>Sign In</span>
                </a>
                <a href="/registration" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition hover:bg-blue-700">
                    <i class="fa-solid fa-user-plus text-xs"></i>
                    <span>Create Account</span>
                </a>
            </div>
        </div>
    </header>

    <main class="flex-1">
        @Body
    </main>

    <footer class="border-t border-slate-200 bg-white py-6 text-center text-xs text-slate-400">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p>&copy; @DateTime.UtcNow.Year PassKee. Zero-Knowledge Password & Secrets Manager.</p>
        </div>
    </footer>
</div>

<AppToastContainer />
<AppModalContainer />
