@namespace PassKee.Web.Shared.Modals
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<div class="flex flex-col overflow-hidden rounded-2xl bg-white text-gray-900 p-5 sm:p-6 space-y-5 max-w-sm sm:max-w-md w-full">
    @* Top Action Bar matching 1Password style *@
    <div class="flex items-center justify-between gap-3 border-b border-gray-100 pb-4">
        <AppButton Color="@ComponentColor.Default"
                   Variant="@ButtonVariant.Light"
                   Size="@ComponentSize.Small"
                   OnClick="Cancel"
                   Class="!text-gray-600 hover:!text-gray-900">
            Cancel
        </AppButton>
        <AppButton Color="@ComponentColor.Default"
                   Variant="@ButtonVariant.Light"
                   Size="@ComponentSize.Small"
                   IconOnly="true"
                   OnClick="Regenerate"
                   Title="Regenerate password"
                   aria-label="Regenerate password"
                   Class="!text-gray-600 hover:!text-gray-900 hover:!bg-gray-100">
            <i class="fa-solid fa-rotate-right text-sm" aria-hidden="true"></i>
        </AppButton>
        <AppButton Color="@ComponentColor.Primary"
                   Variant="@ButtonVariant.Solid"
                   Size="@ComponentSize.Small"
                   OnClick="UsePassword"
                   Class="!bg-blue-600 hover:!bg-blue-700 font-semibold text-white px-4">
            Use Password
        </AppButton>
    </div>

    @* Password Display Field with Colored Character Formatting *@
    <div class="space-y-2">
        <div class="relative flex items-center justify-between rounded-xl border border-gray-200/80 bg-gray-50/80 px-3.5 py-3 transition focus-within:border-blue-500">
            <div class="font-mono text-base font-semibold tracking-wider break-all select-all flex-1 min-w-0">
                @foreach (var ch in _password)
                {
                    if (char.IsDigit(ch))
                    {
                        <span class="text-blue-600">@ch</span>
                    }
                    else if (!char.IsLetterOrDigit(ch))
                    {
                        <span class="text-amber-600 font-bold">@ch</span>
                    }
                    else
                    {
                        <span class="text-gray-900">@ch</span>
                    }
                }
            </div>
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       OnClick="CopyToClipboardAsync"
                       Title="Copy to clipboard"
                       aria-label="Copy to clipboard"
                       Class="shrink-0 ml-2 !text-gray-400 hover:!text-gray-700 hover:!bg-gray-200/60">
                <i class="@(_isCopied ? "fa-solid fa-check text-emerald-600" : "fa-regular fa-copy") text-sm" aria-hidden="true"></i>
            </AppButton>
        </div>

        @* Strength Bar *@
        <div class="h-1 w-full bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full transition-all duration-300 @StrengthBarColorClass @StrengthBarWidthClass"></div>
        </div>
    </div>

    @* Password Options *@
    <div class="space-y-4 pt-1">
        <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Type</span>
            <select @bind="_generatorType"
                    @bind:after="Regenerate"
                    class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                <option value="Random">Random password</option>
                <option value="Pin">PIN code</option>
            </select>
        </div>

        <div class="space-y-1.5">
            <div class="flex items-center justify-between text-xs">
                <span class="font-semibold uppercase tracking-wider text-gray-500">Length</span>
                <span class="font-mono font-semibold text-gray-900 bg-gray-100 px-2 py-0.5 rounded text-xs">@_length</span>
            </div>
            <input type="range"
                   min="@(_generatorType == "Pin" ? 4 : 8)"
                   max="@(_generatorType == "Pin" ? 16 : 64)"
                   @bind="_length"
                   @bind:event="oninput"
                   @bind:after="Regenerate"
                   class="w-full accent-blue-600 cursor-pointer" />
        </div>

        @if (_generatorType == "Random")
        {
            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">Digits (0-9)</span>
                <AppSwitch Value="@_includeDigits"
                           ValueChanged="@(v => { _includeDigits = v; Regenerate(); })"
                           Size="@ComponentSize.Small" />
            </div>

            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">Symbols (!@@#$%)</span>
                <AppSwitch Value="@_includeSymbols"
                           ValueChanged="@(v => { _includeSymbols = v; Regenerate(); })"
                           Size="@ComponentSize.Small" />
            </div>

            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">Uppercase letters</span>
                <AppSwitch Value="@_includeUppercase"
                           ValueChanged="@(v => { _includeUppercase = v; Regenerate(); })"
                           Size="@ComponentSize.Small" />
            </div>
        }
    </div>
</div>
