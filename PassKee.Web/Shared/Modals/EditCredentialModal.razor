@namespace PassKee.Web.Shared.Modals
@using PassKee.Api.Shared.Models.Vaults.Payloads
@using PassKee.Business.Common.Constants
@using PassKee.Web.Shared.Modals.Parts
@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Dropdown
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<div class="flex max-h-[calc(100dvh-2rem)] sm:max-h-[88vh] flex-col rounded-2xl bg-gray-50 text-gray-900 [&_label]:!text-gray-500 [&_label]:!tracking-normal">
    <header class="flex shrink-0 items-center justify-between gap-4 border-b border-gray-200/70 bg-white px-5 py-4 sm:px-8 sm:py-5 rounded-t-2xl">
        <div class="flex min-w-0 items-center gap-3">
            @if (!_isEditing)
            {
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 text-lg">
                    <i class="@GetCredentialTypeIcon(Type)" aria-hidden="true"></i>
                </span>
                <div class="min-w-0 flex-1">
                    <h3 class="text-base sm:text-lg font-bold text-gray-900 truncate leading-snug">@(string.IsNullOrWhiteSpace(Title) ? "Untitled" : Title)</h3>
                    <p class="text-xs font-medium text-gray-400">@GetCredentialTypeLabel(Type)</p>
                </div>
            }
            else
            {
                <div class="min-w-0 flex-1">
                    <h3 class="text-base sm:text-lg font-bold text-gray-900 truncate leading-snug">@(_isExisting ? "Edit credential" : "New credential")</h3>
                </div>
            }
        </div>
        <div class="flex items-center gap-2 shrink-0">
            @if (!_isEditing)
            {
                <AppButton Color="@ComponentColor.Primary"
                           Variant="@ButtonVariant.Light"
                           Size="@ComponentSize.Small"
                           Class="!text-blue-600 hover:!bg-blue-50 font-medium"
                           OnClick="EnterEditMode"
                           Title="Edit credential">
                    <i class="fa-solid fa-pen mr-1.5" aria-hidden="true"></i>
                    Edit
                </AppButton>
                @if (_isExisting && _credentialId.HasValue)
                {
                    <AppDropdown Alignment="@DropdownAlignment.Right">
                        <Trigger>
                            <span class="flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors"
                                  title="More actions">
                                <i class="fa-solid fa-ellipsis-vertical text-sm" aria-hidden="true"></i>
                            </span>
                        </Trigger>
                        <Menu>
                            <AppDropdownItem OnClick="OpenMoveModalAsync">
                                <div class="flex items-center gap-2.5">
                                    <i class="fa-solid fa-folder-tree w-4 text-center text-gray-500" aria-hidden="true"></i>
                                    <span class="font-medium">Move...</span>
                                </div>
                            </AppDropdownItem>
                            <AppDropdownItem OnClick="DuplicateAsync">
                                <div class="flex items-center gap-2.5">
                                    <i class="fa-regular fa-copy w-4 text-center text-gray-500" aria-hidden="true"></i>
                                    <span class="font-medium">Duplicate</span>
                                </div>
                            </AppDropdownItem>
                            <AppDropdownItem OnClick="DeleteAsync"
                                             ShowDivider="true">
                                <div class="flex items-center gap-2.5 text-rose-600">
                                    <i class="fa-solid fa-trash w-4 text-center text-rose-500" aria-hidden="true"></i>
                                    <span class="font-medium">Delete</span>
                                </div>
                            </AppDropdownItem>
                        </Menu>
                    </AppDropdown>
                }
            }
            <AppButton OnClick="Cancel"
                       Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       aria-label="Close"
                       Title="Close"
                       Class="shrink-0 !text-gray-400 hover:!text-gray-700 hover:!bg-gray-100">
                <i class="fa-solid fa-xmark text-sm" aria-hidden="true"></i>
            </AppButton>
        </div>
    </header>

    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto overscroll-contain scrollbar-thin px-5 py-6 sm:px-8 sm:py-7 pb-10 sm:pb-12">
        @if (!_isEditing)
        {
            @if (Type != CredentialType.SecureNote && Type != CredentialType.Database)
            {
                <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6 space-y-4">
                    <h4 class="text-sm font-semibold text-gray-700">@(Type == CredentialType.Card ? "Card details" : (Type == CredentialType.SshKey ? "Private key" : "Credentials"))</h4>
                    @if (Type == CredentialType.Login || Type == CredentialType.Password || Type == CredentialType.Server)
                    {
                        @if (Type == CredentialType.Server && !string.IsNullOrWhiteSpace(Website))
                        {
                            <CredentialViewFieldBlock Label="Server URL"
                                                      Value="@Website"
                                                      IsUrl="true" />
                        }
                        <CredentialViewFieldBlock Label="Username / Email"
                                                  Value="@Username" />
                        <CredentialViewFieldBlock Label="Password"
                                                  Value="@Password"
                                                  IsSecret="true" />
                    }
                    @if (Type == CredentialType.Login && !string.IsNullOrWhiteSpace(Website))
                    {
                        <CredentialViewFieldBlock Label="Website"
                                                  Value="@Website"
                                                  IsUrl="true" />
                    }
                    @if (Type == CredentialType.Card)
                    {
                        <CredentialViewFieldBlock Label="Cardholder name"
                                                  Value="@CardholderName" />
                        <CredentialViewFieldBlock Label="Card number"
                                                  Value="@CardNumber"
                                                  IsSecret="true" />
                        <div class="grid grid-cols-2 gap-4">
                            <CredentialViewFieldBlock Label="Expires"
                                                      Value="@ExpirationDate" />
                            <CredentialViewFieldBlock Label="CVV"
                                                      Value="@Cvv"
                                                      IsSecret="true" />
                        </div>
                    }
                    @if (Type == CredentialType.File || Type == CredentialType.SshKey)
                    {
                        <CredentialFileViewBlock Label="@(Type == CredentialType.SshKey ? "Private Key File" : "File Attachment")" File="@File" />
                    }
                </AppCard>
            }

            @if (_additionalFields.Any() || _sections.Any())
            {
                <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6 space-y-4">
                    <h4 class="text-sm font-semibold text-gray-700">Additional fields</h4>
                    @foreach (var field in _additionalFields)
                    {
                        if (field.Type == CredentialFieldType.File)
                        {
                            <CredentialFileViewBlock Label="@field.Label" File="@field.File" />
                        }
                        else
                        {
                            <CredentialViewFieldBlock Label="@field.Label"
                                                      Value="@field.Value"
                                                      Type="@field.Type"
                                                      IsSecret="@(field.Type is CredentialFieldType.Password or CredentialFieldType.OneTimePassword or CredentialFieldType.SecurityQuestion)"
                                                      IsUrl="@(field.Type == CredentialFieldType.Url)"
                                                      IsMultiline="@(field.Type == CredentialFieldType.Address)" />
                        }
                    }
                    @foreach (var sec in _sections)
                    {
                        <CredentialSectionBlock Section="@sec"
                                                IsEditing="false" />
                    }
                </AppCard>
            }

            @if (SelectedTags.Any())
            {
                <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6 space-y-2">
                    <h4 class="text-sm font-semibold text-gray-700">Tags</h4>
                    <TagsBadgesList Tags="@SelectedTags" />
                </AppCard>
            }

            @if (!string.IsNullOrWhiteSpace(Notes) || Type == CredentialType.SecureNote)
            {
                <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6 space-y-3">
                    <h4 class="text-sm font-semibold text-gray-700">Notes</h4>
                    <CredentialViewFieldBlock Label=""
                                              Value="@Notes"
                                              IsMultiline="true" />
                </AppCard>
            }
        }
        else
        {
            <div class="flex items-start gap-3">
                @if (!_isExisting)
                {
                    <AppDropdown Alignment="@DropdownAlignment.Left">
                        <Trigger>
                            <span class="group relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors border border-blue-200/80 shadow-2xs"
                                  title="Item type: @GetCredentialTypeLabel(Type) (click to change)">
                                <i class="@GetCredentialTypeIcon(Type) text-lg" aria-hidden="true"></i>
                                <span class="absolute -bottom-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-gray-700 text-[8px] text-white shadow group-hover:bg-gray-900 transition-colors">
                                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                                </span>
                            </span>
                        </Trigger>
                        <Menu>
                            @foreach (CredentialType credType in Enum.GetValues<CredentialType>())
                            {
                                <AppDropdownItem OnClick="() => OnTypeChanged(credType)"
                                                 IsActive="@(Type == credType)">
                                    <div class="flex items-center gap-2.5">
                                        <i class="@GetCredentialTypeIcon(credType) w-4 text-center text-gray-500" aria-hidden="true"></i>
                                        <span class="font-medium">@GetCredentialTypeLabel(credType)</span>
                                    </div>
                                </AppDropdownItem>
                            }
                        </Menu>
                    </AppDropdown>
                }
                else
                {
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 border border-blue-200/80 shadow-2xs"
                         title="@GetCredentialTypeLabel(Type)">
                        <i class="@GetCredentialTypeIcon(Type) text-lg" aria-hidden="true"></i>
                    </div>
                }

                <div class="flex-1 min-w-0">
                    <AppInputText @bind-Value="Title"
                                  Placeholder="Title"
                                  Required="true"
                                  ErrorMessage="@TitleErrorMessage" />
                    <div class="mt-1 flex items-center gap-1.5 text-xs text-gray-400">
                        <span>Item type:</span>
                        <span class="font-medium text-gray-600">@GetCredentialTypeLabel(Type)</span>
                        @if (!_isExisting)
                        {
                            <span class="text-gray-400 text-[11px]">(click icon to change)</span>
                        }
                    </div>
                </div>
            </div>

            @if (Type != CredentialType.SecureNote && Type != CredentialType.Database)
            {
                <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6 space-y-5">
                    <h4 class="text-sm font-semibold text-gray-700">@(Type == CredentialType.SshKey ? "Private key" : "Credentials")</h4>
                    @if (Type == CredentialType.Server)
                    {
                        <AppInputText Label="URL"
                                      @bind-Value="Website"
                                      Type="url"
                                      Icon="fa-solid fa-globe"
                                      Placeholder="https://"
                                      Class="w-full" />
                    }
                    @if (Type == CredentialType.Login || Type == CredentialType.Password || Type == CredentialType.Server)
                    {
                        <AppInputText Label="Username / Email"
                                      @bind-Value="Username"
                                      Autocomplete="off"
                                      Placeholder="username or email"
                                      Icon="fa-regular fa-user"
                                      Class="w-full" />
                        <div class="flex items-end gap-2">
                            <AppInputText Label="Password"
                                          @bind-Value="Password"
                                          Type="password"
                                          Autocomplete="off"
                                          Placeholder="Password"
                                          Class="flex-1 min-w-0" />
                            <AppButton Color="@ComponentColor.Default"
                                       Variant="@ButtonVariant.Light"
                                       Size="@ComponentSize.Small"
                                       IconOnly="true"
                                       OnClick="OpenPasswordGeneratorForMainPasswordAsync"
                                       Title="Generate strong password"
                                       aria-label="Generate strong password"
                                       Class="shrink-0 h-10 w-10 !border !border-gray-200 hover:!bg-blue-50 hover:!text-blue-600 hover:!border-blue-300">
                                <i class="fa-solid fa-wand-magic-sparkles text-sm" aria-hidden="true"></i>
                            </AppButton>
                        </div>
                    }
                    @if (Type == CredentialType.Login)
                    {
                        <AppInputText Label="Website"
                                      @bind-Value="Website"
                                      Type="url"
                                      Icon="fa-solid fa-globe"
                                      Placeholder="https://"
                                      Class="w-full" />
                    }
                    @if (Type == CredentialType.Card)
                    {
                        <AppInputText Label="Cardholder name"
                                      @bind-Value="CardholderName"
                                      Placeholder="Name on card"
                                      Class="w-full" />
                        <AppInputText Label="Card number"
                                      @bind-Value="CardNumber"
                                      Placeholder="Card number"
                                      Class="w-full" />
                        <div class="grid grid-cols-2 gap-4">
                            <AppInputText Label="Expires"
                                          @bind-Value="ExpirationDate"
                                          Placeholder="MM/YY"
                                          Class="w-full" />
                            <AppInputText Label="CVV"
                                          @bind-Value="Cvv"
                                          Type="password"
                                          Autocomplete="off"
                                          Placeholder="CVC"
                                          Class="w-full" />
                        </div>
                    }
                    @if (Type == CredentialType.File || Type == CredentialType.SshKey)
                    {
                        <div class="space-y-3">
                            <label class="text-sm font-medium text-gray-700">@(Type == CredentialType.SshKey ? "Private key file" : "File Attachment")</label>
                            <CredentialFileUploadBlock @bind-File="File" />
                        </div>
                    }
                </AppCard>
            }

            <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6 space-y-5">
                <h4 class="text-sm font-semibold text-gray-700">Additional fields</h4>
                <CredentialFieldsBlock Fields="_additionalFields"
                                       OnFieldChanged="HandleCredentialFieldChanged" />
                @foreach (var sec in _sections)
                {
                    <CredentialSectionBlock @key="sec"
                                            Section="@sec"
                                            IsEditing="true"
                                            OnFieldChanged="HandleCredentialFieldChanged"
                                            OnRemove="() => RemoveSection(sec)" />
                }
                <CredentialFieldMenuBlock AllowSections="true"
                                          IsDropUp="true"
                                          OnAddField="AddField"
                                          OnAddSection="AddSection" />
            </AppCard>

            <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6 space-y-3">
                <h4 class="text-sm font-semibold text-gray-700">Tags</h4>
                <TagsSelect Tags="@VaultsState.Value.Tags"
                            Value="@_tagIds"
                            ValueChanged="@OnTagsChanged"
                            OnCreateTag="@CreateTagAsync"
                            Class="w-full" />
            </AppCard>

            <AppCard Class="!rounded-lg !border-gray-200/70 !shadow-none p-5 sm:p-6">
                <InputTextareaField Label="Notes"
                                    @bind-Value="Notes"
                                    Placeholder="Additional notes or security information..."
                                    Rows="4"
                                    IsFullWidth="true" />
            </AppCard>
        }
    </div>

    @if (_isEditing)
    {
        <footer class="shrink-0 border-t border-gray-200/70 flex justify-end gap-3 bg-white px-5 py-4 sm:px-8 rounded-b-2xl">
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       OnClick="@CancelEdit">
                Cancel
            </AppButton>
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       OnClick="@SaveAndClose">
                Save and Close
            </AppButton>
            <AppButton Color="@ComponentColor.Primary"
                       Variant="@ButtonVariant.Solid"
                       Class="min-w-24 !bg-blue-600 hover:!bg-blue-700 font-semibold"
                       OnClick="@Save">
                Save
            </AppButton>
        </footer>
    }
</div>
