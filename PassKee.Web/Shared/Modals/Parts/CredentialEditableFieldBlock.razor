@namespace PassKee.Web.Shared.Modals.Parts
@using PassKee.Api.Shared.Models.Vaults.Payloads
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<div class="group relative flex items-center justify-between gap-3 rounded-lg border border-gray-200/80 bg-white hover:border-gray-300 focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/10 px-3.5 py-2.5 transition min-w-0">
    <div class="min-w-0 flex-1 space-y-0.5">
        @* Editable Field Label / Title on Top (1Password style) *@
        <div class="flex items-center gap-1.5">
            <i class="@CredentialFieldMenuBlock.GetFieldIcon(Field.Type) text-[11px] text-gray-400" aria-hidden="true"></i>
            <input type="text"
                   @bind="Field.Label"
                   @bind:event="oninput"
                   placeholder="Field name"
                   aria-label="Field label"
                   class="w-full text-xs font-semibold uppercase tracking-wider text-gray-500 bg-transparent border-0 p-0 focus:outline-none focus:ring-0 placeholder:text-gray-400 truncate" />
        </div>

        @* Value Input Directly Below *@
        <div class="min-w-0">
            @if (Field.Type == CredentialFieldType.Address)
            {
                <textarea @bind="Field.Value"
                          @bind:event="oninput"
                          placeholder="Address"
                          aria-label="@Field.Label"
                          rows="2"
                          class="w-full bg-transparent border-0 p-0 text-sm font-medium text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0 resize-y"></textarea>
            }
            else if (Field.Type == CredentialFieldType.Password)
            {
                <input type="@(_isPasswordVisible ? "text" : "password")"
                       @bind="Field.Value"
                       @bind:event="oninput"
                       autocomplete="new-password"
                       placeholder="Password"
                       aria-label="@Field.Label"
                       class="w-full bg-transparent border-0 p-0 text-sm font-medium font-mono text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0" />
            }
            else if (Field.Type == CredentialFieldType.Date)
            {
                <input type="date"
                       value="@Field.Value"
                       @onchange="@(e => Field.Value = e.Value?.ToString())"
                       aria-label="@Field.Label"
                       class="w-full bg-transparent border-0 p-0 text-sm font-medium text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0" />
            }
            else if (Field.Type == CredentialFieldType.Url)
            {
                <input type="url"
                       @bind="Field.Value"
                       @bind:event="oninput"
                       placeholder="https://"
                       aria-label="@Field.Label"
                       class="w-full bg-transparent border-0 p-0 text-sm font-medium text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0" />
            }
            else if (Field.Type == CredentialFieldType.Email)
            {
                <input type="email"
                       @bind="Field.Value"
                       @bind:event="oninput"
                       placeholder="name@example.com"
                       aria-label="@Field.Label"
                       class="w-full bg-transparent border-0 p-0 text-sm font-medium text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0" />
            }
            else if (Field.Type == CredentialFieldType.Phone)
            {
                <input type="tel"
                       @bind="Field.Value"
                       @bind:event="oninput"
                       placeholder="+1..."
                       aria-label="@Field.Label"
                       class="w-full bg-transparent border-0 p-0 text-sm font-medium text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0" />
            }
            else
            {
                <input type="text"
                       @bind="Field.Value"
                       @bind:event="oninput"
                       placeholder="@(Field.Type == CredentialFieldType.SecurityQuestion ? "Answer" : Field.Type == CredentialFieldType.OneTimePassword ? "Secret key / otpauth URI" : "Value")"
                       aria-label="@Field.Label"
                       class="w-full bg-transparent border-0 p-0 text-sm font-medium text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0" />
            }
        </div>
    </div>

    @* Right Side Actions (Password Generator, Visibility, Delete) *@
    <div class="flex items-center gap-1 shrink-0">
        @if (Field.Type == CredentialFieldType.Password)
        {
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       OnClick="OpenPasswordGeneratorAsync"
                       Title="Generate strong password"
                       aria-label="Generate strong password"
                       Class="!text-gray-400 hover:!text-blue-600 hover:!bg-blue-50">
                <i class="fa-solid fa-wand-magic-sparkles text-sm" aria-hidden="true"></i>
            </AppButton>
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       OnClick="TogglePasswordVisibility"
                       Title="@(_isPasswordVisible ? "Hide password" : "Show password")"
                       aria-label="@(_isPasswordVisible ? "Hide password" : "Show password")"
                       Class="!text-gray-400 hover:!text-gray-700 hover:!bg-gray-100">
                <i class="fa-regular @(_isPasswordVisible ? "fa-eye-slash" : "fa-eye") text-sm" aria-hidden="true"></i>
            </AppButton>
        }

        <AppButton Color="@ComponentColor.Default"
                   Variant="@ButtonVariant.Light"
                   Size="@ComponentSize.Small"
                   IconOnly="true"
                   OnClick="OnRemove"
                   aria-label="Remove field"
                   Title="Remove field"
                   Class="shrink-0 !text-gray-400 hover:!text-rose-600 hover:!bg-rose-50 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity">
            <i class="fa-solid fa-circle-minus text-sm" aria-hidden="true"></i>
        </AppButton>
    </div>
</div>
