@namespace PassKee.Web.Shared.Modals.Parts
@using PassKee.Web.Models.Vaults

<div class="flex flex-col gap-3">
    <div class="flex items-center justify-between min-h-7">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Select Destination Folder</span>
        @if (SelectedFolderId.HasValue)
        {
            <button
                type="button"
                class="inline-flex h-7 w-7 items-center justify-center rounded border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition shadow-2xs"
                title="Go back"
                aria-label="Go back"
                @onclick="@GoBack">
                <i class="fa-solid fa-arrow-left text-xs"></i>
            </button>
        }
    </div>

    <div class="min-h-[176px] max-h-[264px] overflow-y-auto rounded-lg border border-slate-200 bg-white p-1 divide-y divide-slate-50" role="listbox" aria-label="Folder list">
        @if (Folders.Any())
        {
            @foreach (var folder in Folders)
            {
                <button
                    type="button"
                    class="w-full grid grid-cols-[20px_minmax(0,1fr)_16px] items-center gap-2 rounded-md p-2 text-left text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition group"
                    @key="folder.Id"
                    @onclick="@(() => OpenFolder(folder.Id))">
                    <i class="fa-regular fa-folder text-amber-500"></i>
                    <span class="truncate font-medium text-sm">@folder.Name</span>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-400 group-hover:text-blue-600 transition"></i>
                </button>
            }
        }
        else
        {
            <div class="p-6 text-center text-sm text-slate-400 italic">No subfolders</div>
        }
    </div>

    <div class="flex items-center gap-1.5 overflow-x-auto text-xs text-slate-600 bg-slate-50 rounded-md px-3 py-2 border border-slate-200/60" aria-label="Current path">
        @for (var index = 0; index < Path.Count; index++)
        {
            var item = Path[index];
            var isLast = index == Path.Count - 1;
            <button
                type="button"
                class="truncate max-w-[160px] font-medium @(isLast ? "text-slate-900 font-semibold" : "hover:text-blue-600 hover:underline transition")"
                @onclick="@(() => SelectFolder(item.Id))">
                @item.Name
            </button>
            @if (!isLast)
            {
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 shrink-0"></i>
            }
        }
    </div>
</div>

