@namespace PassKee.Web.Shared.Modals.Parts
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@using PassKee.Web.Core.Ui.Shared.Components.Storage

<div class="group flex items-start justify-between gap-3 py-1.5 min-w-0">
    <div class="min-w-0 flex-1">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1.5">
                @Label
            </span>
        }
        <div class="flex items-center gap-3 overflow-hidden rounded-lg border border-slate-200 bg-white p-2.5 shadow-sm">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                <i class="@FileIconHelper.GetIconClass(File?.FileName) text-sm" aria-hidden="true"></i>
            </div>
            <div class="min-w-0 flex-1">
                <p class="truncate text-xs font-medium text-slate-900">@(File?.FileName ?? "File")</p>
                <p class="text-[10px] text-slate-500">@(File == null ? "No file attached" : $"{Math.Max(1, File.Size / 1024)} KB")</p>
            </div>
            <AppButton Color="@ComponentColor.Primary"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       OnClick="DownloadAsync"
                       Disabled="@(File == null)"
                       IsLoading="@IsDownloading"
                       Title="Download File"
                       Class="h-8 !px-3 font-medium shadow-xs">
                <i class="fa-solid fa-download mr-1.5 text-xs" aria-hidden="true"></i>
                Download
            </AppButton>
        </div>
    </div>
</div>
