@namespace PassKee.Web.Shared.Modals.Parts
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<div class="group flex items-start justify-between gap-3 py-1.5 min-w-0">
    <div class="min-w-0 flex-1">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-0.5">
                @Label
            </span>
        }
        <div class="text-sm font-medium text-gray-900 break-words">
            @if (EffectiveIsSecret && !_isRevealed)
            {
                <span class="tracking-widest font-mono text-gray-600 select-none">••••••••••••</span>
            }
            else if (HasValidUrl)
            {
                <a href="@NormalizedUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center gap-1.5 text-blue-600 hover:text-blue-700 hover:underline break-all">
                    <span>@Value</span>
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-75" aria-hidden="true"></i>
                </a>
            }
            else if (HasValidEmail)
            {
                <a href="mailto:@Value"
                   class="inline-flex items-center gap-1.5 text-blue-600 hover:text-blue-700 hover:underline break-all">
                    <span>@Value</span>
                    <i class="fa-solid fa-envelope text-xs opacity-75" aria-hidden="true"></i>
                </a>
            }
            else if (HasValidPhone)
            {
                <a href="tel:@Value"
                   class="inline-flex items-center gap-1.5 text-blue-600 hover:text-blue-700 hover:underline break-all">
                    <span>@Value</span>
                    <i class="fa-solid fa-phone text-xs opacity-75" aria-hidden="true"></i>
                </a>
            }
            else if (EffectiveIsMultiline)
            {
                <p class="whitespace-pre-wrap font-normal text-gray-800">@(string.IsNullOrWhiteSpace(Value) ? "—" : Value)</p>
            }
            else
            {
                <span>@(string.IsNullOrWhiteSpace(Value) ? "—" : Value)</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Value))
    {
        <div class="flex items-center gap-1 shrink-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
            @* Specialized Action Buttons based on Validator *@
            @if (HasValidUrl)
            {
                <a href="@NormalizedUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Open link"
                   aria-label="Open link"
                   class="inline-flex items-center justify-center h-7 w-7 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors">
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
                </a>
            }
            @if (HasValidEmail)
            {
                <a href="mailto:@Value"
                   title="Send email"
                   aria-label="Send email"
                   class="inline-flex items-center justify-center h-7 w-7 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors">
                    <i class="fa-solid fa-envelope text-xs" aria-hidden="true"></i>
                </a>
            }
            @if (HasValidPhone)
            {
                <a href="tel:@Value"
                   title="Call phone"
                   aria-label="Call phone"
                   class="inline-flex items-center justify-center h-7 w-7 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors">
                    <i class="fa-solid fa-phone text-xs" aria-hidden="true"></i>
                </a>
            }
            @if (HasValidAddress)
            {
                <a href="@GoogleMapsUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Open in Maps"
                   aria-label="Open in Maps"
                   class="inline-flex items-center justify-center h-7 w-7 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors">
                    <i class="fa-solid fa-location-dot text-xs" aria-hidden="true"></i>
                </a>
            }

            @* Secret reveal button *@
            @if (EffectiveIsSecret)
            {
                <AppButton Color="@ComponentColor.Default"
                           Variant="@ButtonVariant.Light"
                           Size="@ComponentSize.Small"
                           IconOnly="true"
                           Title="@(_isRevealed ? "Hide" : "Reveal")"
                           aria-label="@(_isRevealed ? "Hide" : "Reveal")"
                           Class="!text-gray-400 hover:!text-gray-700 hover:!bg-gray-100"
                           OnClick="ToggleReveal">
                    <i class="fa-regular @(_isRevealed ? "fa-eye-slash" : "fa-eye") text-sm" aria-hidden="true"></i>
                </AppButton>
            }

            @* Copy button *@
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       Title="Copy to clipboard"
                       aria-label="Copy to clipboard"
                       Class="!text-gray-400 hover:!text-gray-700 hover:!bg-gray-100"
                       OnClick="CopyToClipboardAsync">
                <i class="@(_isCopied ? "fa-solid fa-check text-emerald-600" : "fa-regular fa-copy") text-sm" aria-hidden="true"></i>
            </AppButton>
        </div>
    }
</div>
