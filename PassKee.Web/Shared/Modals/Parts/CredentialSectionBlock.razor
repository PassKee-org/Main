@namespace PassKee.Web.Shared.Modals.Parts
@using PassKee.Api.Shared.Models.Vaults.Payloads
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Dropdown
@using PassKee.Web.Core.Ui.Shared.Components.Enums

@if (IsEditing)
{
    <section class="border-t border-gray-200/70 pt-5 min-w-0 space-y-3">
        <div class="group flex items-center justify-between border-b border-gray-200/70 pb-2">
            <div class="flex items-center gap-2 flex-1 min-w-0">
                <i class="fa-solid fa-layer-group text-xs text-gray-400" aria-hidden="true"></i>
                <input type="text"
                       @bind="Section.Title"
                       placeholder="Section title"
                       aria-label="Section title"
                       class="text-xs font-bold uppercase tracking-wider text-gray-600 bg-transparent border-0 p-0 focus:outline-none focus:ring-0 placeholder:text-gray-400 flex-1 min-w-0" />
            </div>
            <div class="flex items-center gap-1 shrink-0">
                <CredentialFieldMenuBlock IconOnly="true"
                                          AllowSections="false"
                                          Alignment="@DropdownAlignment.Right"
                                          Label="Add field to section"
                                          OnAddField="AddField" />
                <AppButton Color="@ComponentColor.Default"
                           Variant="@ButtonVariant.Light"
                           Size="@ComponentSize.Small"
                           IconOnly="true"
                           aria-label="Remove section"
                           Title="Remove section"
                           Class="shrink-0 !text-gray-400 hover:!text-rose-600 hover:!bg-rose-50 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity"
                           OnClick="ConfirmAndRemoveAsync">
                    <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                </AppButton>
            </div>
        </div>
        <CredentialFieldsBlock Fields="Section.Fields" />
    </section>
}
else if (Section.Fields.Any() || !string.IsNullOrWhiteSpace(Section.Title))
{
    <section class="border-t border-gray-200/70 pt-4 min-w-0">
        <div class="border-b border-gray-200/70 pb-2 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-layer-group text-xs text-gray-400" aria-hidden="true"></i>
            <h5 class="text-xs font-bold uppercase tracking-wider text-gray-500">
                @(string.IsNullOrWhiteSpace(Section.Title) ? "Section" : Section.Title)
            </h5>
        </div>
        <div class="space-y-2">
            @foreach (var field in Section.Fields)
            {
                <CredentialViewFieldBlock Label="@field.Label"
                                          Value="@field.Value"
                                          Type="@field.Type" />
            }
        </div>
    </section>
}
