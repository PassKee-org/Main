@using PassKee.Api.Shared.Models.Vaults.Payloads

<div class="space-y-3 min-w-0">
    @foreach (var field in Fields)
    {
        <div @key="field" class="border-b border-slate-200 pb-3 min-w-0">
            <div class="flex items-start gap-2">
                <div class="flex-1 min-w-0 space-y-2">
                    <AppInputText Label="@CredentialFieldMenuBlock.GetFieldLabel(field.Type)"
                                  @bind-Value="field.Label"
                                  Placeholder="Field name"
                                  Class="w-full" />
                    @if (field.Type == CredentialFieldType.Address)
                    {
                        <InputTextareaField Label="Value"
                                            @bind-Value="field.Value"
                                            Rows="2"
                                            IsFullWidth="true" />
                    }
                    else
                    {
                        <AppInputText Label="@(field.Type == CredentialFieldType.SecurityQuestion ? "Answer" : field.Type == CredentialFieldType.OneTimePassword ? "Secret key / otpauth URI" : "Value")"
                                      @bind-Value="field.Value"
                                      Type="@GetInputType(field.Type)"
                                      Autocomplete="off"
                                      Class="w-full" />
                    }
                </div>
                <AppButton Color="@ComponentColor.Danger"
                           Variant="@ButtonVariant.Light"
                           Size="@ComponentSize.Small"
                           IconOnly="true"
                           aria-label="Remove field"
                           Title="Remove field"
                           OnClick="() => Fields.Remove(field)">
                    <i class="fa-solid fa-circle-minus" aria-hidden="true"></i>
                </AppButton>
            </div>
        </div>
    }
    @if (ShowAddMenu)
    {
        <CredentialFieldMenuBlock Label="Add field"
                                  OnAddField="AddField" />
    }
</div>