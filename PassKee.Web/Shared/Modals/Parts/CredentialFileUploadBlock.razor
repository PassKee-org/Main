@namespace PassKee.Web.Shared.Modals.Parts
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@using PassKee.Web.Core.Ui.Shared.Components.Storage

<div class="space-y-2">
    @if (_isUploading)
    {
        <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 shadow-sm">
            <AppSpinner Size="@ComponentSize.Small" />
            <div class="min-w-0 flex-1">
                <p class="truncate text-xs font-medium text-slate-900">@_uploadingFileName</p>
                <p class="text-[10px] text-slate-500">Encrypting and uploading...</p>
            </div>
        </div>
    }
    else if (File != null)
    {
        <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-white p-3 shadow-sm">
            <div class="flex items-center gap-3 overflow-hidden">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                    <i class="@FileIconHelper.GetIconClass(File.FileName) text-sm" aria-hidden="true"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-xs font-medium text-slate-900">@(File.FileName ?? "File")</p>
                    <p class="text-[10px] text-slate-500">@FormatSize(File.Size)</p>
                </div>
            </div>
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       OnClick="RemoveAsync"
                       Title="Remove file"
                       aria-label="Remove file"
                       Class="!text-rose-500 hover:!bg-rose-50">
                <i class="fa-solid fa-xmark text-sm" aria-hidden="true"></i>
            </AppButton>
        </div>
    }
    else
    {
        <AppFileDropzone Title="Drop file to upload"
                         Subtitle="File is encrypted in your browser before upload"
                         MaxFileSize="@MaxFileSize"
                         OnFilesSelected="UploadAsync" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="text-xs text-rose-600">@_errorMessage</p>
    }
</div>
