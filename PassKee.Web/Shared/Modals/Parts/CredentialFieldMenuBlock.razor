@namespace PassKee.Web.Shared.Modals.Parts
@using PassKee.Api.Shared.Models.Vaults.Payloads
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<AppDropdown Alignment="@DropdownAlignment.Left"
             IsInline="true"
             Class="w-full"
             MenuClass="!rounded-lg !border-gray-200 !bg-white !text-gray-900 max-h-64 overflow-y-auto"
             WidthClass="w-64 max-w-[calc(100vw-4rem)]">
    <Trigger>
        <AppButton Color="@ComponentColor.Primary"
                   Variant="@ButtonVariant.Light"
                   Size="@ComponentSize.Small"
                   Class="!text-blue-600 hover:!bg-blue-50 font-medium"
                   aria-label="@Label"
                   Title="@Label">
            <i class="fa-solid fa-plus mr-1" aria-hidden="true"></i>
            @Label
            <i class="fa-solid fa-chevron-down text-xs ml-1" aria-hidden="true"></i>
        </AppButton>
    </Trigger>
    <Menu>
        @foreach (var fieldType in Enum.GetValues<CredentialFieldType>())
        {
            <AppDropdownItem Text="@GetFieldLabel(fieldType)"
                             Icon="@GetFieldIcon(fieldType)"
                             OnClick="() => OnAddField.InvokeAsync(fieldType)" />
        }
        @if (AllowSections)
        {
            <AppDropdownItem Text="Section"
                             Icon="fa-solid fa-layer-group"
                             ShowDivider="true"
                             OnClick="() => OnAddSection.InvokeAsync()" />
        }
    </Menu>
</AppDropdown>
