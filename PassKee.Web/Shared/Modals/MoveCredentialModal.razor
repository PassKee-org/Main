@namespace PassKee.Web.Shared.Modals
@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@using PassKee.Web.Core.Ui.Shared.Components.Modal
@using PassKee.Web.Shared.Modals.Parts

<div class="move-credential-modal">
    <AppModalHeader
        Title="Move Item"
        Description="@($"Select destination folder for \"{Credential?.Payload?.Title}\"")"
        Icon="fa-solid fa-folder-tree" />

    <AppModalBody Class="pt-2 sm:pt-3">
        <div class="mb-3 flex items-center justify-between rounded-lg bg-slate-50 border border-slate-200/80 px-3 py-2 text-xs text-slate-600">
            <div class="flex items-center gap-2 truncate">
                <i class="fa-regular fa-folder-open text-blue-500 shrink-0"></i>
                <span class="truncate">Destination: <strong class="text-slate-900 font-semibold">@CurrentDestinationName</strong></span>
            </div>
            @if (_selectedFolderId == Credential?.DirectoryId)
            {
                <span class="text-[11px] font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 shrink-0 ml-2">Current folder</span>
            }
        </div>

        <MoveCredentialFolderSelectBlock
            Directories="@Directories"
            SelectedFolderId="@_selectedFolderId"
            SelectedFolderIdChanged="@OnFolderChanged" />
    </AppModalBody>

    <AppModalFooter>
        <AppButton
            Color="@ComponentColor.Default"
            Variant="@ButtonVariant.Outlined"
            Radius="@ButtonRadius.Medium"
            OnClick="@Cancel">
            Cancel
        </AppButton>
        <AppButton
            Color="@ComponentColor.Primary"
            Variant="@ButtonVariant.Solid"
            Radius="@ButtonRadius.Medium"
            IsLoading="@_isSaving"
            Disabled="@(_isSaving || _selectedFolderId == Credential?.DirectoryId)"
            OnClick="@SubmitAsync">
            Move
        </AppButton>
    </AppModalFooter>
</div>

