@namespace PassKee.Web.Shared.Modals
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<div class="flex flex-col overflow-hidden rounded-2xl bg-white text-gray-900 p-5 sm:p-6 space-y-5 max-w-sm sm:max-w-md w-full">
    @* Top Action Bar *@
    <div class="flex items-center justify-between gap-3 border-b border-gray-100 pb-4">
        <AppButton Color="@ComponentColor.Default"
                   Variant="@ButtonVariant.Light"
                   Size="@ComponentSize.Small"
                   OnClick="Cancel"
                   Class="!text-gray-600 hover:!text-gray-900">
            Close
        </AppButton>
        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider hidden sm:inline">GUID / Token</span>
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       OnClick="Regenerate"
                       Title="Regenerate"
                       aria-label="Regenerate"
                       Class="!text-gray-600 hover:!text-gray-900 hover:!bg-gray-100">
                <i class="fa-solid fa-rotate-right text-sm" aria-hidden="true"></i>
            </AppButton>
        </div>
        <AppButton Color="@ComponentColor.Primary"
                   Variant="@ButtonVariant.Solid"
                   Size="@ComponentSize.Small"
                   OnClick="CopyAndCloseAsync"
                   Class="!bg-blue-600 hover:!bg-blue-700 font-semibold text-white px-4">
            Copy & Close
        </AppButton>
    </div>

    @* Display Field *@
    @if (_count == 1)
    {
        <div class="space-y-2">
            <div class="relative flex items-center justify-between rounded-xl border border-gray-200/80 bg-gray-50/80 px-3.5 py-3 transition focus-within:border-blue-500">
                <div class="font-mono text-xs sm:text-sm font-semibold tracking-wide break-all select-text flex-1 min-w-0 text-gray-900">
                    @CurrentPrimaryValue
                </div>
                <AppButton Color="@ComponentColor.Default"
                           Variant="@ButtonVariant.Light"
                           Size="@ComponentSize.Small"
                           IconOnly="true"
                           OnClick="() => CopyToClipboardAsync(CurrentPrimaryValue)"
                           Title="Copy to clipboard"
                           aria-label="Copy to clipboard"
                           Class="shrink-0 ml-2 !text-gray-400 hover:!text-gray-700 hover:!bg-gray-200/60">
                    <i class="@(_copiedValue == CurrentPrimaryValue || _isCopied ? "fa-solid fa-check text-emerald-600" : "fa-regular fa-copy") text-sm" aria-hidden="true"></i>
                </AppButton>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-2">
            <div class="relative rounded-xl border border-gray-200/80 bg-gray-50/80 p-2">
                <div class="max-h-40 overflow-y-auto divide-y divide-gray-100/80">
                    @foreach (var val in _generatedValues)
                    {
                        <div class="group flex items-center justify-between px-2.5 py-1.5 rounded-lg hover:bg-white hover:shadow-2xs cursor-pointer transition select-none"
                             @onclick="() => CopyToClipboardAsync(val)"
                             title="Click to copy this item">
                            <span class="font-mono text-xs text-gray-800 break-all select-text">@val</span>
                            <span class="text-xs shrink-0 ml-2 text-gray-400 group-hover:text-blue-600 transition">
                                <i class="@(_copiedValue == val ? "fa-solid fa-check text-emerald-600" : "fa-regular fa-copy opacity-0 group-hover:opacity-100")"></i>
                            </span>
                        </div>
                    }
                </div>
            </div>
            <div class="flex justify-between items-center text-xs text-gray-500 px-1">
                <span>@_generatedValues.Count items generated</span>
                <button type="button"
                        class="text-blue-600 hover:text-blue-700 font-medium inline-flex items-center gap-1 cursor-pointer"
                        @onclick="() => CopyToClipboardAsync(AllValuesJoined)">
                    <i class="@(_copiedValue == AllValuesJoined ? "fa-solid fa-check text-emerald-600" : "fa-regular fa-copy")"></i>
                    Copy All
                </button>
            </div>
        </div>
    }

    @* Options Panel *@
    <div class="space-y-3.5 pt-1">
        <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Type</span>
            <select @bind="_generatorType"
                    @bind:after="Regenerate"
                    class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                <option value="Guid">GUID / UUID</option>
                <option value="Hex">Hex String (Secret)</option>
                <option value="Base64">Base64 / URL Token</option>
                <option value="NanoId">NanoID / Alphanumeric</option>
            </select>
        </div>

        @if (_generatorType == "Guid")
        {
            <div class="flex items-center justify-between gap-4 pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Version</span>
                <select @bind="_guidVersion"
                        @bind:after="Regenerate"
                        class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <option value="v7">UUID v7 (Time-ordered)</option>
                    <option value="v4">UUID v4 (Random)</option>
                </select>
            </div>

            <div class="flex items-center justify-between gap-4 pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Format</span>
                <select @bind="_guidFormat"
                        @bind:after="Regenerate"
                        class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <option value="D">Hyphens (Standard)</option>
                    <option value="N">No Hyphens (32 chars)</option>
                    <option value="B">Braces { ... }</option>
                    <option value="P">Parentheses ( ... )</option>
                </select>
            </div>

            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">Uppercase letters</span>
                <AppSwitch Value="@_isUppercase"
                           ValueChanged="@(v => { _isUppercase = v; Regenerate(); })"
                           Size="@ComponentSize.Small" />
            </div>
        }
        else if (_generatorType == "Hex")
        {
            <div class="flex items-center justify-between gap-4 pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Length</span>
                <select @bind="_byteLength"
                        @bind:after="Regenerate"
                        class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <option value="16">16 bytes (32 hex / 128-bit)</option>
                    <option value="32">32 bytes (64 hex / 256-bit)</option>
                    <option value="64">64 bytes (128 hex / 512-bit)</option>
                </select>
            </div>

            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">Uppercase</span>
                <AppSwitch Value="@_isUppercase"
                           ValueChanged="@(v => { _isUppercase = v; Regenerate(); })"
                           Size="@ComponentSize.Small" />
            </div>
        }
        else if (_generatorType == "Base64")
        {
            <div class="flex items-center justify-between gap-4 pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Length</span>
                <select @bind="_byteLength"
                        @bind:after="Regenerate"
                        class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <option value="16">16 bytes (128-bit)</option>
                    <option value="32">32 bytes (256-bit)</option>
                    <option value="64">64 bytes (512-bit)</option>
                </select>
            </div>

            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">URL-Safe format</span>
                <AppSwitch Value="@_isUrlSafe"
                           ValueChanged="@(v => { _isUrlSafe = v; Regenerate(); })"
                           Size="@ComponentSize.Small" />
            </div>
        }
        else if (_generatorType == "NanoId")
        {
            <div class="space-y-1.5 pt-1 border-t border-gray-100">
                <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold uppercase tracking-wider text-gray-500">Length</span>
                    <span class="font-mono font-semibold text-gray-900 bg-gray-100 px-2 py-0.5 rounded text-xs">@_nanoIdLength</span>
                </div>
                <input type="range"
                       min="10"
                       max="64"
                       @bind="_nanoIdLength"
                       @bind:event="oninput"
                       @bind:after="Regenerate"
                       class="w-full accent-blue-600 cursor-pointer" />
            </div>

            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">URL-Safe symbols (_-)</span>
                <AppSwitch Value="@_includeNanoIdSymbols"
                           ValueChanged="@(v => { _includeNanoIdSymbols = v; Regenerate(); })"
                           Size="@ComponentSize.Small" />
            </div>
        }

        <div class="flex items-center justify-between gap-4 pt-1 border-t border-gray-100">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Quantity</span>
            <div class="flex items-center gap-1">
                @foreach (var countOption in new[] { 1, 5, 10 })
                {
                    <button type="button"
                            class="px-2.5 py-1 text-xs font-medium rounded-lg transition cursor-pointer @(_count == countOption ? "bg-blue-600 text-white font-semibold shadow-xs" : "bg-gray-100 text-gray-600 hover:bg-gray-200")"
                            @onclick="() => SetCount(countOption)">
                        @countOption
                    </button>
                }
            </div>
        </div>
    </div>
</div>

