@namespace PassKee.Web.Shared.Modals
@using PassKee.Api.Shared.Models.Vaults.Payloads
@using PassKee.Business.Common.Constants
@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@using PassKee.Web.Core.Utils

<div class="p-6 text-slate-100 bg-[#22252a] rounded-2xl max-w-lg w-full">
    @* Modal Header *@
    <div class="flex items-start justify-between gap-4 pb-4 border-b border-slate-700/50">
        <h3 class="text-lg font-bold text-white">
            Поделитесь ссылкой на этот элемент
        </h3>
        <button type="button"
                @onclick="Close"
                class="h-8 w-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition shrink-0"
                aria-label="Закрыть">
            <i class="fa-solid fa-xmark text-sm"></i>
        </button>
    </div>

    @* Item Preview Header *@
    <div class="flex items-center gap-3.5 py-4 my-1">
        <div class="h-11 w-11 rounded-xl bg-[#ebd4c1] text-[#5c3e28] flex items-center justify-center text-base font-bold shrink-0">
            @if (!string.IsNullOrWhiteSpace(Credential?.Payload?.Icon))
            {
                <span class="text-2xl leading-none select-none">@EmojiHelper.FormatEmoji(Credential.Payload.Icon)</span>
            }
            else if (!string.IsNullOrWhiteSpace(ItemInitial))
            {
                <span class="leading-none">@ItemInitial</span>
            }
            else
            {
                <i class="@GetCredentialTypeIcon(Credential?.Type ?? CredentialType.Login)"></i>
            }
        </div>
        <div class="min-w-0 flex-1">
            <h4 class="font-bold text-base text-white truncate">
                @(string.IsNullOrWhiteSpace(Credential?.Payload?.Title) ? "Untitled" : Credential.Payload.Title)
            </h4>
            @if (!string.IsNullOrWhiteSpace(ItemSubtitle))
            {
                <p class="text-xs text-slate-400 truncate mt-0.5">
                    @ItemSubtitle
                </p>
            }
        </div>
    </div>

    @* Form Controls *@
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
        <div>
            <label class="block text-xs font-normal text-slate-400 mb-1.5">
                Срок действия ссылки истекает через
            </label>
            <div class="relative">
                <select @bind="SelectedExpirySeconds"
                        @bind:after="OnSettingChanged"
                        class="w-full appearance-none bg-[#181a1e] border border-slate-700/80 rounded-xl px-3.5 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 pr-9 transition cursor-pointer">
                    <option value="3600">1 час</option>
                    <option value="86400">1 день</option>
                    <option value="604800">7 дней</option>
                    <option value="2592000">30 дней</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                    <i class="fa-solid fa-up-down text-xs"></i>
                </div>
            </div>
        </div>

        <div>
            <label class="block text-xs font-normal text-slate-400 mb-1.5">
                Кому доступно:
            </label>
            <div class="relative">
                <select @bind="SelectedAudience"
                        class="w-full appearance-none bg-[#181a1e] border border-slate-700/80 rounded-xl px-3.5 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 pr-9 transition cursor-pointer">
                    <option value="anyone">Всем, у кого есть ссылка</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                    <i class="fa-solid fa-up-down text-xs"></i>
                </div>
            </div>
        </div>
    </div>

    @* One-time view checkbox *@
    <div class="mt-4">
        <label class="inline-flex items-center gap-2.5 text-sm text-slate-300 cursor-pointer select-none">
            <input type="checkbox"
                   checked="@IsOneTimeView"
                   @onchange="ToggleOneTimeView"
                   class="h-4 w-4 rounded border-slate-700 bg-[#181a1e] text-blue-600 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
            <span>Можно просмотреть только 1 раз</span>
        </label>
    </div>

    @* Warning callout about files *@
    <div class="mt-4 rounded-xl bg-[#3f3318] border border-[#635123] px-4 py-3 text-xs text-[#eed19c] leading-relaxed">
        Не будут передаваться файлы, вложенные в этот элемент.
    </div>

    @* Generated share link display if ready *@
    @if (!string.IsNullOrWhiteSpace(GeneratedShareUrl))
    {
        <div class="mt-4 flex items-center gap-2 bg-[#181a1e] border border-slate-700/80 rounded-xl p-2 min-w-0">
            <input type="text"
                   readonly
                   value="@GeneratedShareUrl"
                   class="bg-transparent text-xs text-slate-300 flex-1 px-2 focus:outline-none truncate font-mono select-all" />
            <button type="button"
                    @onclick="CopyLinkToClipboardAsync"
                    class="h-8 w-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition shrink-0"
                    title="Копировать ссылку">
                <i class="@(IsCopied ? "fa-solid fa-check text-emerald-400" : "fa-regular fa-copy")"></i>
            </button>
        </div>
    }

    @* Action Button *@
    <div class="mt-6">
        <button type="button"
                @onclick="GenerateAndCopyLinkAsync"
                disabled="@IsCreating"
                class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 disabled:opacity-60 text-white font-medium text-sm transition shadow-md">
            @if (IsCreating)
            {
                <AppSpinner Color="@ComponentColor.Default" Size="@ComponentSize.Small" />
                <span>Генерация ссылки...</span>
            }
            else
            {
                <i class="@(IsCopied ? "fa-solid fa-check text-white" : "fa-solid fa-link") text-sm"></i>
                <span>@(IsCopied ? "Ссылка скопирована" : "Копировать ссылку")</span>
            }
        </button>
    </div>
</div>

