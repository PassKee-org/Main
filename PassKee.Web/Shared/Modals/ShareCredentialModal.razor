@namespace PassKee.Web.Shared.Modals
@using PassKee.Business.Common.Constants
@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@using PassKee.Web.Core.Ui.Shared.Components.Form.Select
@using PassKee.Web.Core.Ui.Shared.Components.Modal
@using PassKee.Web.Core.Utils

<div class="share-credential-modal">
    <AppModalHeader
        Title="Share a link to this item"
        Icon="fa-solid fa-link"
        IconColor="ComponentColor.Primary" />

    <AppModalBody Class="space-y-4">
        @* Item Preview Header *@
        <div class="flex items-center gap-3.5 p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="h-11 w-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-base font-bold shrink-0">
                @if (!string.IsNullOrWhiteSpace(Credential?.Payload?.Icon))
                {
                    <span class="text-2xl leading-none select-none">@EmojiHelper.FormatEmoji(Credential.Payload.Icon)</span>
                }
                else if (!string.IsNullOrWhiteSpace(ItemInitial))
                {
                    <span class="leading-none">@ItemInitial</span>
                }
                else
                {
                    <i class="@GetCredentialTypeIcon(Credential?.Type ?? CredentialType.Login)"></i>
                }
            </div>
            <div class="min-w-0 flex-1">
                <h4 class="font-semibold text-sm sm:text-base text-slate-900 truncate">
                    @(string.IsNullOrWhiteSpace(Credential?.Payload?.Title) ? "Untitled" : Credential.Payload.Title)
                </h4>
                @if (!string.IsNullOrWhiteSpace(ItemSubtitle))
                {
                    <p class="text-xs text-slate-500 truncate mt-0.5">
                        @ItemSubtitle
                    </p>
                }
            </div>
        </div>

        @* Form Controls *@
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <AppSelect TValue="int"
                           Label="Link expires after"
                           Value="@SelectedExpirySeconds"
                           ValueChanged="@OnExpiryChanged"
                           Items="@ExpiryOptions"
                           ItemText="@GetExpiryLabel"
                           IsFullWidth="true" />
            </div>

            <div>
                <AppSelect TValue="string"
                           Label="Available to:"
                           Value="@SelectedAudience"
                           ValueChanged="@OnAudienceChanged"
                           Items="@AudienceOptions"
                           ItemText="@GetAudienceLabel"
                           IsFullWidth="true" />
            </div>
        </div>

        @* One-time view checkbox *@
        <div>
            <AppCheckbox Value="@IsOneTimeView"
                         ValueChanged="@OnOneTimeViewChanged"
                         Color="@ComponentColor.Primary">
                Can be viewed only once
            </AppCheckbox>
        </div>

        @* Warning callout about files *@
        <div class="rounded-xl border border-amber-200/80 bg-amber-50/70 p-3.5 text-xs text-amber-800 flex items-start gap-2.5">
            <i class="fa-solid fa-triangle-exclamation text-amber-600 text-sm mt-0.5 shrink-0" aria-hidden="true"></i>
            <span class="leading-relaxed">Files attached to this item will not be shared.</span>
        </div>

        @* Generated share link display if ready *@
        @if (!string.IsNullOrWhiteSpace(GeneratedShareUrl))
        {
            <div class="space-y-1.5">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">
                    Share link
                </label>
                <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2 min-w-0">
                    <input type="text"
                           readonly
                           value="@GeneratedShareUrl"
                           class="bg-transparent text-xs text-slate-700 flex-1 px-2 focus:outline-none truncate font-mono select-all" />
                    <AppButton Color="@ComponentColor.Default"
                               Variant="@ButtonVariant.Light"
                               Size="@ComponentSize.Small"
                               IconOnly="true"
                               OnClick="@CopyLinkToClipboardAsync"
                               Title="Copy link"
                               aria-label="Copy link"
                               Class="shrink-0 !text-slate-500 hover:!text-slate-800 hover:!bg-slate-200/70">
                        <i class="@(IsCopied ? "fa-solid fa-check text-emerald-600" : "fa-regular fa-copy") text-sm"></i>
                    </AppButton>
                </div>
            </div>
        }
    </AppModalBody>

    <AppModalFooter>
        <AppButton Color="@ComponentColor.Default"
                   Variant="@ButtonVariant.Outlined"
                   Radius="@ButtonRadius.Medium"
                   OnClick="@Close">
            Cancel
        </AppButton>
        <AppButton Color="@ComponentColor.Primary"
                   Variant="@ButtonVariant.Solid"
                   Radius="@ButtonRadius.Medium"
                   IsLoading="@IsCreating"
                   Disabled="@IsCreating"
                   OnClick="@GenerateAndCopyLinkAsync">
            <i class="@(IsCopied ? "fa-solid fa-check mr-2" : "fa-solid fa-link mr-2") text-sm" aria-hidden="true"></i>
            <span>@(IsCopied ? "Link copied" : "Copy link")</span>
        </AppButton>
    </AppModalFooter>
</div>
