@namespace PassKee.Web.Pages.App
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<AppCard Class="flex-1 flex flex-col shadow-xs">
    <AppCardHeader Class="py-3.5 sm:py-4 px-4 sm:px-6 flex items-center justify-between border-b border-slate-100 bg-white gap-3">
        <div class="flex items-center gap-3 min-w-0">
            <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 truncate">
                        @ActiveDirectoryName
                    </h2>
                    <button type="button"
                            @onclick="OnToggleMobileDrawer"
                            class="lg:hidden inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 transition shrink-0"
                            title="Change directory">
                        <i class="fa-solid fa-folder-tree text-[10px]"></i>
                        <span>Folders</span>
                    </button>
                </div>
                <p class="text-xs sm:text-sm text-slate-500">
                    @(Credentials.Count()) items
                </p>
            </div>
        </div>
        <AppButton Color="@ComponentColor.Primary"
                   Variant="@ButtonVariant.Solid"
                   Size="@ComponentSize.Medium"
                   OnClick="@OnAddCredential"
                   Class="shrink-0 font-semibold">
            <i class="fa-solid fa-plus sm:mr-1.5"></i>
            <span class="hidden sm:inline">New Item</span>
            <span class="sm:hidden text-xs">New</span>
        </AppButton>
    </AppCardHeader>
    
    <AppCardBody Class="p-0">
        <div class="divide-y divide-slate-100">
            @foreach (var cred in Credentials)
            {
                <CredentialItemBlock Credential="@cred"
                                     OnEdit="@OnEditCredential"
                                     OnDelete="@OnDeleteCredential" />
            }
            @if (!Credentials.Any())
            {
                <div class="p-8 sm:p-12 flex flex-col items-center justify-center text-center">
                    <div class="h-14 w-14 sm:h-16 sm:w-16 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-300 mb-3 sm:mb-4 text-2xl">
                        <i class="fa-solid fa-ghost"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900">It's empty here</h3>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1">Add your first item to this directory.</p>
                </div>
            }
        </div>
    </AppCardBody>
</AppCard>
