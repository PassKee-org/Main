@namespace PassKee.Web.Pages.App
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using PassKee.Web.Components
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Pages.App.Parts
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits BaseReactiveComponent

<AppCard Class="flex-1 flex flex-col shadow-xs">
    <AppCardHeader Class="py-3.5 sm:py-4 px-4 sm:px-6 flex items-center justify-between border-b border-slate-100 bg-white gap-3 shrink-0">
        <div class="flex items-center gap-3 min-w-0">
            @if (VaultsState.Value.IsLoading)
            {
                <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0">
                    <AppSpinner Color="@ComponentColor.Primary" Size="@ComponentSize.Small" />
                </div>
                <div class="min-w-0">
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 truncate">
                        @ActiveDirectoryName
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-400">
                        Loading items...
                    </p>
                </div>
            }
            else if (IsSearchActive)
            {
                <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h2 class="text-base sm:text-lg font-bold text-slate-900 truncate">
                            Search Results
                        </h2>
                        <button type="button"
                                @onclick="ClearSearch"
                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 transition shrink-0"
                                title="Clear search">
                            <i class="fa-solid fa-xmark text-[10px]"></i>
                            <span>Clear</span>
                        </button>
                    </div>
                    <div class="flex items-center gap-1.5 flex-wrap mt-0.5 text-xs text-slate-500">
                        <span>Results for "@SearchQuery":</span>
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-blue-50 text-blue-700 font-semibold text-xs">
                            <i class="fa-solid fa-shield-halved text-[10px]"></i>
                            @FilteredCredentials.Count @(FilteredCredentials.Count == 1 ? "item" : "items")
                        </span>
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md @(FilteredDirectories.Any() ? "bg-amber-50 text-amber-700 font-semibold" : "bg-slate-100 text-slate-500") text-xs">
                            <i class="fa-solid fa-folder text-[10px]"></i>
                            @FilteredDirectories.Count @(FilteredDirectories.Count == 1 ? "folder" : "folders")
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0">
                    <i class="fa-solid fa-folder-open"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h2 class="text-base sm:text-lg font-bold text-slate-900 truncate">
                            @ActiveDirectoryName
                        </h2>
                        <button type="button"
                                @onclick="OnToggleMobileDrawer"
                                class="lg:hidden inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 transition shrink-0"
                                title="Change directory">
                            <i class="fa-solid fa-folder-tree text-[10px]"></i>
                            <span>Folders</span>
                        </button>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-500">
                        @FilteredCredentials.Count items
                    </p>
                </div>
            }
        </div>
        <AppButton Color="@ComponentColor.Primary"
                   Variant="@ButtonVariant.Solid"
                   Size="@ComponentSize.Medium"
                   OnClick="@(() => OpenCredentialModal(null))"
                   Disabled="@VaultsState.Value.IsLoading"
                   Class="shrink-0 font-semibold">
            <i class="fa-solid fa-plus sm:mr-1.5"></i>
            <span class="hidden sm:inline">New Item</span>
            <span class="sm:hidden text-xs">New</span>
        </AppButton>
    </AppCardHeader>
    
    <AppCardBody Class="p-0 overflow-y-auto max-h-[calc(100vh-13rem)] min-h-[400px]">
        @if (VaultsState.Value.IsLoading)
        {
            <div class="p-12 sm:p-20 flex flex-col items-center justify-center text-center">
                <AppSpinner Color="@ComponentColor.Primary" Size="@ComponentSize.Large" />
                <h3 class="text-sm font-semibold text-slate-900 mt-4">Loading vault data...</h3>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Decrypting items and folders</p>
            </div>
        }
        else
        {
            @if (IsSearchActive && FilteredDirectories.Any())
            {
                <div class="p-3.5 sm:p-4 bg-slate-50/80 border-b border-slate-100">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-folder-tree text-blue-500"></i>
                            Matching Folders (@FilteredDirectories.Count)
                        </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                        @foreach (var dir in FilteredDirectories)
                        {
                            var dirPath = GetDirectoryPath(dir.Id);
                            var count = GetDirectoryItemCount(dir.Id);
                            <button type="button"
                                    @onclick="() => HandleSelectDirectory(dir.Id)"
                                    class="flex items-center justify-between p-2.5 rounded-xl bg-white border border-slate-200/90 hover:border-blue-400 hover:bg-blue-50/40 shadow-2xs hover:shadow-xs transition text-left group">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 text-sm group-hover:bg-blue-100 transition">
                                        <i class="fa-regular fa-folder-open"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-sm font-semibold text-slate-800 truncate group-hover:text-blue-600 transition">
                                            @dir.Name
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(dirPath) && dirPath != dir.Name)
                                        {
                                            <div class="text-[11px] text-slate-400 truncate">
                                                @dirPath
                                            </div>
                                        }
                                    </div>
                                </div>
                                <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full shrink-0 ml-2 group-hover:bg-blue-100 group-hover:text-blue-700 transition">
                                    @count @(count == 1 ? "item" : "items")
                                </span>
                            </button>
                        }
                    </div>
                </div>
                <SearchMatchingFoldersBlock Directories="@FilteredDirectories"
                                            DirectoryPaths="@_directoryPaths"
                                            OnSelectDirectory="@HandleSelectDirectory"
                                            GetItemCount="@GetDirectoryItemCount" />
            }

            @if (!FilteredCredentials.Any())
            {
                @if (IsSearchActive)
                {
                    <div class="p-8 sm:p-12 flex flex-col items-center justify-center text-center">
                        <div class="h-14 w-14 sm:h-16 sm:w-16 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-300 mb-3 sm:mb-4 text-2xl">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-slate-900">
                            @(FilteredDirectories.Any() ? "No items matching in content" : "No items found")
                        </h3>
                        <p class="text-xs sm:text-sm text-slate-500 mt-1">
                            @if (FilteredDirectories.Any())
                            {
                                <span>No individual items directly matched "@SearchQuery", but matching folders are shown above.</span>
                            }
                            else
                            {
                                <span>No credentials or folders matching "@SearchQuery".</span>
                            }
                        </p>
                        <AppButton Color="@ComponentColor.Default"
                                   Variant="@ButtonVariant.Light"
                                   Size="@ComponentSize.Small"
                                   OnClick="@ClearSearch"
                                   Class="mt-4">
                            <i class="fa-solid fa-xmark mr-1.5"></i> Clear search
                        </AppButton>
                    </div>
                }
                else
                {
                    <div class="p-8 sm:p-12 flex flex-col items-center justify-center text-center">
                        <div class="h-14 w-14 sm:h-16 sm:w-16 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-300 mb-3 sm:mb-4 text-2xl">
                            <i class="fa-solid fa-ghost"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-slate-900">It's empty here</h3>
                        <p class="text-xs sm:text-sm text-slate-500 mt-1">Add your first item to this directory.</p>
                    </div>
                }
                <CredentialEmptyStateBlock IsSearchActive="@IsSearchActive"
                                           SearchQuery="@SearchQuery"
                                           HasMatchingDirectories="@FilteredDirectories.Any()"
                                           OnClearSearch="@ClearSearch" />
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    <Virtualize TItem="DecryptedCredential" Items="@FilteredCredentials" Context="cred" ItemSize="72f" OverscanCount="12">
                        <ItemContent>
                            <CredentialItemBlock @key="cred.Id"
                                                 Credential="@cred"
                                                 DirectoryPath="@GetDirectoryPath(cred.DirectoryId)"
                                                 ShowDirectoryPath="@IsSearchActive"
                                                 OnSelectDirectory="@((Guid? dirId) => HandleSelectDirectory(dirId))"
                                                 OnSelectDirectory="@HandleSelectDirectory"
                                                 OnEdit="@OpenCredentialModal"
                                                 OnDelete="@DeleteCredential" />
                        </ItemContent>
                        <Placeholder>
                            <div class="px-3.5 sm:px-6 py-3.5 flex items-center justify-between gap-4 h-[72px] animate-pulse">
                                <div class="flex items-center gap-3 sm:gap-4 flex-1">
                                    <div class="h-10 w-10 rounded-xl bg-slate-100"></div>
                                    <div class="flex-1 space-y-2">
                                        <div class="h-4 bg-slate-100 rounded w-1/3"></div>
                                        <div class="h-3 bg-slate-100 rounded w-1/4"></div>
                                    </div>
                                </div>
                            </div>
                        </Placeholder>
                    </Virtualize>
                </div>
            }
        }
    </AppCardBody>
</AppCard>
