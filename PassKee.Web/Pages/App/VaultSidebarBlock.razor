@namespace PassKee.Web.Pages.App
@using PassKee.Web.Components
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits BaseReactiveComponent

<div class="flex flex-col gap-3 w-full h-full min-h-0">
    <AppCard Class="shrink-0 shadow-xs">
        <AppCardBody Class="p-3">
            <div class="flex items-center justify-between mb-2">
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Current Vault</label>
                <div class="flex items-center gap-1.5">
                    <AppButton Color="@ComponentColor.Primary"
                               Variant="@ButtonVariant.Light"
                               Size="@ComponentSize.Small"
                               OnClick="@OpenImportModal"
                               Title="Import from KeePass"
                               Disabled="@(!VaultsState.Value.ActiveVaultId.HasValue || VaultsState.Value.ActiveVaultKey == null || VaultsState.Value.IsLoading || ImportState.Value.IsRunning)"
                               Class="h-6 px-2 text-xs">
                        <i class="fa-solid fa-file-import mr-1" aria-hidden="true"></i>Import
                    </AppButton>
                    <AppButton Color="@ComponentColor.Primary"
                               Variant="@ButtonVariant.Light"
                               Size="@ComponentSize.Small"
                               OnClick="@OpenCreateVaultModal"
                               Title="New Vault"
                               IsLoading="@VaultsState.Value.IsCreating"
                               Disabled="@VaultsState.Value.IsCreating"
                               Class="h-6 w-6 min-w-6 p-0">
                        <i class="fa-solid fa-plus text-xs"></i>
                    </AppButton>
                </div>
            </div>
            <AppSelect TValue="Guid?"
                       Value="@VaultsState.Value.ActiveVaultId"
                       ValueChanged="@OnSelectVault"
                       Items="@VaultIds"
                       ItemText="@GetVaultName"
                       Placeholder="Select a vault"
                       IsDisabled="@VaultsState.Value.IsLoading"
                       SelectType="DropDownType.Select"
                       IsFullWidth="true"
                       Size="ComponentSize.Small" />
        </AppCardBody>
    </AppCard>

    <AppCard Class="flex-1 flex flex-col min-h-0 shadow-xs">
        <AppCardHeader Class="py-2.5 px-4 flex items-center justify-between border-b border-slate-100 shrink-0">
            <h3 class="font-semibold text-sm text-slate-900">Directories</h3>
            <AppButton Color="@ComponentColor.Primary"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       OnClick="@(() => OpenDirectoryModal(null))"
                       Title="New Directory"
                       Class="h-6 w-6 min-w-6 p-0">
                <i class="fa-solid fa-plus text-xs"></i>
            </AppButton>
        </AppCardHeader>
        <AppCardBody Class="p-2 flex-1 overflow-y-auto min-h-0">
            <div class="flex flex-col gap-0.5">
                <div class="group flex items-center justify-between py-1.5 px-2 rounded-md cursor-pointer transition-colors
                            @(!VaultsState.Value.IsArchiveSelected && VaultsState.Value.SelectedDirectoryId == null ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-slate-100")"
                     @onclick="() => SelectDirectory(null)"
                     @ondragover="HandleRootDragOver"
                     @ondragover:preventDefault="true"
                     @ondrop="HandleRootDrop"
                     @ondrop:preventDefault="true">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-folder-minus text-blue-500 ml-1"></i>
                        <span class="text-sm">No Directory</span>
                    </div>
                </div>

                @if (!VaultsState.Value.Directories.Any())
                {
                    <div class="px-3 py-2 text-xs text-slate-400">
                        No directories yet.
                    </div>
                }
                else
                {
                    EnsureDirectoryStructure();
                    @for (var i = 0; i < _rootDirectories.Count; i++)
                    {
                        var dir = _rootDirectories[i];
                        var isDropUp = i >= Math.Max(1, _rootDirectories.Count / 2);
                        <DirectoryNode Directory="@dir" 
                                       ChildrenMap="@_childrenMap" 
                                       DirectoryMap="@_directoryMap" 
                                       SelectedDirectoryId="@(VaultsState.Value.IsArchiveSelected ? null : VaultsState.Value.SelectedDirectoryId)"
                                       ExpandedAncestorIds="@_expandedAncestorIds"
                                       IsDropUp="@isDropUp"
                                       OnSelect="@SelectDirectory"
                                       OnAddSubdirectory="@OpenCreateSubDirectoryModal"
                                       OnMove="@HandleDirectoryMove"
                                       OnOpenMove="@OpenMoveDirectoryModal"
                                       OnEdit="@OpenDirectoryModal"
                                       OnDelete="@DeleteDirectory" />
                    }
                }
            </div>
        </AppCardBody>

        <div class="p-2 border-t border-slate-100 shrink-0 bg-slate-50/50 rounded-b-2xl">
            <div class="group flex items-center justify-between py-1.5 px-2 rounded-md cursor-pointer transition-colors
                        @(VaultsState.Value.IsArchiveSelected ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-slate-100")"
                 @onclick="SelectArchive">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-box-archive text-amber-500 ml-1"></i>
                    <span class="text-sm">Archive</span>
                </div>
            </div>
        </div>
    </AppCard>
</div>
