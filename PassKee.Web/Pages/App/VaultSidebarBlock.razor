@namespace PassKee.Web.Pages.App
@using PassKee.Web.Components
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits BaseReactiveComponent

<div class="flex flex-col gap-4 w-full">
    <AppCard>
        <AppCardBody Class="p-4">
            <div class="flex items-center justify-between mb-2">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Current Vault</label>
                <AppButton Color="@ComponentColor.Primary"
                           Variant="@ButtonVariant.Light"
                           Size="@ComponentSize.Small"
                           OnClick="@OpenCreateVaultModal"
                           Title="New Vault"
                           IsLoading="@VaultsState.Value.IsCreating"
                           Disabled="@VaultsState.Value.IsCreating"
                           Class="h-7 w-7 min-w-7 p-0">
                    <i class="fa-solid fa-plus text-xs"></i>
                </AppButton>
            </div>
            <AppSelect TValue="Guid?"
                       Value="@VaultsState.Value.ActiveVaultId"
                       ValueChanged="@OnSelectVault"
                       Items="@VaultIds"
                       ItemText="@GetVaultName"
                       Placeholder="Select a vault"
                       IsDisabled="@VaultsState.Value.IsLoading"
                       SelectType="DropDownType.Select"
                       IsFullWidth="true"
                       Size="ComponentSize.Small" />
        </AppCardBody>
    </AppCard>

    <AppCard Class="flex-1 flex flex-col min-h-0">
        <AppCardHeader Class="py-3 px-4 flex items-center justify-between border-b border-slate-100">
            <h3 class="font-semibold text-sm text-slate-900">Directories</h3>
            <AppButton Color="@ComponentColor.Primary"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       OnClick="@(() => OpenDirectoryModal(null))"
                       Class="h-7 w-7 min-w-7 p-0">
                <i class="fa-solid fa-plus text-xs"></i>
            </AppButton>
        </AppCardHeader>
        <AppCardBody Class="p-2 flex-1 overflow-y-auto">
            @if (!VaultsState.Value.Directories.Any())
            {
                <div class="p-4 text-center text-sm text-slate-500">
                    No directories yet.
                </div>
            }
            else
            {
                <div class="flex flex-col gap-1">
                    <div class="group flex items-center justify-between py-1.5 px-2 rounded-md cursor-pointer transition-colors
                                @(VaultsState.Value.SelectedDirectoryId == null ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-slate-100")"
                         @onclick="() => SelectDirectory(null)"
                         @ondragover="HandleRootDragOver"
                         @ondragover:preventDefault="true"
                         @ondrop="HandleRootDrop"
                         @ondrop:preventDefault="true">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-vault text-blue-500 ml-1"></i>
                            <span class="text-sm">All Items</span>
                        </div>
                    </div>

                    @foreach (var dir in VaultsState.Value.Directories.Where(d => d.ParentDirectoryId == null))
                    {
                        <DirectoryNode Directory="@dir" 
                                       AllDirectories="@VaultsState.Value.Directories" 
                                       SelectedDirectoryId="@VaultsState.Value.SelectedDirectoryId"
                                       OnSelect="@SelectDirectory"
                                       OnAddSubdirectory="@OpenCreateSubDirectoryModal"
                                       OnMove="@HandleDirectoryMove"
                                       OnEdit="@OpenDirectoryModal"
                                       OnDelete="@DeleteDirectory" />
                    }
                </div>
            }
        </AppCardBody>
    </AppCard>
</div>
