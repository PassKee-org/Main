@page "/app"
@using PassKee.Web.Pages.App.Desktop
@using PassKee.Web.Pages.App.Mobile
@inherits BaseReactiveComponent

@if (ViewportService.IsInitialized)
{
    @if (ViewportService.IsMobile)
    {
        <MobileVaultViewBlock />
    }
    else
    {
        <DesktopVaultViewBlock />
    }
}
else
{
    <div class="hidden md:block">
        <DesktopVaultViewBlock />
    </div>
    <div class="md:hidden">
        <MobileVaultViewBlock />
    </div>
}
