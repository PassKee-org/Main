@namespace PassKee.Web.Pages.App.Mobile
@using PassKee.Web.Pages.App.Shared
@using PassKee.Web.Pages.App.Mobile.Parts
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Utils
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits VaultOperationsComponentBase

<div class="flex flex-col min-h-full">
    @if (VaultsState.Value.IsLoading || (VaultsState.Value.IsArchiveSelected && VaultsState.Value.IsArchiveLoading))
    {
        <div class="p-16 flex flex-col items-center justify-center text-center">
            <AppSpinner
                Color="@ComponentColor.Primary"
                Size="@ComponentSize.Large" />
            <h3 class="text-sm font-semibold text-slate-900 mt-4">
                @(VaultsState.Value.IsArchiveSelected ? "Loading archive..." : "Loading vault data...")
            </h3>
            <p class="text-xs text-slate-500 mt-1">Decrypting items</p>
        </div>
    }
    else
    {
        var snapshot = Hierarchy;
        var subdirectories = IsSearchActive
            ? FilteredDirectories
            : (VaultsState.Value.IsArchiveSelected ? [] : snapshot.GetSubdirectories(VaultsState.Value.SelectedDirectoryId));
        var credentials = DisplayedCredentials;
        var breadcrumbs = snapshot.GetBreadcrumbChain(VaultsState.Value.SelectedDirectoryId);

        @if (!IsSearchActive && (breadcrumbs.Count > 0 || VaultsState.Value.IsArchiveSelected))
        {
            <div class="px-4 py-2 bg-slate-100/80 border-b border-slate-200/70 flex items-center gap-1.5 overflow-x-auto text-xs text-slate-500 whitespace-nowrap scrollbar-thin">
                <button type="button"
                        @onclick="() => SelectDirectory(null)"
                        class="hover:text-blue-600 font-medium inline-flex items-center gap-1 shrink-0">
                    <i class="fa-solid fa-layer-group text-[10px]"></i>
                    <span>@(string.IsNullOrWhiteSpace(ActiveVaultName) ? "Root" : ActiveVaultName)</span>
                </button>
                @if (VaultsState.Value.IsArchiveSelected)
                {
                    <i class="fa-solid fa-chevron-right text-[9px] text-slate-400 shrink-0"></i>
                    <span class="font-semibold text-amber-600 shrink-0">Archive</span>
                }
                else
                {
                    @for (var i = 0; i < breadcrumbs.Count; i++)
                    {
                        var crumb = breadcrumbs[i];
                        var isLast = i == breadcrumbs.Count - 1;
                        <i class="fa-solid fa-chevron-right text-[9px] text-slate-400 shrink-0"></i>
                        <button type="button"
                                @onclick="() => SelectDirectory(crumb.Id)"
                                class="@(isLast ? "font-semibold text-slate-900" : "hover:text-blue-600") truncate max-w-[140px] shrink-0">
                            @crumb.Name
                        </button>
                    }
                }
            </div>
        }

        @if (IsSelectionMode)
        {
            <div class="sticky top-0 z-20 px-4 py-2.5 bg-blue-50 border-b border-blue-100 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-blue-800">
                        @_selectedCredentialIds.Count selected
                    </span>
                    @if (credentials.Count > 0)
                    {
                        <button type="button"
                                @onclick="ToggleSelectAll"
                                class="text-xs font-semibold text-blue-600 hover:underline ml-1">
                            @(_selectedCredentialIds.Count >= credentials.Count ? "Clear all" : "Select all")
                        </button>
                    }
                </div>
                <div class="flex items-center gap-1.5">
                    @if (_selectedCredentialIds.Count > 0)
                    {
                        @if (VaultsState.Value.IsArchiveSelected)
                        {
                            <AppButton
                                Color="@ComponentColor.Danger"
                                Variant="@ButtonVariant.Solid"
                                Size="@ComponentSize.Small"
                                OnClick="@DeleteSelectedCredentialsAsync">
                                <i class="fa-solid fa-trash mr-1"></i>
                                <span>Delete</span>
                            </AppButton>
                        }
                        else
                        {
                            <AppButton
                                Color="@ComponentColor.Danger"
                                Variant="@ButtonVariant.Light"
                                Size="@ComponentSize.Small"
                                OnClick="@ArchiveSelectedCredentialsAsync">
                                <i class="fa-solid fa-box-archive mr-1"></i>
                                <span>Archive</span>
                            </AppButton>
                        }
                    }
                    <AppButton
                        Color="@ComponentColor.Default"
                        Variant="@ButtonVariant.Light"
                        Size="@ComponentSize.Small"
                        OnClick="@ExitSelectionMode">
                        <span>Done</span>
                    </AppButton>
                </div>
            </div>
        }

        <div class="divide-y divide-slate-100 bg-white border-b border-slate-200/70">
            @if (subdirectories.Count > 0)
            {
                @for (var i = 0; i < subdirectories.Count; i++)
                {
                    var dir = subdirectories[i];
                    var isDropUp = i >= Math.Max(2, subdirectories.Count + credentials.Count - 2);
                    <MobileDirectoryRowBlock
                        Directory="@dir"
                        ItemCount="@snapshot.GetTotalItemCount(dir.Id)"
                        SubdirectoryCount="@snapshot.GetSubdirectoryCount(dir.Id)"
                        IsDropUp="@isDropUp"
                        OnSelect="@HandleSelectDirectory"
                        OnAddSubdirectory="@OpenCreateSubDirectoryModalAsync"
                        OnEdit="@OpenEditDirectoryModalAsync"
                        OnMove="@OpenMoveDirectoryModalAsync"
                        OnDelete="@DeleteDirectoryAsync" />
                }
            }

            @if (!IsSearchActive && !VaultsState.Value.IsArchiveSelected && VaultsState.Value.SelectedDirectoryId == null)
            {
                <div class="px-4 py-3.5 flex items-center justify-between bg-white hover:bg-slate-50 active:bg-slate-100/80 transition cursor-pointer select-none border-b border-slate-100 last:border-b-0"
                     @onclick="SelectArchive">
                    <div class="flex items-center gap-3.5 min-w-0 flex-1">
                        <div class="h-10 w-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-box-archive text-base"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="text-[15px] font-semibold text-slate-900 truncate">Archive</div>
                            <div class="text-xs text-slate-400 truncate">Archived entries</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0 ml-2">
                        <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
                    </div>
                </div>
            }

            @if (credentials.Count > 0)
            {
                @for (var i = 0; i < credentials.Count; i++)
                {
                    var cred = credentials[i];
                    var isDropUp = i >= Math.Max(2, credentials.Count - 2);
                    <MobileCredentialRowBlock
                        @key="cred.Id"
                        Credential="@cred"
                        DirectoryPath="@snapshot.GetDirectoryPath(cred.DirectoryId)"
                        ShowDirectoryPath="@(IsSearchActive && !VaultsState.Value.IsArchiveSelected)"
                        IsSelectionMode="@IsSelectionMode"
                        IsSelected="@_selectedCredentialIds.Contains(cred.Id)"
                        IsDropUp="@isDropUp"
                        OnSelectionChanged="@((selected) => ToggleCredentialSelection(cred.Id, selected))"
                        OnEnterSelectionMode="@EnterSelectionModeWithCredential"
                        OnSelectDirectory="@SelectDirectoryFromSearch"
                        OnView="@OpenViewCredentialModalAsync"
                        OnEdit="@OpenEditCredentialModalAsync"
                        OnMove="@OpenMoveCredentialModalAsync"
                        OnDuplicate="@DuplicateCredentialAsync"
                        OnShare="@OpenShareCredentialModalAsync"
                        OnArchive="@ArchiveCredentialAsync"
                        OnDelete="@DeleteSingleArchivedCredentialAsync"
                        OnCopyValue="@(tuple => CopyToClipboardAsync(tuple.Value, tuple.Label))" />
                }
            }
        </div>

        @if (subdirectories.Count == 0 && credentials.Count == 0)
        {
            <div class="p-10 flex flex-col items-center justify-center text-center">
                @if (IsSearchActive)
                {
                    <CredentialEmptyStateBlock
                        IsSearchActive="true"
                        SearchQuery="@SearchQuery"
                        HasMatchingDirectories="false"
                        OnClearSearch="@ClearSearch" />
                }
                else if (VaultsState.Value.IsArchiveSelected)
                {
                    <div class="h-14 w-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl mb-3">
                        <i class="fa-solid fa-box-archive"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900">Archive is empty</h3>
                    <p class="text-xs text-slate-500 mt-1">Archived entries will appear here.</p>
                }
                else
                {
                    <div class="h-14 w-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl mb-3">
                        <i class="fa-regular fa-folder-open"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900">This folder is empty</h3>
                    <p class="text-xs text-slate-500 mt-1 max-w-xs">Add a new credential or create a subfolder here.</p>
                    <div class="flex items-center gap-2 mt-4">
                        <AppButton
                            Color="@ComponentColor.Primary"
                            Variant="@ButtonVariant.Solid"
                            Size="@ComponentSize.Small"
                            OnClick="@(() => OpenCredentialModalAsync(null, startInEditMode: true))">
                            <i class="fa-solid fa-plus mr-1.5"></i>
                            <span>New Item</span>
                        </AppButton>
                        <AppButton
                            Color="@ComponentColor.Default"
                            Variant="@ButtonVariant.Outlined"
                            Size="@ComponentSize.Small"
                            OnClick="@(() => OpenCreateDirectoryModalAsync(VaultsState.Value.SelectedDirectoryId))">
                            <i class="fa-solid fa-folder-plus mr-1.5"></i>
                            <span>New Folder</span>
                        </AppButton>
                    </div>
                }
            </div>
        }
    }
</div>

