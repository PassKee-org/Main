@namespace PassKee.Web.Pages.App.Mobile.Parts
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Pages.App.Shared
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Dropdown
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<div class="px-4 py-3.5 flex items-center justify-between bg-white hover:bg-slate-50 active:bg-slate-100/80 transition cursor-pointer select-none border-b border-slate-100 last:border-b-0 @(IsSelected ? "!bg-blue-50/70" : "")"
     @onclick="HandleRowTap">
    @if (IsSelectionMode)
    {
        <div class="flex items-center shrink-0 pr-3"
             @onclick:stopPropagation="true">
            <AppCheckbox
                Value="@IsSelected"
                ValueChanged="@((val) => OnSelectionChanged.InvokeAsync(val))"
                Size="@ComponentSize.Small" />
        </div>
    }

    <div class="flex items-center gap-3.5 flex-1 min-w-0">
        <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-base shrink-0 font-bold">
            @if (!string.IsNullOrWhiteSpace(Credential.Payload?.Icon))
            {
                <span class="text-xl leading-none select-none">@EmojiHelper.FormatEmoji(Credential.Payload?.Icon)</span>
            }
            else
            {
                <i class="@VaultOperationsComponentBase.GetCredentialTypeIcon(Credential.Type)"></i>
            }
        </div>

        <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 min-w-0">
                <span class="font-semibold text-[15px] text-slate-900 truncate">@Credential.Payload?.Title</span>
            </div>

            <div class="flex items-center gap-1.5 mt-0.5 min-w-0">
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <span class="text-xs text-slate-500 truncate">@Subtitle</span>
                }
                else
                {
                    <span class="text-xs text-slate-400">@VaultOperationsComponentBase.GetCredentialTypeLabel(Credential.Type)</span>
                }

                @if (ShowDirectoryPath && !string.IsNullOrWhiteSpace(DirectoryPath))
                {
                    <span class="text-slate-300 text-xs shrink-0">•</span>
                    <button type="button"
                            class="inline-flex items-center gap-1 text-[11px] font-medium text-blue-600 bg-blue-50/80 px-1.5 py-0.5 rounded truncate max-w-[140px] shrink-0"
                            @onclick:stopPropagation="true"
                            @onclick="HandleDirectoryTap">
                        <i class="fa-regular fa-folder text-[9px]"></i>
                        <span class="truncate">@DirectoryPath</span>
                    </button>
                }
            </div>
        </div>
    </div>

    @if (!IsSelectionMode)
    {
        <div class="flex items-center gap-1 shrink-0 ml-2"
             @onclick:stopPropagation="true">
            @if (!string.IsNullOrEmpty(PrimaryCopyValue))
            {
                <button type="button"
                        class="h-9 w-9 rounded-full text-slate-500 hover:text-blue-600 hover:bg-blue-50 active:scale-95 flex items-center justify-center transition touch-manipulation"
                        title="@($"Copy {PrimaryCopyLabel}")"
                        aria-label="@($"Copy {PrimaryCopyLabel}")"
                        @onclick="HandleQuickCopyPrimaryAsync">
                    <i class="fa-regular fa-copy text-sm"></i>
                </button>
            }

            <AppDropdown
                Alignment="@DropdownAlignment.Right"
                IsDropUp="@IsDropUp">
                <Trigger>
                    <button type="button"
                            class="h-9 w-9 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100 active:bg-slate-200 flex items-center justify-center transition touch-manipulation"
                            title="Entry actions"
                            aria-label="Entry actions">
                        <i class="fa-solid fa-ellipsis-vertical text-sm"></i>
                    </button>
                </Trigger>
                <Menu>
                    @if (!string.IsNullOrEmpty(SecondaryCopyValue))
                    {
                        <AppDropdownItem OnClick="HandleQuickCopySecondaryAsync">
                            <div class="flex items-center gap-2.5">
                                <i class="fa-regular fa-user w-4 text-center text-blue-600" aria-hidden="true"></i>
                                <span class="font-medium">Copy @SecondaryCopyLabel</span>
                            </div>
                        </AppDropdownItem>
                    }
                    @if (!string.IsNullOrEmpty(PrimaryCopyValue))
                    {
                        <AppDropdownItem OnClick="HandleQuickCopyPrimaryAsync">
                            <div class="flex items-center gap-2.5">
                                <i class="fa-solid fa-key w-4 text-center text-blue-600" aria-hidden="true"></i>
                                <span class="font-medium">Copy @PrimaryCopyLabel</span>
                            </div>
                        </AppDropdownItem>
                    }
                    <AppDropdownItem OnClick="() => OnEdit.InvokeAsync(Credential)">
                        <div class="flex items-center gap-2.5">
                            <i class="fa-solid fa-pen w-4 text-center text-slate-500" aria-hidden="true"></i>
                            <span class="font-medium">Edit</span>
                        </div>
                    </AppDropdownItem>
                    @if (Credential.ArchivedAt == null)
                    {
                        <AppDropdownItem OnClick="() => OnMove.InvokeAsync(Credential)">
                            <div class="flex items-center gap-2.5">
                                <i class="fa-solid fa-folder-tree w-4 text-center text-slate-500" aria-hidden="true"></i>
                                <span class="font-medium">Move...</span>
                            </div>
                        </AppDropdownItem>
                    }
                    <AppDropdownItem OnClick="() => OnDuplicate.InvokeAsync(Credential)">
                        <div class="flex items-center gap-2.5">
                            <i class="fa-regular fa-clone w-4 text-center text-slate-500" aria-hidden="true"></i>
                            <span class="font-medium">Duplicate</span>
                        </div>
                    </AppDropdownItem>
                    <AppDropdownItem OnClick="() => OnShare.InvokeAsync(Credential)">
                        <div class="flex items-center gap-2.5">
                            <i class="fa-solid fa-arrow-up-right-from-square w-4 text-center text-slate-500" aria-hidden="true"></i>
                            <span class="font-medium">Share...</span>
                        </div>
                    </AppDropdownItem>
                    @if (OnEnterSelectionMode.HasDelegate)
                    {
                        <AppDropdownItem OnClick="() => OnEnterSelectionMode.InvokeAsync(Credential)">
                            <div class="flex items-center gap-2.5">
                                <i class="fa-regular fa-square-check w-4 text-center text-slate-500" aria-hidden="true"></i>
                                <span class="font-medium">Select</span>
                            </div>
                        </AppDropdownItem>
                    }
                    @if (Credential.ArchivedAt == null)
                    {
                        <AppDropdownItem
                            OnClick="() => OnArchive.InvokeAsync(Credential)"
                            ShowDivider="true">
                            <div class="flex items-center gap-2.5 text-amber-600">
                                <i class="fa-solid fa-box-archive w-4 text-center text-amber-500" aria-hidden="true"></i>
                                <span class="font-medium">Archive</span>
                            </div>
                        </AppDropdownItem>
                    }
                    else
                    {
                        <AppDropdownItem
                            OnClick="() => OnDelete.InvokeAsync(Credential)"
                            Color="@ComponentColor.Danger"
                            ShowDivider="true">
                            <div class="flex items-center gap-2.5 text-rose-600">
                                <i class="fa-solid fa-trash w-4 text-center text-rose-500" aria-hidden="true"></i>
                                <span class="font-medium">Delete Permanently</span>
                            </div>
                        </AppDropdownItem>
                    }
                </Menu>
            </AppDropdown>
        </div>
    }
</div>

