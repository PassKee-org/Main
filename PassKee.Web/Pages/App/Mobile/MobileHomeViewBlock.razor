@namespace PassKee.Web.Pages.App.Mobile
@using PassKee.Web.Pages.App.Shared
@using PassKee.Web.Pages.App.Mobile.Parts
@using PassKee.Web.Constants.Navigation
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits VaultOperationsComponentBase

<div class="p-4 space-y-4">
    <AppCard Class="shadow-2xs">
        <AppCardBody Class="p-4 space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Active Vault</span>
                <div class="flex items-center gap-1.5">
                    <AppButton
                        Color="@ComponentColor.Primary"
                        Variant="@ButtonVariant.Light"
                        Size="@ComponentSize.Small"
                        OnClick="@OpenCreateVaultModalAsync"
                        IsLoading="@VaultsState.Value.IsCreating"
                        Disabled="@VaultsState.Value.IsCreating">
                        <i class="fa-solid fa-plus mr-1 text-xs"></i>
                        <span>New Vault</span>
                    </AppButton>
                </div>
            </div>

            <AppSelect
                TValue="Guid?"
                Value="@VaultsState.Value.ActiveVaultId"
                ValueChanged="@SelectVault"
                Items="@VaultIds"
                ItemText="@GetVaultName"
                Placeholder="Select a vault"
                IsDisabled="@VaultsState.Value.IsLoading"
                SelectType="DropDownType.Select"
                IsFullWidth="true"
                Size="ComponentSize.Small" />

            <div class="grid grid-cols-3 gap-2 pt-1">
                <AppButton
                    Color="@ComponentColor.Default"
                    Variant="@ButtonVariant.Light"
                    Size="@ComponentSize.Small"
                    Disabled="@(!CanImportOrExport)"
                    OnClick="@OpenImportModalAsync"
                    Class="w-full justify-center text-xs">
                    <i class="fa-solid fa-file-import text-sky-600 mr-1.5"></i>
                    <span>Import</span>
                </AppButton>
                <AppButton
                    Color="@ComponentColor.Default"
                    Variant="@ButtonVariant.Light"
                    Size="@ComponentSize.Small"
                    Disabled="@(!CanImportOrExport)"
                    OnClick="@OpenExportModalAsync"
                    Class="w-full justify-center text-xs">
                    <i class="fa-solid fa-file-export text-sky-600 mr-1.5"></i>
                    <span>Backup</span>
                </AppButton>
                <AppButton
                    Color="@ComponentColor.Danger"
                    Variant="@ButtonVariant.Light"
                    Size="@ComponentSize.Small"
                    Disabled="@(!CanDeleteVault)"
                    OnClick="@DeleteActiveVaultAsync"
                    Class="w-full justify-center text-xs">
                    <i class="fa-solid fa-trash mr-1.5"></i>
                    <span>Delete</span>
                </AppButton>
            </div>
        </AppCardBody>
    </AppCard>

    <div class="grid grid-cols-2 gap-2.5">
        <button type="button"
                @onclick="() => OpenCredentialModalAsync(null, startInEditMode: true)"
                class="p-3.5 rounded-2xl bg-white border border-slate-200/80 shadow-2xs active:scale-[0.98] transition flex items-center gap-3 text-left">
            <div class="h-10 w-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-plus text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 truncate">New Item</div>
                <div class="text-[11px] text-slate-500 truncate">Add credential</div>
            </div>
        </button>

        <button type="button"
                @onclick="() => OpenCreateDirectoryModalAsync(null)"
                class="p-3.5 rounded-2xl bg-white border border-slate-200/80 shadow-2xs active:scale-[0.98] transition flex items-center gap-3 text-left">
            <div class="h-10 w-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-folder-plus text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 truncate">New Folder</div>
                <div class="text-[11px] text-slate-500 truncate">Create directory</div>
            </div>
        </button>

        <button type="button"
                @onclick="OpenPasswordGeneratorAsync"
                class="p-3.5 rounded-2xl bg-white border border-slate-200/80 shadow-2xs active:scale-[0.98] transition flex items-center gap-3 text-left">
            <div class="h-10 w-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-key text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 truncate">Password</div>
                <div class="text-[11px] text-slate-500 truncate">Generator & PIN</div>
            </div>
        </button>

        <button type="button"
                @onclick="OpenGuidGeneratorAsync"
                class="p-3.5 rounded-2xl bg-white border border-slate-200/80 shadow-2xs active:scale-[0.98] transition flex items-center gap-3 text-left">
            <div class="h-10 w-10 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-fingerprint text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 truncate">GUID & Token</div>
                <div class="text-[11px] text-slate-500 truncate">UUID v4/v7, Hex</div>
            </div>
        </button>
    </div>

    <AppCard Class="shadow-2xs overflow-hidden">
        <AppCardHeader Class="px-4 py-2.5 border-b border-slate-100 bg-slate-50/60">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Browse Vault</h3>
        </AppCardHeader>
        <AppCardBody Class="p-0 divide-y divide-slate-100">
            <button type="button"
                    @onclick="NavigateToRootGroups"
                    class="w-full px-4 py-3.5 flex items-center justify-between hover:bg-slate-50 active:bg-slate-100 transition text-left">
                <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                        <i class="fa-solid fa-folder-tree text-sm"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-slate-900">Directories (Groups)</div>
                        <div class="text-xs text-slate-500">@VaultsState.Value.Directories.Count @(VaultsState.Value.Directories.Count == 1 ? "folder" : "folders")</div>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
            </button>

            <button type="button"
                    @onclick="NavigateToAllEntries"
                    class="w-full px-4 py-3.5 flex items-center justify-between hover:bg-slate-50 active:bg-slate-100 transition text-left">
                <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                        <i class="fa-solid fa-list-ul text-sm"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-slate-900">All Entries</div>
                        <div class="text-xs text-slate-500">@VaultsState.Value.Credentials.Count @(VaultsState.Value.Credentials.Count == 1 ? "item" : "items")</div>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
            </button>

            <button type="button"
                    @onclick="NavigateToArchive"
                    class="w-full px-4 py-3.5 flex items-center justify-between hover:bg-slate-50 active:bg-slate-100 transition text-left">
                <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                        <i class="fa-solid fa-box-archive text-sm"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-slate-900">Archive</div>
                        <div class="text-xs text-slate-500">Archived items</div>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
            </button>
        </AppCardBody>
    </AppCard>

    @if (QuickAccessCredentials.Count > 0)
    {
        <AppCard Class="shadow-2xs overflow-hidden">
            <AppCardHeader Class="px-4 py-2.5 border-b border-slate-100 bg-slate-50/60 flex items-center justify-between">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Quick Access</h3>
                <button type="button"
                        @onclick="NavigateToAllEntries"
                        class="text-xs font-semibold text-sky-600">
                    View all
                </button>
            </AppCardHeader>
            <AppCardBody Class="p-0 divide-y divide-slate-100">
                @foreach (var cred in QuickAccessCredentials)
                {
                    <MobileCredentialRowBlock
                        @key="cred.Id"
                        Credential="@cred"
                        DirectoryPath="@Hierarchy.GetDirectoryPath(cred.DirectoryId)"
                        ShowDirectoryPath="true"
                        OnSelectDirectory="@SelectDirectoryFromSearch"
                        OnView="@OpenViewCredentialModalAsync"
                        OnEdit="@OpenEditCredentialModalAsync"
                        OnMove="@OpenMoveCredentialModalAsync"
                        OnDuplicate="@DuplicateCredentialAsync"
                        OnShare="@OpenShareCredentialModalAsync"
                        OnArchive="@ArchiveCredentialAsync"
                        OnDelete="@DeleteSingleArchivedCredentialAsync"
                        OnCopyValue="@(tuple => CopyToClipboardAsync(tuple.Value, tuple.Label))" />
                }
            </AppCardBody>
        </AppCard>
    }
</div>

