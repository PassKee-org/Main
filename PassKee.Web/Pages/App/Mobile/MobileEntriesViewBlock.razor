@namespace PassKee.Web.Pages.App.Mobile
@using PassKee.Business.Common.Constants
@using PassKee.Web.Pages.App.Shared
@using PassKee.Web.Pages.App.Mobile.Parts
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Utils
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits VaultOperationsComponentBase

<div class="flex flex-col min-h-full">
    @if (VaultsState.Value.IsLoading)
    {
        <div class="p-16 flex flex-col items-center justify-center text-center">
            <AppSpinner
                Color="@ComponentColor.Primary"
                Size="@ComponentSize.Large" />
            <h3 class="text-sm font-semibold text-slate-900 mt-4">Loading entries...</h3>
            <p class="text-xs text-slate-500 mt-1">Decrypting items</p>
        </div>
    }
    else
    {
        var snapshot = Hierarchy;
        var entries = DisplayedEntries;

        <div class="px-3.5 py-2.5 bg-white border-b border-slate-200/70 flex items-center gap-1.5 overflow-x-auto whitespace-nowrap scrollbar-thin">
            <button type="button"
                    @onclick="() => SelectTypeFilter(null)"
                    class="px-3 py-1 rounded-full text-xs font-semibold transition shrink-0 @(_selectedType == null ? "bg-blue-600 text-white shadow-2xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                All (@VaultsState.Value.Credentials.Count)
            </button>
            @foreach (var type in AvailableTypes)
            {
                var isSelected = _selectedType == type;
                <button type="button"
                        @onclick="() => SelectTypeFilter(type)"
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition shrink-0 @(isSelected ? "bg-blue-600 text-white shadow-2xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    <i class="@GetCredentialTypeIcon(type) text-[11px]"></i>
                    <span>@GetCredentialTypeLabel(type)</span>
                </button>
            }
        </div>

        @if (IsSelectionMode)
        {
            <div class="sticky top-0 z-20 px-4 py-2.5 bg-blue-50 border-b border-blue-100 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-blue-800">
                        @_selectedCredentialIds.Count selected
                    </span>
                    @if (entries.Count > 0)
                    {
                        <button type="button"
                                @onclick="ToggleSelectAll"
                                class="text-xs font-semibold text-blue-600 hover:underline ml-1">
                            @(_selectedCredentialIds.Count >= entries.Count ? "Clear all" : "Select all")
                        </button>
                    }
                </div>
                <div class="flex items-center gap-1.5">
                    @if (_selectedCredentialIds.Count > 0)
                    {
                        <AppButton
                            Color="@ComponentColor.Danger"
                            Variant="@ButtonVariant.Light"
                            Size="@ComponentSize.Small"
                            OnClick="@ArchiveSelectedEntriesAsync">
                            <i class="fa-solid fa-box-archive mr-1"></i>
                            <span>Archive</span>
                        </AppButton>
                    }
                    <AppButton
                        Color="@ComponentColor.Default"
                        Variant="@ButtonVariant.Light"
                        Size="@ComponentSize.Small"
                        OnClick="@ExitSelectionMode">
                        <span>Done</span>
                    </AppButton>
                </div>
            </div>
        }

        @if (entries.Count == 0)
        {
            <CredentialEmptyStateBlock
                IsSearchActive="@(IsSearchActive || _selectedType.HasValue)"
                SearchQuery="@(IsSearchActive ? SearchQuery : GetCredentialTypeLabel(_selectedType ?? CredentialType.Login))"
                HasMatchingDirectories="false"
                OnClearSearch="@ClearFilters" />
        }
        else
        {
            <div class="divide-y divide-slate-100 bg-white border-b border-slate-200/70">
                @for (var i = 0; i < entries.Count; i++)
                {
                    var cred = entries[i];
                    var isDropUp = i >= Math.Max(2, entries.Count - 2);
                    <MobileCredentialRowBlock
                        @key="cred.Id"
                        Credential="@cred"
                        DirectoryPath="@snapshot.GetDirectoryPath(cred.DirectoryId)"
                        ShowDirectoryPath="true"
                        IsSelectionMode="@IsSelectionMode"
                        IsSelected="@_selectedCredentialIds.Contains(cred.Id)"
                        IsDropUp="@isDropUp"
                        OnSelectionChanged="@((selected) => ToggleCredentialSelection(cred.Id, selected))"
                        OnEnterSelectionMode="@EnterSelectionModeWithCredential"
                        OnSelectDirectory="@SelectDirectoryFromSearch"
                        OnView="@OpenViewCredentialModalAsync"
                        OnEdit="@OpenEditCredentialModalAsync"
                        OnMove="@OpenMoveCredentialModalAsync"
                        OnDuplicate="@DuplicateCredentialAsync"
                        OnShare="@OpenShareCredentialModalAsync"
                        OnArchive="@ArchiveCredentialAsync"
                        OnDelete="@DeleteSingleArchivedCredentialAsync"
                        OnCopyValue="@(tuple => CopyToClipboardAsync(tuple.Value, tuple.Label))" />
                }
                <Virtualize
                    @ref="_virtualize"
                    TItem="DecryptedCredential"
                    Items="@entries"
                    ItemSize="68f"
                    OverscanCount="10">
                    <ItemContent Context="cred">
                        @{
                            var isDropUp = entries.Count > 0 && (cred.Id == entries[^1].Id || (entries.Count > 1 && cred.Id == entries[^2].Id));
                        }
                        <MobileCredentialRowBlock
                            @key="cred.Id"
                            Credential="@cred"
                            DirectoryPath="@snapshot.GetDirectoryPath(cred.DirectoryId)"
                            ShowDirectoryPath="true"
                            IsSelectionMode="@IsSelectionMode"
                            IsSelected="@_selectedCredentialIds.Contains(cred.Id)"
                            IsDropUp="@isDropUp"
                            OnSelectionChanged="@((selected) => ToggleCredentialSelection(cred.Id, selected))"
                            OnEnterSelectionMode="@EnterSelectionModeWithCredential"
                            OnSelectDirectory="@SelectDirectoryFromSearch"
                            OnView="@OpenViewCredentialModalAsync"
                            OnEdit="@OpenEditCredentialModalAsync"
                            OnMove="@OpenMoveCredentialModalAsync"
                            OnDuplicate="@DuplicateCredentialAsync"
                            OnShare="@OpenShareCredentialModalAsync"
                            OnArchive="@ArchiveCredentialAsync"
                            OnDelete="@DeleteSingleArchivedCredentialAsync"
                            OnCopyValue="@(tuple => CopyToClipboardAsync(tuple.Value, tuple.Label))" />
                    </ItemContent>
                    <Placeholder>
                        <div class="px-4 py-3.5 flex items-center justify-between gap-3.5 bg-white border-b border-slate-100 h-[68px] animate-pulse">
                            <div class="h-10 w-10 rounded-xl bg-slate-100 shrink-0"></div>
                            <div class="flex-1 space-y-2">
                                <div class="h-4 bg-slate-100 rounded w-1/3"></div>
                                <div class="h-3 bg-slate-100 rounded w-1/4"></div>
                            </div>
                        </div>
                    </Placeholder>
                </Virtualize>
            </div>
        }
    }
</div>

