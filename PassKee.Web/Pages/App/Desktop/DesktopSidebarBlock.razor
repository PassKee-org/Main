@namespace PassKee.Web.Pages.App.Desktop
@using PassKee.Web.Pages.App.Shared
@using PassKee.Web.Pages.App.Desktop.Parts
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Dropdown
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits VaultOperationsComponentBase

<div class="flex flex-col gap-3 w-full h-full min-h-0">
    <AppCard Class="shrink-0 shadow-xs z-20">
        <AppCardBody Class="p-3">
            <div class="flex items-center justify-between mb-2">
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Current Vault</label>
                <div class="flex items-center gap-1">
                    <AppButton
                        Color="@ComponentColor.Primary"
                        Variant="@ButtonVariant.Light"
                        Size="@ComponentSize.Small"
                        OnClick="@OpenCreateVaultModalAsync"
                        Title="New Vault"
                        IsLoading="@VaultsState.Value.IsCreating"
                        Disabled="@VaultsState.Value.IsCreating"
                        Class="h-6 w-6 min-w-6 p-0">
                        <i class="fa-solid fa-plus text-xs"></i>
                    </AppButton>
                    <AppDropdown Alignment="@DropdownAlignment.Right">
                        <Trigger>
                            <AppButton
                                Color="@ComponentColor.Primary"
                                Variant="@ButtonVariant.Light"
                                Size="@ComponentSize.Small"
                                Title="Vault actions"
                                aria-label="Vault actions"
                                Class="h-6 w-6 min-w-6 p-0">
                                <i class="fa-solid fa-ellipsis-vertical text-xs" aria-hidden="true"></i>
                            </AppButton>
                        </Trigger>
                        <Menu>
                            <AppDropdownItem
                                Icon="fa-solid fa-file-import text-sky-600"
                                Text="Import"
                                Description="From KeePass (.kdbx)"
                                Disabled="@(!CanImportOrExport)"
                                OnClick="@OpenImportModalAsync" />
                            <AppDropdownItem
                                Icon="fa-solid fa-file-export text-sky-600"
                                Text="Backup"
                                Description="Export to KeePass (.kdbx)"
                                Disabled="@(!CanImportOrExport)"
                                OnClick="@OpenExportModalAsync" />
                            <AppDropdownItem
                                Icon="fa-solid fa-trash text-rose-500"
                                Color="@ComponentColor.Danger"
                                ShowDivider="true"
                                Text="Delete Vault"
                                Description="Delete current vault"
                                Disabled="@(!CanDeleteVault)"
                                OnClick="@DeleteActiveVaultAsync" />
                        </Menu>
                    </AppDropdown>
                </div>
            </div>
            <AppSelect
                TValue="Guid?"
                Value="@VaultsState.Value.ActiveVaultId"
                ValueChanged="@SelectVault"
                Items="@VaultIds"
                ItemText="@GetVaultName"
                Placeholder="Select a vault"
                IsDisabled="@VaultsState.Value.IsLoading"
                SelectType="DropDownType.Select"
                IsFullWidth="true"
                Size="ComponentSize.Small" />
        </AppCardBody>
    </AppCard>

    <AppCard Class="flex-1 flex flex-col min-h-0 shadow-xs">
        <AppCardHeader Class="py-2.5 px-4 flex items-center justify-between border-b border-slate-100 shrink-0">
            <h3 class="font-semibold text-sm text-slate-900">Directories</h3>
            <AppButton
                Color="@ComponentColor.Primary"
                Variant="@ButtonVariant.Light"
                Size="@ComponentSize.Small"
                OnClick="@(() => OpenCreateDirectoryModalAsync(null))"
                Title="New Directory"
                Class="h-6 w-6 min-w-6 p-0">
                <i class="fa-solid fa-plus text-xs"></i>
            </AppButton>
        </AppCardHeader>
        <AppCardBody Class="p-2 flex-1 overflow-y-auto min-h-0">
            @{
                var snapshot = Hierarchy;
                var expandedAncestors = snapshot.GetExpandedAncestorIds(VaultsState.Value.SelectedDirectoryId);
            }
            <div class="flex flex-col gap-0.5">
                <div class="group flex items-center justify-between py-1.5 px-2 rounded-md cursor-pointer transition-colors
                            @(!VaultsState.Value.IsArchiveSelected && VaultsState.Value.SelectedDirectoryId == null ? "bg-sky-50 text-sky-700 font-medium" : "text-slate-600 hover:bg-slate-100")"
                     @onclick="() => SelectDirectory(null)"
                     @ondragover="HandleRootDragOver"
                     @ondragover:preventDefault="true"
                     @ondrop="HandleRootDrop"
                     @ondrop:preventDefault="true">
                    <div class="flex items-center gap-2 overflow-hidden flex-1 min-w-0">
                        <i class="fa-solid fa-folder-minus text-sky-500 ml-1"></i>
                        <span class="text-sm truncate select-none">No Directory</span>
                    </div>
                    @if (snapshot.RootCredentialCount > 0)
                    {
                        <span class="text-[11px] tabular-nums font-normal select-none shrink-0 ml-1.5 transition-colors @(!VaultsState.Value.IsArchiveSelected && VaultsState.Value.SelectedDirectoryId == null ? "text-sky-600/80 font-medium" : "text-slate-400 group-hover:text-slate-500")">
                            @snapshot.RootCredentialCount
                        </span>
                    }
                </div>

                @if (!VaultsState.Value.Directories.Any())
                {
                    <div class="px-3 py-2 text-xs text-slate-400">
                        No directories yet.
                    </div>
                }
                else
                {
                    @for (var i = 0; i < snapshot.RootDirectories.Count; i++)
                    {
                        var dir = snapshot.RootDirectories[i];
                        var isDropUp = i >= Math.Max(1, snapshot.RootDirectories.Count / 2);
                        <DesktopDirectoryNodeBlock
                            Directory="@dir"
                            ChildrenMap="@snapshot.ChildrenMap"
                            DirectoryMap="@snapshot.DirectoryMap"
                            DirectoryCounts="@snapshot.DirectDirectoryCounts"
                            SelectedDirectoryId="@(VaultsState.Value.IsArchiveSelected ? null : VaultsState.Value.SelectedDirectoryId)"
                            ExpandedAncestorIds="@expandedAncestors"
                            IsDropUp="@isDropUp"
                            OnSelect="@SelectDirectory"
                            OnAddSubdirectory="@OpenCreateSubDirectoryModalAsync"
                            OnMove="@HandleDirectoryMove"
                            OnOpenMove="@OpenMoveDirectoryModalAsync"
                            OnEdit="@OpenEditDirectoryModalAsync"
                            OnDelete="@DeleteDirectoryAsync" />
                    }
                }
            </div>
        </AppCardBody>

        <div class="p-2 border-t border-slate-100 shrink-0 bg-slate-50/50 rounded-b-2xl">
            <div class="group flex items-center justify-between py-1.5 px-2 rounded-md cursor-pointer transition-colors
                        @(VaultsState.Value.IsArchiveSelected ? "bg-sky-50 text-sky-700 font-medium" : "text-slate-600 hover:bg-slate-100")"
                 @onclick="SelectArchive">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-box-archive text-amber-500 ml-1"></i>
                    <span class="text-sm">Archive</span>
                </div>
            </div>
        </div>
    </AppCard>
</div>

