@namespace PassKee.Web.Pages.App.Desktop
@using PassKee.Web.Pages.App.Shared
@using PassKee.Web.Pages.App.Desktop.Parts
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits VaultOperationsComponentBase

<AppCard Class="h-full flex flex-col shadow-xs min-h-0">
    <AppCardHeader Class="py-4 px-6 flex items-center justify-between border-b border-slate-100 bg-white gap-3 shrink-0">
        <div class="flex items-center gap-3 min-w-0">
            @if (VaultsState.Value.IsLoading || (VaultsState.Value.IsArchiveSelected && VaultsState.Value.IsArchiveLoading))
            {
                <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0">
                    <AppSpinner
                        Color="@ComponentColor.Primary"
                        Size="@ComponentSize.Small" />
                </div>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold text-slate-900 truncate">
                        @ActiveDirectoryName
                    </h2>
                    <p class="text-sm text-slate-400">
                        @(VaultsState.Value.IsArchiveSelected ? "Loading archive..." : "Loading items...")
                    </p>
                </div>
            }
            else if (IsSearchActive)
            {
                <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h2 class="text-lg font-bold text-slate-900 truncate">
                            Search Results
                        </h2>
                        <button type="button"
                                @onclick="ClearSearch"
                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 transition shrink-0"
                                title="Clear search">
                            <i class="fa-solid fa-xmark text-[10px]"></i>
                            <span>Clear</span>
                        </button>
                    </div>
                    <div class="flex items-center gap-1.5 flex-wrap mt-0.5 text-xs text-slate-500">
                        <span>Results for "@SearchQuery":</span>
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-blue-50 text-blue-700 font-semibold text-xs">
                            <i class="fa-solid fa-shield-halved text-[10px]"></i>
                            @FilteredCredentials.Count @(FilteredCredentials.Count == 1 ? "item" : "items")
                        </span>
                        @if (!VaultsState.Value.IsArchiveSelected)
                        {
                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md @(FilteredDirectories.Any() ? "bg-amber-50 text-amber-700 font-semibold" : "bg-slate-100 text-slate-500") text-xs">
                                <i class="fa-solid fa-folder text-[10px]"></i>
                                @FilteredDirectories.Count @(FilteredDirectories.Count == 1 ? "folder" : "folders")
                            </span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="h-10 w-10 rounded-xl @(VaultsState.Value.IsArchiveSelected ? "bg-amber-50 text-amber-600" : "bg-blue-50 text-blue-600") flex items-center justify-center text-lg shrink-0">
                    <i class="@(VaultsState.Value.IsArchiveSelected ? "fa-solid fa-box-archive" : VaultsState.Value.SelectedDirectoryId.HasValue ? "fa-solid fa-folder-open" : "fa-solid fa-folder-minus")"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h2 class="text-lg font-bold text-slate-900 truncate">
                            @ActiveDirectoryName
                        </h2>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-slate-500 truncate">
                        @if (!string.IsNullOrEmpty(ActiveDirectoryPath) && ActiveDirectoryPath.Contains('/'))
                        {
                            <span class="text-slate-400 font-normal truncate max-w-md" title="@ActiveDirectoryPath">
                                @ActiveDirectoryPath
                            </span>
                            <span class="text-slate-300">•</span>
                        }
                        <span>@FilteredCredentials.Count @(FilteredCredentials.Count == 1 ? "item" : "items")</span>
                        @if (VaultsState.Value.IsArchiveSelected && HasArchivedSelection)
                        {
                            <span class="text-slate-300">•</span>
                            <span class="text-blue-600 font-semibold">@_selectedArchivedCredentialIds.Count selected</span>
                        }
                    </div>
                </div>
            }
        </div>
        @if (!VaultsState.Value.IsArchiveSelected)
        {
            <AppButton
                Color="@ComponentColor.Primary"
                Variant="@ButtonVariant.Solid"
                Size="@ComponentSize.Medium"
                OnClick="@(() => OpenCredentialModalAsync(null, startInEditMode: true))"
                Disabled="@VaultsState.Value.IsLoading"
                Class="shrink-0 font-semibold">
                <i class="fa-solid fa-plus mr-1.5"></i>
                <span>New Item</span>
            </AppButton>
        }
        else if (HasArchivedSelection)
        {
            <div class="flex items-center gap-2 shrink-0">
                <AppButton
                    Color="@ComponentColor.Default"
                    Variant="@ButtonVariant.Light"
                    Size="@ComponentSize.Small"
                    OnClick="@ClearArchivedSelection"
                    Class="text-xs text-slate-600 hover:text-slate-900">
                    <span>Clear</span>
                </AppButton>
                <AppButton
                    Color="@ComponentColor.Danger"
                    Variant="@ButtonVariant.Solid"
                    Size="@ComponentSize.Medium"
                    OnClick="@DeleteSelectedArchivedCredentialsAsync"
                    Disabled="@_isDeletingArchived"
                    Class="shrink-0 font-semibold">
                    <i class="fa-solid fa-trash mr-1.5"></i>
                    <span>Delete Selected (@_selectedArchivedCredentialIds.Count)</span>
                </AppButton>
            </div>
        }
        else if (FilteredCredentials.Any())
        {
            <div class="flex items-center gap-2 shrink-0">
                <AppButton
                    Color="@ComponentColor.Default"
                    Variant="@ButtonVariant.Light"
                    Size="@ComponentSize.Small"
                    OnClick="@(() => ToggleSelectAllArchived(true))"
                    Class="text-xs font-medium text-slate-700">
                    <i class="fa-regular fa-square-check mr-1.5"></i>
                    <span>Select All</span>
                </AppButton>
            </div>
        }
    </AppCardHeader>

    <AppCardBody Class="p-0 flex-1 overflow-y-auto min-h-0">
        @if (VaultsState.Value.IsLoading || (VaultsState.Value.IsArchiveSelected && VaultsState.Value.IsArchiveLoading))
        {
            <div class="p-20 flex flex-col items-center justify-center text-center">
                <AppSpinner
                    Color="@ComponentColor.Primary"
                    Size="@ComponentSize.Large" />
                <h3 class="text-sm font-semibold text-slate-900 mt-4">@(VaultsState.Value.IsArchiveSelected ? "Loading archive..." : "Loading vault data...")</h3>
                <p class="text-sm text-slate-500 mt-1">Decrypting items</p>
            </div>
        }
        else
        {
            @if (IsSearchActive && !VaultsState.Value.IsArchiveSelected && FilteredDirectories.Any())
            {
                <SearchMatchingFoldersBlock
                    Directories="@FilteredDirectories"
                    DirectoryPaths="@Hierarchy.DirectoryPaths"
                    OnSelectDirectory="@SelectDirectoryFromSearch"
                    GetItemCount="@(id => Hierarchy.GetDirectItemCount(id))" />
            }

            @if (!FilteredCredentials.Any())
            {
                @if (VaultsState.Value.IsArchiveSelected)
                {
                    <div class="p-20 flex flex-col items-center justify-center text-center">
                        <div class="h-12 w-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl mb-4">
                            <i class="fa-solid fa-box-archive"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-slate-900">Archive is empty</h3>
                        <p class="text-sm text-slate-500 mt-1">Archived entries will appear here.</p>
                    </div>
                }
                else
                {
                    <CredentialEmptyStateBlock
                        IsSearchActive="@IsSearchActive"
                        SearchQuery="@SearchQuery"
                        HasMatchingDirectories="@FilteredDirectories.Any()"
                        OnClearSearch="@ClearSearch" />
                }
            }
            else
            {
                <AppDraggableListBlock
                    TItem="DecryptedCredential"
                    Items="@FilteredCredentials"
                    ItemKey="@(cred => cred.Id)"
                    IsDragEnabled="@IsReorderEnabled"
                    OnItemsReordered="@HandleCredentialsReordered"
                    ItemSize="72f"
                    OverscanCount="12">
                    <ItemTemplate Context="cred">
                        <DesktopCredentialItemBlock
                            Credential="@cred"
                            DirectoryPath="@Hierarchy.GetDirectoryPath(cred.DirectoryId)"
                            ShowDirectoryPath="@(IsSearchActive && !VaultsState.Value.IsArchiveSelected)"
                            IsSelectable="@VaultsState.Value.IsArchiveSelected"
                            IsSelected="@_selectedArchivedCredentialIds.Contains(cred.Id)"
                            HasActiveSelection="@HasArchivedSelection"
                            OnSelectionChanged="@((selected) => ToggleArchivedCredential(cred.Id, selected))"
                            OnSelectDirectory="@SelectDirectoryFromSearch"
                            OnView="@OpenViewCredentialModalAsync"
                            OnEdit="@OpenEditCredentialModalAsync"
                            OnMove="@OpenMoveCredentialModalAsync"
                            OnDuplicate="@DuplicateCredentialAsync"
                            OnShare="@OpenShareCredentialModalAsync"
                            OnArchive="@ArchiveCredentialAsync"
                            OnDelete="@DeleteSingleArchivedItemAsync" />
                    </ItemTemplate>
                    <Placeholder>
                        <div class="px-6 py-3.5 flex items-center justify-between gap-4 h-[72px] animate-pulse">
                            <div class="flex items-center gap-4 flex-1">
                                <div class="h-10 w-10 rounded-xl bg-slate-100"></div>
                                <div class="flex-1 space-y-2">
                                    <div class="h-4 bg-slate-100 rounded w-1/3"></div>
                                    <div class="h-3 bg-slate-100 rounded w-1/4"></div>
                                </div>
                            </div>
                        </div>
                    </Placeholder>
                </AppDraggableListBlock>
            }
        }
    </AppCardBody>
</AppCard>

