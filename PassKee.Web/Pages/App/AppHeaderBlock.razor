@namespace PassKee.Web.Pages.App
@using PassKee.Web.Components
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits BaseReactiveComponent

<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-[1400px] items-center justify-between px-3 sm:px-6 lg:px-8 py-2.5 sm:py-3">
        <div class="flex items-center gap-2.5 sm:gap-6">
            @if (VaultsState.Value.Vaults.Any())
            {
                <button type="button"
                        class="lg:hidden inline-flex items-center justify-center h-9 w-9 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 active:scale-95 transition"
                        @onclick="OnToggleMobileDrawer"
                        aria-label="Toggle Vaults and Directories">
                    <i class="fa-solid fa-bars-staggered text-base"></i>
                </button>
            }
            <a href="/app" class="flex items-center gap-2 sm:gap-2.5 font-bold text-lg sm:text-xl text-blue-600">
                <i class="fa-solid fa-shield-halved text-xl sm:text-2xl text-blue-600"></i>
                <span class="tracking-tight text-slate-900 font-extrabold">Pass<span class="text-blue-600">Kee</span></span>
            </a>
            <nav class="hidden sm:flex items-center gap-1">
                <a href="/app" class="px-3 py-1.5 rounded-lg text-sm font-semibold bg-blue-50 text-blue-600">
                    <i class="fa-solid fa-vault mr-1.5"></i> Vault
                </a>
            </nav>
        </div>
        @if (VaultsState.Value.ActiveVaultId.HasValue && VaultsState.Value.Vaults.Any())
        {
            <div class="flex-1 max-w-md mx-2 sm:mx-6 min-w-0">
                <div class="relative flex items-center w-full">
                    <div class="absolute left-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-xs sm:text-sm"></i>
                    </div>
                    <input type="text"
                           value="@_localSearchQuery"
                           @oninput="HandleSearchInput"
                           @onkeydown="HandleSearchKeyDown"
                           disabled="@VaultsState.Value.IsLoading"
                           placeholder="Search all items..."
                           aria-label="Search all items"
                           class="w-full bg-slate-100 hover:bg-slate-100/90 focus:bg-white border border-transparent focus:border-blue-500 rounded-xl pl-9 pr-8 py-1.5 sm:py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-3 focus:ring-blue-500/15 disabled:opacity-50 transition" />

                    @if (!string.IsNullOrEmpty(_localSearchQuery))
                    {
                        <button type="button"
                                @onclick="ClearSearch"
                                class="absolute right-2.5 h-5 w-5 rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-200/80 flex items-center justify-center transition text-xs"
                                title="Clear search">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </div>
            </div>
        }
        <div class="flex items-center gap-2 sm:gap-3">
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Outlined"
                       Radius="@ButtonRadius.Medium"
                       Size="@ComponentSize.Small"
                       OnClick="@LockVaultAsync">
                <i class="fa-solid fa-lock mr-1.5"></i> Lock
            </AppButton>
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Outlined"
                       Radius="@ButtonRadius.Medium"
                       Size="@ComponentSize.Small"
                       OnClick="@LogoutAsync">
                <i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i> Logout
            </AppButton>
        </div>
    </div>
</header>
