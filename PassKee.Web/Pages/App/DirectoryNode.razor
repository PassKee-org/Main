@using PassKee.Web.Models.Vaults
@using PassKee.Web.Core.Ui.Shared.Components

<div class="flex flex-col @(IsDragged ? "opacity-50" : "")">
    <div class="group flex items-center justify-between py-1.5 px-2 rounded-md cursor-pointer transition-colors
                @(Directory.Id == SelectedDirectoryId ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-slate-100")
                @(IsDragTarget ? "ring-2 ring-blue-500 bg-blue-50" : "")"
         draggable="true"
         @ondragstart="HandleDragStart"
         @ondragend="HandleDragEnd"
         @ondragover="HandleDragOver"
         @ondragover:preventDefault="true"
         @ondragleave="HandleDragLeave"
         @ondrop="HandleDrop"
         @ondrop:preventDefault="true">
        
        <div class="flex items-center gap-2 overflow-hidden flex-1" @onclick="HandleSelect">
            @if (HasChildren)
            {
                <i class="fa-solid fa-chevron-right text-[10px] w-3 text-center transition-transform @(IsExpanded ? "rotate-90" : "") text-slate-400" 
                   @onclick="ToggleExpand" @onclick:stopPropagation="true"></i>
            }
            else
            {
                <span class="w-3"></span>
            }
            <i class="fa-regular @(IsExpanded && HasChildren ? "fa-folder-open text-blue-500" : "fa-folder text-slate-400 group-hover:text-slate-500")"></i>
            <span class="text-sm truncate select-none">@Directory.Name</span>
        </div>
        
        <div class="opacity-100 sm:opacity-0 sm:group-hover:opacity-100 flex items-center gap-1 transition-opacity">
            <button type="button" class="p-1.5 sm:p-1 text-slate-400 hover:text-blue-600 rounded touch-manipulation" title="Add Subdirectory" @onclick="() => OnAddSubdirectory.InvokeAsync(Directory)" @onclick:stopPropagation="true">
                <i class="fa-solid fa-plus text-xs sm:text-[10px]"></i>
            </button>
            <button type="button" class="p-1.5 sm:p-1 text-slate-400 hover:text-blue-600 rounded touch-manipulation" title="Edit" @onclick="() => OnEdit.InvokeAsync(Directory)" @onclick:stopPropagation="true">
                <i class="fa-solid fa-pen text-xs sm:text-[10px]"></i>
            </button>
            <button type="button" class="p-1.5 sm:p-1 text-slate-400 hover:text-rose-600 rounded touch-manipulation" title="Delete" @onclick="() => OnDelete.InvokeAsync(Directory)" @onclick:stopPropagation="true">
                <i class="fa-solid fa-trash text-xs sm:text-[10px]"></i>
            </button>
        </div>
    </div>

    @if (IsExpanded && HasChildren)
    {
        <div class="ml-4 pl-1 border-l border-slate-200 flex flex-col gap-0.5 mt-0.5">
            @foreach (var child in Children)
            {
                <DirectoryNode Directory="child" 
                               ChildrenMap="ChildrenMap" 
                               DirectoryMap="DirectoryMap"
                               SelectedDirectoryId="SelectedDirectoryId"
                               ExpandedAncestorIds="ExpandedAncestorIds"
                               OnSelect="OnSelect"
                               OnAddSubdirectory="OnAddSubdirectory"
                               OnMove="OnMove"
                               OnEdit="OnEdit"
                               OnDelete="OnDelete" />
            }
        </div>
    }
</div>
