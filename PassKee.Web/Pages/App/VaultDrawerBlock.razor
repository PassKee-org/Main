@namespace PassKee.Web.Pages.App
@using PassKee.Web.Models.Vaults

@if (IsOpen)
{
    <div class="lg:hidden fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-xs transition-opacity duration-200"
         @onclick="OnClose">
    </div>
    <aside class="lg:hidden fixed inset-y-0 left-0 z-50 w-80 max-w-[85vw] bg-white shadow-2xl flex flex-col p-4 transition-transform duration-200 ease-out animate-in slide-in-from-left">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
            <div class="flex items-center gap-2 text-slate-900 font-bold text-base">
                <i class="fa-solid fa-folder-tree text-blue-600"></i>
                <span>Vault & Directories</span>
            </div>
            <button type="button"
                    @onclick="OnClose"
                    class="h-8 w-8 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 flex items-center justify-center transition">
                <i class="fa-solid fa-xmark text-base"></i>
            </button>
        </div>

        <div class="flex-1 flex flex-col gap-4 overflow-y-auto min-h-0">
            <VaultSidebarBlock ActiveVaultId="@ActiveVaultId"
                               Vaults="@Vaults"
                               Directories="@Directories"
                               SelectedDirectoryId="@SelectedDirectoryId"
                               IsCreatingVault="@IsCreatingVault"
                               IsVaultsLoading="@IsVaultsLoading"
                               OnSelectVault="@OnSelectVault"
                               OnCreateVault="@OnCreateVault"
                               OnSelectDirectory="@OnSelectDirectory"
                               OnOpenDirectoryModal="@OnOpenDirectoryModal"
                               OnDeleteDirectory="@OnDeleteDirectory"
                               OnMoveDirectory="@OnMoveDirectory" />
        </div>
    </aside>
}
