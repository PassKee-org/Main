@namespace PassKee.Web.Pages.App.Shared
@using PassKee.Web.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@inherits VaultOperationsComponentBase

<section class="mx-auto flex min-h-[65dvh] w-full max-w-5xl items-center px-4 py-8 sm:py-12 sm:px-6">
    <div class="grid w-full items-center gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:gap-16">
        <div class="max-w-2xl text-center md:text-left">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700">Your private space</p>
            <h1 class="mt-3 sm:mt-4 text-2xl sm:text-4xl font-bold leading-tight text-slate-950">Start with your first vault.</h1>
            <p class="mt-3 sm:mt-4 max-w-xl mx-auto md:mx-0 text-sm sm:text-base leading-6 sm:leading-7 text-slate-600">
                Create a vault to organize passwords, secure notes, and cards. Its contents are encrypted on this device before they are stored.
            </p>
            <AppButton
                Color="@ComponentColor.Primary"
                Variant="@ButtonVariant.Solid"
                OnClick="@OpenCreateVaultModalAsync"
                IsLoading="@VaultsState.Value.IsCreating"
                Disabled="@VaultsState.Value.IsCreating"
                Class="mt-6 sm:mt-7">
                <i class="fa-solid fa-plus mr-2" aria-hidden="true"></i>
                Add Vault
            </AppButton>
        </div>
        <div class="mx-auto flex h-28 w-28 sm:h-44 sm:w-44 items-center justify-center rounded-2xl border border-blue-100 bg-white text-blue-700 shadow-sm" aria-hidden="true">
            <i class="fa-solid fa-vault text-5xl sm:text-6xl"></i>
        </div>
    </div>
</section>

