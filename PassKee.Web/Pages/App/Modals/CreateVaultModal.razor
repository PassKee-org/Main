@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components

<div class="p-6">
    <h3 class="text-lg font-bold text-slate-900 mb-4">New Vault</h3>

    <div class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Vault Name</label>
            <AppInputText @bind-Value="Name" Placeholder="E.g., Personal, Work, Finance" Class="w-full" />
        </div>
    </div>

    <div class="mt-8 flex justify-end gap-3">
        <AppButton Color="@ComponentColor.Default" Variant="@ButtonVariant.Light" OnClick="@Cancel">
            Cancel
        </AppButton>
        <AppButton Color="@ComponentColor.Primary" Variant="@ButtonVariant.Solid" OnClick="@Save">
            Create
        </AppButton>
    </div>
</div>
