@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components

<div class="p-5 sm:p-6">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
        <h3 class="text-lg font-bold text-slate-900">@(IsEdit ? "Edit Directory" : "New Directory")</h3>
        <button type="button" @onclick="Cancel" class="h-8 w-8 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 flex items-center justify-center transition">
            <i class="fa-solid fa-xmark text-base"></i>
        </button>
    </div>

    <div class="space-y-4">
        @if (!IsEdit && !string.IsNullOrEmpty(ParentDirectoryName))
        {
            <div class="flex items-center gap-2 rounded-lg bg-slate-50 border border-slate-200/80 px-3 py-2 text-xs text-slate-600">
                <i class="fa-regular fa-folder text-blue-500"></i>
                <span>Inside: <strong class="text-slate-800">@ParentDirectoryName</strong></span>
            </div>
        }
        <div>
            <AppInputText Label="Directory Name" @bind-Value="Name" Placeholder="E.g., Work, Personal" Class="w-full" Required="true" />
        </div>
    </div>

    <div class="mt-6 sm:mt-8 flex justify-end gap-2.5 sm:gap-3">
        <AppButton Color="@ComponentColor.Default" Variant="@ButtonVariant.Light" OnClick="@Cancel">
            Cancel
        </AppButton>
        <AppButton Color="@ComponentColor.Primary" Variant="@ButtonVariant.Solid" OnClick="@Save">
            Save
        </AppButton>
    </div>
</div>
