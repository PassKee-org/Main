@using PassKee.Api.Shared.Models.Vaults.Enums
@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components

<div class="p-0">
    <div class="bg-slate-900 text-white p-6 rounded-t-2xl flex items-center justify-between">
        <h3 class="text-xl font-bold">@(IsEdit ? "Edit Item" : "New Item")</h3>
    </div>
    
    <div class="p-6 space-y-6 max-h-[70vh] overflow-y-auto">
        @if (!IsEdit)
        {
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Item Type</label>
                <select class="block w-full rounded-md border-0 py-2 pl-3 pr-10 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-blue-600 sm:text-sm sm:leading-6" @bind="Type">
                    <option value="@CredentialType.Login">Login</option>
                    <option value="@CredentialType.Password">Password</option>
                    <option value="@CredentialType.Card">Card</option>
                    <option value="@CredentialType.SecureNote">Secure Note</option>
                </select>
            </div>
        }

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Title</label>
            <AppInputText @bind-Value="Title" Placeholder="e.g. Google, Amazon" Class="w-full bg-white" />
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
            @if (Type == CredentialType.Login || Type == CredentialType.Password)
            {
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Username / Email</label>
                    <AppInputText @bind-Value="Username" Class="w-full bg-white" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Password</label>
                    <AppInputText @bind-Value="Password" Type="password" Class="w-full bg-white" />
                </div>
            }

            @if (Type == CredentialType.Login)
            {
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Website</label>
                    <AppInputText @bind-Value="Website" Placeholder="https://" Class="w-full bg-white" />
                </div>
            }

            @if (Type == CredentialType.Card)
            {
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Card Number</label>
                    <AppInputText @bind-Value="CardNumber" Class="w-full bg-white" />
                </div>
                <div class="flex gap-4">
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Expires</label>
                        <AppInputText @bind-Value="ExpirationDate" Placeholder="MM/YY" Class="w-full bg-white" />
                    </div>
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">CVV</label>
                        <AppInputText @bind-Value="Cvv" Class="w-full bg-white" />
                    </div>
                </div>
            }
        </div>
        
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Notes</label>
            <textarea class="block w-full rounded-md border-0 py-2 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-blue-600 sm:text-sm sm:leading-6 bg-white" rows="3" @bind="Notes"></textarea>
        </div>
    </div>

    <div class="px-6 py-4 border-t border-slate-100 flex justify-end gap-3 bg-slate-50 rounded-b-2xl">
        <AppButton Color="@ComponentColor.Default" Variant="@ButtonVariant.Light" OnClick="@Cancel">
            Cancel
        </AppButton>
        <AppButton Color="@ComponentColor.Primary" Variant="@ButtonVariant.Solid" OnClick="@Save">
            Save
        </AppButton>
    </div>
</div>
