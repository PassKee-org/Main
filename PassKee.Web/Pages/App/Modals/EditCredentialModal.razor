@using PassKee.Business.Common.Constants
@using PassKee.Web.Core.Services.UI.Modal
@using PassKee.Web.Core.Ui.Shared.Components

<div class="p-0">
    <div class="bg-slate-900 text-white p-4 sm:p-6 rounded-t-2xl flex items-center justify-between">
        <h3 class="text-lg sm:text-xl font-bold">@(IsEdit ? "Edit Item" : "New Item")</h3>
        <button type="button" @onclick="Cancel" class="h-8 w-8 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 flex items-center justify-center transition">
            <i class="fa-solid fa-xmark text-base"></i>
        </button>
    </div>
    
    <div class="p-4 sm:p-6 space-y-4 sm:space-y-5 max-h-[75vh] overflow-y-auto">
        @if (!IsEdit)
        {
            <div class="bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200">
                <EnumSelect TItem="CredentialType"
                            Value="@Type"
                            ValueChanged="@OnTypeChanged"
                            ItemIcon="@GetCredentialTypeIcon"
                            Label="Item Type"
                            IsFullWidth="true" />
            </div>
        }

        <div class="bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200">
            <AppInputText Label="Title" @bind-Value="Title" Placeholder="e.g. Google, Amazon" Class="w-full" Required="true" />
        </div>

        <div class="bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200 space-y-3.5">
            @if (Type == CredentialType.Login || Type == CredentialType.Password)
            {
                <div>
                    <AppInputText Label="Username / Email" @bind-Value="Username" Placeholder="username or email" Class="w-full" />
                </div>
                <div>
                    <AppInputText Label="Password" @bind-Value="Password" Type="password" Placeholder="Password" Class="w-full" />
                </div>
            }

            @if (Type == CredentialType.Login)
            {
                <div>
                    <AppInputText Label="Website" @bind-Value="Website" Placeholder="https://" Class="w-full" />
                </div>
            }

            @if (Type == CredentialType.Card)
            {
                <div>
                    <AppInputText Label="Card Number" @bind-Value="CardNumber" Placeholder="4532 •••• •••• ••••" Class="w-full" />
                </div>
                <div class="grid grid-cols-2 gap-3 sm:gap-4">
                    <div>
                        <AppInputText Label="Expires" @bind-Value="ExpirationDate" Placeholder="MM/YY" Class="w-full" />
                    </div>
                    <div>
                        <AppInputText Label="CVV" @bind-Value="Cvv" Placeholder="CVC" Class="w-full" />
                    </div>
                </div>
            }
        </div>
        
        <div class="bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200">
            <InputTextareaField Label="Notes"
                                @bind-Value="Notes"
                                Placeholder="Additional notes or security information..."
                                Rows="3"
                                IsFullWidth="true" />
        </div>
    </div>

    <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-t border-slate-100 flex justify-end gap-2.5 sm:gap-3 bg-slate-50 rounded-b-2xl">
        <AppButton Color="@ComponentColor.Default" Variant="@ButtonVariant.Light" OnClick="@Cancel">
            Cancel
        </AppButton>
        <AppButton Color="@ComponentColor.Primary" Variant="@ButtonVariant.Solid" OnClick="@Save">
            Save
        </AppButton>
    </div>
</div>
