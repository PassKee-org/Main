@namespace PassKee.Web.Pages.App.Parts
@using PassKee.Business.Common.Constants
@using PassKee.Api.Shared.Models.Vaults.Payloads
@using PassKee.Web.Models.Vaults
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums

<div class="px-3.5 sm:px-6 py-3 sm:py-4 flex items-center justify-between hover:bg-slate-50/80 transition group gap-2 sm:gap-4">
    <div class="flex items-center gap-3 sm:gap-4 cursor-pointer flex-1 min-w-0"
         @onclick="HandleRowClick">
        <div class="h-10 w-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center text-base shrink-0 font-bold group-hover:bg-blue-50 group-hover:text-blue-600 transition">
            <i class="@GetCredentialTypeIcon(Credential.Type)"></i>
        </div>
        <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap min-w-0">
                <span class="font-medium text-sm sm:text-base text-slate-900 truncate">@Credential.Payload.Title</span>
                @if (ShowDirectoryPath && !string.IsNullOrWhiteSpace(DirectoryPath))
                {
                    <button type="button"
                            class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 px-2 py-0.5 rounded-md transition shrink-0 max-w-[200px] truncate"
                            title="@($"Folder: {DirectoryPath}")"
                            @onclick:stopPropagation="true"
                            @onclick="HandleDirectoryClick">
                        <i class="fa-regular fa-folder text-slate-400 text-[10px]"></i>
                        <span class="truncate">@DirectoryPath</span>
                    </button>
                }
            </div>
            @if (Credential.Payload is LoginCredentialPayload login)
            {
                <div class="text-xs text-slate-500 truncate flex items-center gap-1.5 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(login.Username))
                    {
                        <span class="truncate">@login.Username</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(login.Website))
                    {
                        @if (!string.IsNullOrWhiteSpace(login.Username))
                        {
                            <span class="text-slate-300">•</span>
                        }
                        <span class="truncate text-slate-400">@login.Website</span>
                    }
                </div>
            }
            else if (Credential.Payload is FileCredentialPayload { File.FileName: { Length: > 0 } fileName })
            {
                <div class="text-xs text-slate-500 truncate">@fileName</div>
            }
            @if (CredentialTags.Any())
            {
                <div class="mt-1">
                    <TagsBadgesList Tags="@CredentialTags" />
                </div>
            }
        </div>
    </div>
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
        <AppBadge Variant="@BadgeVariant.Flat"
                  Color="@ComponentColor.Primary"
                  Size="@ComponentSize.Small">
            @GetCredentialTypeLabel(Credential.Type)
        </AppBadge>
        <div class="flex items-center gap-0.5 sm:gap-1 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity ml-1 sm:ml-2">
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       OnClick="() => OnEdit.InvokeAsync(Credential)"
                       Title="Edit"
                       Class="h-8 w-8 min-w-8 p-0">
                <i class="fa-solid fa-pen text-xs text-slate-500"></i>
            </AppButton>
            <AppButton Color="@ComponentColor.Danger"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       OnClick="() => OnDelete.InvokeAsync(Credential)"
                       Title="Delete"
                       Class="h-8 w-8 min-w-8 p-0">
                <i class="fa-solid fa-trash text-xs"></i>
            </AppButton>
        </div>
    </div>
</div>
