@namespace PassKee.Web.Pages.App.Parts
@using PassKee.Web.Models.Vaults

<div class="p-3.5 sm:p-4 bg-slate-50/80 border-b border-slate-100">
    <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
            <i class="fa-solid fa-folder-tree text-blue-500"></i>
            Matching Folders (@Directories.Count)
        </span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        @foreach (var dir in Directories)
        {
            var dirPath = GetDirectoryPath(dir.Id);
            var count = GetItemCount(dir.Id);
            <button type="button"
                    @onclick="() => OnSelectDirectory.InvokeAsync(dir.Id)"
                    class="flex items-center justify-between p-2.5 rounded-xl bg-white border border-slate-200/90 hover:border-blue-400 hover:bg-blue-50/40 shadow-2xs hover:shadow-xs transition text-left group">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 text-sm group-hover:bg-blue-100 transition">
                        <i class="fa-regular fa-folder-open"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold text-slate-800 truncate group-hover:text-blue-600 transition">
                            @dir.Name
                        </div>
                        @if (!string.IsNullOrWhiteSpace(dirPath) && dirPath != dir.Name)
                        {
                            <div class="text-[11px] text-slate-400 truncate">
                                @dirPath
                            </div>
                        }
                    </div>
                </div>
                <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full shrink-0 ml-2 group-hover:bg-blue-100 group-hover:text-blue-700 transition">
                    @count @(count == 1 ? "item" : "items")
                </span>
            </button>
        }
    </div>
</div>
