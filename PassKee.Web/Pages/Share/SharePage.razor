@page "/share/{Token}"
@page "/shared/{Token}"
@layout Layout.LandingLayout
@namespace PassKee.Web.Pages.Share
@using PassKee.Business.Common.Constants
@using PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Ui.Shared.Components.Enums
@using PassKee.Web.Core.Utils
@using PassKee.Web.Shared.Modals.Parts

<div class="min-h-[calc(100vh-12rem)] flex flex-col justify-center py-8 sm:py-12 px-3 sm:px-6 lg:px-8">
    @if (IsLoading)
    {
        <div class="max-w-md mx-auto w-full p-8 bg-white rounded-2xl shadow-xs border border-slate-200/80 text-center flex flex-col items-center justify-center">
            <AppSpinner Color="@ComponentColor.Primary" Size="@ComponentSize.Large" />
            <h3 class="text-base font-semibold text-slate-900 mt-4">Расшифровка элемента...</h3>
            <p class="text-xs text-slate-500 mt-1">Ключ дешифрования извлекается из ссылки</p>
        </div>
    }
    else if (HasError || DecryptedPayload == null)
    {
        <div class="max-w-lg mx-auto w-full p-6 sm:p-8 bg-white rounded-2xl shadow-xs border border-slate-200/80 text-center">
            <div class="h-14 w-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl mx-auto mb-4">
                <i class="fa-solid fa-link-slash"></i>
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">Ссылка недоступна</h2>
            <p class="text-sm text-slate-500 leading-relaxed mb-6">@ErrorMessage</p>
            <a href="/"
               class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl bg-blue-600 hover:bg-blue-700 text-white transition shadow-xs">
                <i class="fa-solid fa-arrow-left text-xs"></i>
                <span>Перейти в PassKee</span>
            </a>
        </div>
    }
    else
    {
        <div class="max-w-2xl w-full mx-auto space-y-4">
            @* Item Header Card *@
            <AppCard Class="shadow-xs border border-slate-200/80 p-5 sm:p-6">
                <div class="flex items-center justify-between gap-4 flex-wrap">
                    <div class="flex items-center gap-3.5 min-w-0">
                        <div class="h-12 w-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0 font-bold">
                            @if (!string.IsNullOrWhiteSpace(DecryptedPayload.Icon))
                            {
                                <span class="text-2xl leading-none select-none">@EmojiHelper.FormatEmoji(DecryptedPayload.Icon)</span>
                            }
                            else
                            {
                                <i class="@GetCredentialTypeIcon(CredentialType)"></i>
                            }
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-lg sm:text-xl font-bold text-slate-900 truncate">
                                @(string.IsNullOrWhiteSpace(DecryptedPayload.Title) ? "Untitled" : DecryptedPayload.Title)
                            </h2>
                            <p class="text-xs text-slate-400 mt-0.5">
                                @GetCredentialTypeLabel(CredentialType)
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <AppBadge Variant="@BadgeVariant.Flat"
                                  Color="@ComponentColor.Primary"
                                  Size="@ComponentSize.Medium">
                            @GetCredentialTypeLabel(CredentialType)
                        </AppBadge>
                    </div>
                </div>

                @if (ExpiresAt.HasValue)
                {
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2 text-xs text-slate-500">
                        <i class="fa-regular fa-clock text-slate-400"></i>
                        <span>Ссылка действительна до: <strong class="text-slate-700">@ExpiresAt.Value.ToLocalTime().ToString("g")</strong></span>
                    </div>
                }
            </AppCard>

            @* Credential Details Card (using existing view mode components) *@
            <CredentialViewDetailsBlock Type="@CredentialType"
                                        Payload="@DecryptedPayload"
                                        ShowFiles="false" />

            @* Zero-Knowledge Callout *@
            <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-200/60 flex items-start gap-3 text-xs text-blue-900">
                <i class="fa-solid fa-shield-halved text-blue-600 text-base mt-0.5 shrink-0"></i>
                <div class="space-y-1">
                    <p class="font-semibold text-blue-950">Сквозное шифрование (Zero-Knowledge)</p>
                    <p class="text-blue-800 leading-relaxed">
                        Этот элемент был расшифрован прямо в вашем браузере. Ключ дешифрования находился в ссылке после символа <code class="bg-blue-100 px-1 py-0.5 rounded text-blue-900 font-mono font-bold">#</code> и никогда не отправлялся на сервер.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

