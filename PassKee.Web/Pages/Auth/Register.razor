@page "/auth/register"

<h3>Register for PassKee</h3>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (ShowSecretKey)
{
    <div class="alert alert-success">
        <h4>Registration Successful!</h4>
        <p>This is your Secret Key. <strong>Save it now!</strong> You will need it to log in.</p>
        <code>@SecretKeyBase64</code>
        <br/><br/>
        <button class="btn btn-primary" @onclick="GoToLogin">Go to Login</button>
    </div>
}
else
{
    <div class="form-group mb-3">
        <label>Email</label>
        <input type="email" class="form-control" @bind="Email" />
    </div>

    <div class="form-group mb-3">
        <label>Master Password</label>
        <input type="password" class="form-control" @bind="Password" />
    </div>

    <button class="btn btn-primary" @onclick="RegisterAsync" disabled="@IsProcessing">
        @if (IsProcessing)
        {
            <span>Processing... (This may take a moment)</span>
        }
        else
        {
            <span>Register</span>
        }
    </button>
}
