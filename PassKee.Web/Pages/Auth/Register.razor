@page "/registration"
@page "/auth/register"
@inherits BaseReactiveComponent
@layout PassKee.Web.Layout.LandingLayout

<div class="py-5 sm:py-10 px-3 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-5 sm:gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(360px,440px)]">
        @* Registration Form Card (First on mobile, right on desktop) *@
        <section class="order-1 lg:order-2 rounded-2xl sm:rounded-[2rem] border border-slate-200 bg-white p-5 sm:p-8 shadow-xl flex flex-col justify-between">
            <div>
                <div class="flex items-start justify-between gap-4 mb-5 sm:mb-6">
                    <div>
                        <p class="text-[11px] sm:text-xs font-semibold uppercase tracking-[0.25em] text-blue-600">GET STARTED</p>
                        <h2 class="mt-1 text-xl sm:text-2xl font-bold text-slate-900">Create PassKee Account</h2>
                    </div>
                    <div class="flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-xl sm:rounded-2xl bg-blue-600 text-white shadow-md shadow-blue-500/20 shrink-0">
                        <i class="fa-solid fa-user-plus text-base sm:text-lg"></i>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="mb-4 sm:mb-5 rounded-xl border border-rose-200 bg-rose-50 p-3.5 sm:p-4 text-xs sm:text-sm text-rose-700 flex items-start gap-2.5 sm:gap-3">
                        <i class="fa-solid fa-circle-exclamation text-rose-500 mt-0.5 shrink-0"></i>
                        <span>@ErrorMessage</span>
                    </div>
                }

                @if (ShowSecretKey)
                {
                    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 sm:p-6 space-y-3.5 sm:space-y-4">
                        <div class="flex items-center gap-2.5 text-emerald-800">
                            <i class="fa-solid fa-circle-check text-lg sm:text-xl text-emerald-600 shrink-0"></i>
                            <h3 class="font-bold text-base sm:text-lg">Save Your Emergency Secret Key</h3>
                        </div>
                        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
                            PassKee has generated your unique <strong>Emergency Secret Key</strong> on this device. You will need both your Master Password and this Secret Key to sign in.
                        </p>
                        <div class="space-y-2">
                            <div class="p-3 sm:p-3.5 bg-white rounded-xl border border-emerald-300/80 font-mono text-xs sm:text-sm text-slate-900 break-all select-all font-semibold shadow-inner">
                                @SecretKeyBase64
                            </div>
                            <AppButton
                                Color="@(IsCopied ? ComponentColor.Success : ComponentColor.Default)"
                                Variant="@ButtonVariant.Light"
                                Size="@ComponentSize.Small"
                                Class="w-full font-medium"
                                OnClick="@CopySecretKeyAsync">
                                <StartContent>
                                    <i class="@(IsCopied ? "fa-solid fa-check mr-1.5 text-emerald-600" : "fa-regular fa-copy mr-1.5")"></i>
                                </StartContent>
                                <ChildContent>@(IsCopied ? "Copied to Clipboard!" : "Copy Secret Key")</ChildContent>
                            </AppButton>
                        </div>

                        <div class="rounded-xl border border-amber-200 bg-amber-50/80 p-3 text-xs text-amber-800 flex items-start gap-2.5">
                            <i class="fa-solid fa-triangle-exclamation text-amber-600 mt-0.5 shrink-0"></i>
                            <span><strong>Keep this safe!</strong> PassKee cannot recover or reset your Secret Key. If lost, your vault cannot be unlocked on new devices.</span>
                        </div>

                        <div class="pt-1">
                            <AppCheckbox @bind-Value="HasSavedSecretKey" Color="@ComponentColor.Primary">
                                <span class="text-xs font-medium text-slate-700">
                                    I have saved my Secret Key and understand PassKee cannot recover it.
                                </span>
                            </AppCheckbox>
                        </div>

                        <AppButton
                            Color="@ComponentColor.Primary"
                            Variant="@ButtonVariant.Solid"
                            Class="w-full font-semibold py-3"
                            Disabled="@(!HasSavedSecretKey)"
                            OnClick="@GoToLogin">
                            <StartContent>
                                <i class="fa-solid fa-arrow-right-to-bracket mr-2"></i>
                            </StartContent>
                            <ChildContent>Continue to Sign In</ChildContent>
                        </AppButton>
                    </div>
                }
                else
                {
                    <form @onsubmit="RegisterAsync" class="grid gap-3.5 sm:gap-4">
                        <AppInputText
                            Label="Email Address"
                            @bind-Value="Email"
                            Type="email"
                            Icon="fa-regular fa-envelope"
                            Placeholder="you@example.com"
                            Required="true"
                            Disabled="@IsProcessing"
                            Autocomplete="username" />

                        <AppInputText
                            Label="Master Password"
                            @bind-Value="Password"
                            Type="password"
                            Icon="fa-solid fa-key"
                            Placeholder="Create a strong Master Password"
                            HelpText="A 128-bit Secret Key will be automatically created on the next step. PassKee cannot recover your password if forgotten."
                            Required="true"
                            Disabled="@IsProcessing"
                            Autocomplete="new-password" />

                        <div class="mt-2">
                            <AppButton
                                Color="@ComponentColor.Primary"
                                Variant="@ButtonVariant.Solid"
                                Class="w-full font-semibold py-3"
                                IsLoading="@IsProcessing"
                                Type="@ButtonType.Submit">
                                <StartContent>
                                    <i class="fa-solid fa-shield mr-2"></i>
                                </StartContent>
                                <ChildContent>Create Encrypted Vault</ChildContent>
                            </AppButton>
                        </div>
                    </form>
                }
            </div>

            <div class="mt-6 pt-5 sm:mt-8 sm:pt-6 border-t border-slate-100 text-center text-xs sm:text-sm text-slate-500">
                <span>Already have a PassKee account?</span>
                <a href="/login" class="ml-1.5 font-semibold text-blue-600 hover:text-blue-700 transition hover:underline">
                    Sign In
                </a>
            </div>
        </section>

        @* Left: Security Notice Card (Second on mobile, left on desktop) *@
        <section class="order-2 lg:order-1 overflow-hidden rounded-2xl sm:rounded-[2rem] bg-slate-900 text-white shadow-xl lg:shadow-2xl">
            <div class="flex h-full flex-col justify-between gap-6 sm:gap-8 p-6 sm:p-10">
                <div>
                    <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-blue-300">
                        <i class="fa-solid fa-shield-halved text-xs sm:text-sm"></i>
                        <span>End-to-End Encryption</span>
                    </div>
                    <h1 class="mt-4 sm:mt-6 max-w-xl text-2xl sm:text-4xl font-bold leading-tight text-white">
                        Create Your PassKee Vault
                    </h1>
                    <p class="mt-3 sm:mt-4 max-w-2xl text-xs sm:text-base leading-relaxed text-slate-300">
                        Your passwords and data are encrypted directly on your device. PassKee never sees or stores your Master Password or Secret Key.
                    </p>
                </div>
                <div class="space-y-3 sm:space-y-4">
                    <div class="rounded-xl sm:rounded-2xl border border-white/10 bg-white/5 p-3.5 sm:p-4 flex items-start gap-3">
                        <div class="h-8 w-8 rounded-lg bg-blue-500/20 text-blue-300 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-key text-xs sm:text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm font-semibold text-white">Two-Key Protection</p>
                            <p class="text-[11px] sm:text-xs text-slate-400 mt-0.5">Your Master Password and an auto-generated 128-bit Secret Key protect against breaches.</p>
                        </div>
                    </div>
                    <div class="rounded-xl sm:rounded-2xl border border-white/10 bg-white/5 p-3.5 sm:p-4 flex items-start gap-3">
                        <div class="h-8 w-8 rounded-lg bg-emerald-500/20 text-emerald-300 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-lock text-xs sm:text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm font-semibold text-white">Zero-Knowledge Privacy</p>
                            <p class="text-[11px] sm:text-xs text-slate-400 mt-0.5">Only you hold the encryption keys. PassKee cannot read your passwords.</p>
                        </div>
                    </div>
                    <div class="rounded-xl sm:rounded-2xl border border-white/10 bg-white/5 p-3.5 sm:p-4 flex items-start gap-3">
                        <div class="h-8 w-8 rounded-lg bg-amber-500/20 text-amber-300 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-triangle-exclamation text-xs sm:text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm font-semibold text-white">No Remote Reset</p>
                            <p class="text-[11px] sm:text-xs text-slate-400 mt-0.5">Because we don't store your keys, no one can reset your account. Keep your credentials safe.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
