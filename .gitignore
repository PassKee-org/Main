## Visual Studio / Rider / VS Code & .NET Core GitIgnore

# ==============================================================================
# Build results
# Universal rules covering all projects at root and nested subdirectories:
# - PassKee.*
# - Api.*
# - AspNetCore.*
# - Domain.*
# - Notification.*
# - Persistence.*
# - Shared/** (e.g. Shared/ThirdParty/DgNet.Keepass)
# ==============================================================================
[Bb]in/
[Oo]bj/
**/[Bb]in/
**/[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]uild/
[Pp]ublish/
**/[Pp]ublish/

# Project-specific / nested directories (explicit coverage)
PassKee.*/[Bb]in/
PassKee.*/[Oo]bj/
Api.*/[Bb]in/
Api.*/[Oo]bj/
AspNetCore.*/[Bb]in/
AspNetCore.*/[Oo]bj/
Domain.*/[Bb]in/
Domain.*/[Oo]bj/
Notification.*/[Bb]in/
Notification.*/[Oo]bj/
Persistence.*/[Bb]in/
Persistence.*/[Oo]bj/
Shared/**/[Bb]in/
Shared/**/[Oo]bj/

