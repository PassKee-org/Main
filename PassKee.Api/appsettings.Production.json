{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Error",
                "System": "Error"
            }
        }
    },
    "App": {
        "Auth": {
            "JwtLifetime": 60,
            "AccessTokenLifetime": 30,
            "CookieDomains": [ ".passkee.org" ]
        }
    },
    "Garage": {
        "BucketName": "passkee-production"
    }
}
