@using PassKee.Web.Core.Services.UI.Modal

<div
    class="app-modal-root fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 overflow-y-auto"
    tabindex="-1"
    @onkeydown="@HandleKeyDown">
    <div
        class="app-modal-backdrop fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] transition-opacity"
        @onclick="@OnBackdropClick">
    </div>

    <div
        class="app-modal-card relative w-full @_sizeClass @ModalInstance.Options.ModalClass rounded-t-3xl sm:rounded-2xl bg-white text-left shadow-2xl transition-all border border-slate-200/80 @_cardScrollClass mt-auto sm:my-auto max-h-[94dvh] sm:max-h-none"
        @onclick:stopPropagation="true">
        <div class="sm:hidden flex justify-center pt-2.5 pb-0.5 bg-white rounded-t-3xl shrink-0">
            <div class="h-1.5 w-10 rounded-full bg-slate-300/90"></div>
        </div>
        <CascadingValue
            Value="@ModalInstance"
            IsFixed="true">
            <DynamicComponent
                Type="@ModalInstance.ComponentType"
                Parameters="@ModalInstance.Parameters" />
        </CascadingValue>
    </div>
</div>
