@using PassKee.Web.Core.Services.UI.Modal

<div
    class="flex items-start justify-between gap-4 p-4 sm:p-5 border-b border-slate-100/80 shrink-0 rounded-t-2xl @Class">
    <div
        class="flex items-start gap-3.5 min-w-0 flex-1">
        @if (IconContent != null || !string.IsNullOrWhiteSpace(Icon) || !string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description))
        {
            @if (IconContent != null)
            {
                <div
                    class="shrink-0">
                    @IconContent
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Icon))
            {
                <div
                    class="shrink-0">
                    <div
                        class="flex h-10 w-10 items-center justify-center rounded-xl @ComputedIconBoxClass">
                        <i
                            class="@Icon"></i>
                    </div>
                </div>
            }
            <div
                class="min-w-0 flex-1">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h2
                        class="text-lg font-semibold text-slate-900 leading-6">
                        @Title
                    </h2>
                }
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p
                        class="mt-1 text-sm text-slate-600 leading-normal">
                        @Description
                    </p>
                }
                @ChildContent
            </div>
        }
        else
        {
            @ChildContent
        }
    </div>

    @if (IsCloseButtonVisible)
    {
        <button
            type="button"
            class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-blue-500/80 text-slate-500 transition-colors hover:border-blue-600 hover:bg-blue-50 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer"
            aria-label="Close"
            title="Close"
            @onclick="@OnCloseClick">
            <i
                class="fa-solid fa-xmark text-sm"></i>
        </button>
    }
</div>
