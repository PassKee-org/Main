@namespace PassKee.Web.Core.Ui.Shared.Components

<div
    class="@ComputedContainerClass"
    style="@Style"
    role="status"
    aria-label="@AriaLabel"
    @attributes="AdditionalAttributes">
    @if (Variant == SpinnerVariant.Ring)
    {
        <svg
            class="animate-spin @ComputedIconSizeClass shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true">
            <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="3">
            </circle>
            <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
            </path>
        </svg>
    }
    else if (Variant == SpinnerVariant.DotsFade)
    {
        <div class="inline-flex items-center gap-1 shrink-0" aria-hidden="true">
            <span class="@ComputedDotSizeClass rounded-full bg-current animate-pulse"></span>
            <span class="@ComputedDotSizeClass rounded-full bg-current animate-pulse [animation-delay:200ms]"></span>
            <span class="@ComputedDotSizeClass rounded-full bg-current animate-pulse [animation-delay:400ms]"></span>
        </div>
    }
    else if (Variant == SpinnerVariant.DotsWave)
    {
        <div class="inline-flex items-center gap-1 shrink-0" aria-hidden="true">
            <span class="@ComputedDotSizeClass rounded-full bg-current animate-bounce"></span>
            <span class="@ComputedDotSizeClass rounded-full bg-current animate-bounce [animation-delay:150ms]"></span>
            <span class="@ComputedDotSizeClass rounded-full bg-current animate-bounce [animation-delay:300ms]"></span>
        </div>
    }
    else if (Variant == SpinnerVariant.Arc)
    {
        <span
            class="inline-block @ComputedIconSizeClass rounded-full border-2 border-current border-t-transparent animate-spin shrink-0"
            aria-hidden="true">
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="@ComputedLabelClass">
            @Label
        </span>
    }
</div>
