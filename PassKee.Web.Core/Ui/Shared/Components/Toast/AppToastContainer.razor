@namespace PassKee.Web.Core.Ui.Shared.Components
@using PassKee.Web.Core.Services.UI
@using PassKee.Web.Core.Services.UI.Toast

@if (ToastService.ActiveToasts.Count > 0)
{
    <div
        class="fixed bottom-4 right-4 z-[9999] pointer-events-none flex flex-col-reverse gap-2.5 max-w-sm w-[calc(100vw-2rem)] sm:w-96"
        style="z-index: 99999;"
        role="region"
        aria-live="polite"
        aria-label="Notifications">

        @foreach (var toast in ToastService.ActiveToasts)
        {
            <AppToastItem
                @key="toast.Id"
                Toast="@toast"
                OnDismiss="@(() => ToastService.Dismiss(toast.Id))" />
        }
    </div>
}
