@namespace PassKee.Web.Core.Ui.Shared.Components.Progress

<div class="w-full @Class">
    <div class="mb-2 flex items-center justify-between gap-3 text-sm text-slate-600">
        <span class="min-w-0 break-words">@Label</span>
        @if (!Indeterminate)
        {
            <span class="w-12 shrink-0 text-right tabular-nums">@PercentText%</span>
        }
    </div>
    <div role="progressbar"
         aria-label="@(Label ?? "Progress")"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@(Indeterminate ? null : PercentText)"
         class="h-2 w-full overflow-hidden rounded bg-slate-100">
        @if (Indeterminate)
        {
            <div class="h-full w-1/3 animate-pulse bg-blue-600 motion-reduce:animate-none"></div>
        }
        else
        {
            <div class="h-full bg-blue-600 transition-[width] motion-reduce:transition-none"
                 style="width: @(PercentText)%"></div>
        }
    </div>
</div>