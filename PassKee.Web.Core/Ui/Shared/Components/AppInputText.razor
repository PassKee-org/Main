@namespace PassKee.Web.Core.Ui.Shared.Components

<div class="w-full @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@_inputId" class="block mb-1.5 text-xs font-semibold uppercase tracking-wider text-slate-700">
            @Label
            @if (Required)
            {
                <span class="text-rose-500 ms-0.5">*</span>
            }
        </label>
    }

    <div class="relative flex items-center rounded-xl border transition @BorderAndBgClasses @(Disabled ? "opacity-60 cursor-not-allowed bg-slate-100" : "")">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="flex items-center pl-3.5 pr-1 text-slate-400 shrink-0">
                <i class="@Icon text-sm"></i>
            </div>
        }

        <input
            id="@_inputId"
            type="@ResolvedType"
            style="@ResolvedStyle"
            name="@Name"
            value="@Value"
            @oninput="HandleInput"
            placeholder="@Placeholder"
            disabled="@Disabled"
            readonly="@ReadOnly"
            autocomplete="@ResolvedAutocomplete"
            autocorrect="@(IsPasswordMode && PreventPasswordManager ? "off" : null)"
            autocapitalize="@(IsPasswordMode && PreventPasswordManager ? "off" : null)"
            spellcheck="@(IsPasswordMode && PreventPasswordManager ? "false" : null)"
            data-1p-ignore="@(IsPasswordMode && PreventPasswordManager ? "true" : null)"
            data-lpignore="@(IsPasswordMode && PreventPasswordManager ? "true" : null)"
            data-bwignore="@(IsPasswordMode && PreventPasswordManager ? "true" : null)"
            data-form-type="@(IsPasswordMode && PreventPasswordManager ? "other" : null)"
            aria-required="@Required"
            aria-invalid="@HasError"
            aria-describedby="@(HasVisibleError ? _errorId : null)"
            class="w-full bg-transparent border-0 px-3.5 py-2.5 text-base sm:text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0 disabled:cursor-not-allowed @(!string.IsNullOrWhiteSpace(Icon) ? "!pl-1.5" : "")" />

        @if (Type == "password")
        {
            <AppButton Color="@ComponentColor.Default"
                       Variant="@ButtonVariant.Light"
                       Size="@ComponentSize.Small"
                       IconOnly="true"
                       Class="mr-1.5 !text-slate-400 hover:!text-slate-600"
                       aria-label="@(_isPasswordVisible ? "Hide password" : "Show password")"
                       aria-controls="@_inputId"
                       aria-pressed="@(_isPasswordVisible ? "true" : "false")"
                       Title="@(_isPasswordVisible ? "Hide password" : "Show password")"
                       OnClick="TogglePasswordVisibility">
                <i class="fa-regular @(_isPasswordVisible ? "fa-eye-slash" : "fa-eye") text-sm" aria-hidden="true"></i>
            </AppButton>
        }
    </div>

    @if (HasVisibleError)
    {
        <p id="@_errorId" role="alert" class="mt-1.5 text-xs text-rose-500 flex items-center gap-1">
            <i class="fa-solid fa-circle-exclamation text-[11px] shrink-0" aria-hidden="true"></i>
            <span>@ErrorMessage</span>
        </p>
    }
    else if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p class="mt-1 text-xs text-slate-500">@HelpText</p>
    }
</div>
