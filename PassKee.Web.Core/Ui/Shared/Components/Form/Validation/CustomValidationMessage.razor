@namespace PassKee.Web.Core.Ui.Shared.Components.Form.Validation
@typeparam TValue
@using Microsoft.AspNetCore.Components.Forms

@if (CurrentEditContext != null && For != null)
{
    @foreach (var message in CurrentEditContext.GetValidationMessages(_fieldIdentifier))
    {
        <p class="mt-1.5 flex items-start gap-1.5 text-xs text-rose-500">
            <i class="fa-solid fa-circle-exclamation mt-0.5 text-[11px]"></i>
            <span>@message</span>
        </p>
    }
}
