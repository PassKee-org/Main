@namespace PassKee.Web.Core.Ui.Shared.Components.Form.TextField
@inherits PassKee.Web.Core.Ui.Shared.Components.Form.TextField.Core.BaseInputField<string>

<div
    class="@(IsFullWidth ? "w-full" : "w-auto") @WrapperClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label
            class="block mb-1.5 text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            @Label
            @if (IsRequired)
            {
                <span
                    class="text-rose-500 ms-0.5">*</span>
            }
        </label>
    }

    <div
        class="relative w-full">
        <textarea
            id="@Id"
            value="@_textValue"
            @oninput="OnInputChanged"
            @onchange="OnValueChanged"
            @onfocus="HandleFocus"
            @onblur="HandleBlur"
            rows="@Rows"
            placeholder="@Placeholder"
            disabled="@IsDisabled"
            readonly="@IsReadOnly"
            maxlength="@(MaxLength.HasValue ? MaxLength.Value.ToString() : null)"
            class="@ComputedTextareaClass"
            @attributes="AdditionalAttributes"></textarea>
    </div>

    @if (HasError && !string.IsNullOrWhiteSpace(FirstError))
    {
        <p
            class="mt-1.5 text-xs text-rose-500 flex items-center gap-1">
            <i
                class="fa-solid fa-circle-exclamation text-[11px]">
            </i>
            <span>@FirstError</span>
        </p>
    }
</div>
