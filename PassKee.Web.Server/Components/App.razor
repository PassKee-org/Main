@using Microsoft.AspNetCore.Components.Web
@using PassKee.Web

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    @if (!IsStaticServerPage)
    {
        <title>PassKee — Zero-Knowledge Password &amp; Secrets Manager</title>
    }
    <base href="/" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.6.0/css/all.min.css" integrity="sha384-h/hnnw1Bi4nbpD6kE7nYfCXzovi622sY5WBxww8ARKwpdLj5kUWjRuyiXaD1U2JT" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="css/app.min.css" />
    <link href="PassKee.Web.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="w-full bg-slate-50 text-slate-900 antialiased selection:bg-blue-600 selection:text-white">
@if (IsStaticServerPage)
{
    <StaticServerRoutes />
    <script src="js/landing.js" defer></script>
}
else
{
    <div id="app">
        <PassKee.Web.App @rendermode="PageRenderMode" />
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/interop.js"></script>
}
</body>
</html>
