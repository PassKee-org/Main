@page "/not-found"
@layout PassKee.Web.Server.Components.Layout.StaticLandingLayout
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<section class="relative isolate flex min-h-[65vh] items-center overflow-hidden bg-gradient-to-br from-blue-50 via-white to-slate-100 px-4 py-16 sm:px-6">
	<div class="mx-auto grid w-full max-w-5xl items-center gap-10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-16">
		<div class="relative flex min-h-52 items-center justify-center md:min-h-72">
			<div class="absolute h-48 w-48 rounded-full border border-blue-200/70 sm:h-60 sm:w-60"></div>
			<div class="absolute h-36 w-36 rounded-full border border-slate-300/80 sm:h-44 sm:w-44"></div>
			<div class="relative flex h-28 w-28 items-center justify-center rounded-full bg-white text-blue-700 shadow-xl shadow-blue-900/10 ring-1 ring-slate-200 sm:h-36 sm:w-36">
				<span class="text-4xl font-bold sm:text-5xl">404</span>
			</div>
			<span class="absolute right-[18%] top-[16%] flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 shadow-sm" aria-hidden="true">
				<i class="fa-solid fa-key"></i>
			</span>
			<span class="absolute bottom-[15%] left-[18%] flex h-10 w-10 items-center justify-center rounded-xl bg-rose-100 text-rose-700 shadow-sm" aria-hidden="true">
				<i class="fa-solid fa-location-crosshairs"></i>
			</span>
		</div>

		<div class="max-w-xl">
			<p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-700">Page not found</p>
			<h1 class="mt-3 text-3xl font-bold leading-tight text-slate-950 sm:text-4xl">This address led nowhere.</h1>
			<p class="mt-4 max-w-lg text-base leading-7 text-slate-600">
				The page may have moved, or the address may be incomplete. Your vault and account are unchanged.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="/" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
					<i class="fa-solid fa-house" aria-hidden="true"></i>
					Back to home
				</a>
				<a href="/login" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500">
					<i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
					Sign in
				</a>
			</div>
		</div>
	</div>
</section>
