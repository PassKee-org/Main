<section aria-labelledby="help-hero-heading" class="border-b border-slate-200/80 bg-gradient-to-b from-sky-50/60 via-white to-slate-50 py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-sky-200 bg-sky-50 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-sky-800">
            <i class="fa-regular fa-life-ring text-sky-600" aria-hidden="true"></i>
            <span>Help Center &amp; Practical Documentation</span>
        </div>

        <h1 id="help-hero-heading" class="mt-5 text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">
            How Can We Help You Protect Your Vault?
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-slate-600">
            Concise, practical guides on your 128-bit Secret Key, signing in from new devices, 15-minute auto-lock, encrypted sharing, and KeePass (<code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-800">.kdbx</code>) migration.
        </p>

        <form method="get" action="/help" role="search" data-help-search-form class="mx-auto mt-8 max-w-2xl">
            <div class="relative flex items-center">
                <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-4 text-slate-400" aria-hidden="true"></i>
                <input type="search"
                       name="q"
                       value="@SearchQuery"
                       data-help-search-input
                       aria-label="Search help articles and FAQ"
                       placeholder="Search e.g. 'Secret Key', 'new device', '15 minutes', '.kdbx', '# share link'..."
                       class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-28 text-sm sm:text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-600/20" />
                <button type="submit"
                        class="absolute right-2 rounded-xl bg-sky-600 px-4 py-2 text-xs sm:text-sm font-semibold text-white hover:bg-sky-700 transition-colors cursor-pointer">
                    Search
                </button>
            </div>
        </form>

        <nav aria-label="FAQ topic filters" class="mt-6 flex flex-wrap items-center justify-center gap-2" data-help-category-nav>
            @foreach (var cat in Categories)
            {
                var href = cat.Id == "all" ? "/help" : $"/help?category={cat.Id}";
                <a href="@href"
                   data-help-category="@cat.Id"
                   class="@GetCategoryPillClass(cat.Id)">
                    <i class="@cat.IconClass text-xs opacity-80" aria-hidden="true"></i>
                    <span>@cat.Label</span>
                </a>
            }
        </nav>
    </div>
</section>

