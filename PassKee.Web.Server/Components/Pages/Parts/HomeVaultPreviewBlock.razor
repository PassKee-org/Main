<div class="mx-auto max-w-6xl overflow-hidden rounded-2xl sm:rounded-3xl border border-slate-200/90 bg-slate-950 shadow-2xl shadow-slate-900/15" data-vault-preview>
    <div class="flex items-center justify-between border-b border-slate-800 bg-slate-900/90 px-4 py-3 sm:px-6">
        <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-rose-500/80" aria-hidden="true"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400/80" aria-hidden="true"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-500/80" aria-hidden="true"></span>
            <span class="ml-2 text-xs font-medium text-slate-400">PassKee Web Vault — 3-Panel Workspace</span>
        </div>
        <div class="flex items-center gap-2 text-xs">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-medium text-emerald-300">
                <i class="fa-solid fa-lock text-[10px]" aria-hidden="true"></i>
                <span>Decrypted Locally in RAM</span>
            </span>
            <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-slate-700 bg-slate-800 px-2.5 py-0.5 font-medium text-slate-300">
                <i class="fa-regular fa-clock text-[10px] text-blue-400" aria-hidden="true"></i>
                <span>Auto-Lock: 15m</span>
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 bg-white text-left">
        @* Panel 1: Sidebar (Vaults & Folders) *@
        <aside aria-label="Vaults and directories preview" class="border-b lg:border-b-0 lg:border-r border-slate-200 bg-slate-50/90 p-4 lg:col-span-3">
            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2.5 shadow-2xs">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-600 text-xs font-bold text-white">
                        <i class="fa-solid fa-vault" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <p class="truncate text-xs font-bold text-slate-900">Personal Vault</p>
                        <p class="text-[11px] text-emerald-600 font-medium">42 encrypted items</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-down text-xs text-slate-400" aria-hidden="true"></i>
            </div>

            <p class="mt-4 px-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">Folders</p>
            <ul class="mt-1.5 space-y-1 text-xs font-medium">
                <li class="flex items-center justify-between rounded-lg bg-blue-50 px-2.5 py-2 text-blue-700 font-semibold">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-folder-open text-blue-600" aria-hidden="true"></i>
                        <span>Cloud &amp; DevOps</span>
                    </span>
                    <span class="rounded-md bg-blue-100 px-1.5 py-0.5 text-[10px] font-bold text-blue-800">3</span>
                </li>
                <li class="flex items-center justify-between rounded-lg px-2.5 py-2 text-slate-600">
                    <span class="flex items-center gap-2">
                        <i class="fa-regular fa-folder text-slate-400" aria-hidden="true"></i>
                        <span>Banking &amp; Cards</span>
                    </span>
                    <span class="text-[10px] text-slate-400">8</span>
                </li>
                <li class="flex items-center justify-between rounded-lg px-2.5 py-2 text-slate-600">
                    <span class="flex items-center gap-2">
                        <i class="fa-regular fa-folder text-slate-400" aria-hidden="true"></i>
                        <span>Family &amp; Wi-Fi</span>
                    </span>
                    <span class="text-[10px] text-slate-400">6</span>
                </li>
                <li class="flex items-center justify-between rounded-lg px-2.5 py-2 text-slate-600">
                    <span class="flex items-center gap-2">
                        <i class="fa-regular fa-folder text-slate-400" aria-hidden="true"></i>
                        <span>SSH &amp; Databases</span>
                    </span>
                    <span class="text-[10px] text-slate-400">11</span>
                </li>
            </ul>

            <div class="mt-4 border-t border-slate-200/80 pt-3">
                <div class="flex items-center justify-between px-2 text-[11px] text-slate-500">
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-file-import text-blue-600" aria-hidden="true"></i>
                        <span>KeePass (.kdbx)</span>
                    </span>
                    <span class="font-semibold text-blue-600">Import / Export</span>
                </div>
            </div>
        </aside>

        @* Panel 2: Credential List *@
        <div class="border-b lg:border-b-0 lg:border-r border-slate-200 bg-white p-4 lg:col-span-4">
            <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-500">
                <i class="fa-solid fa-magnifying-glass text-slate-400" aria-hidden="true"></i>
                <span>Search in Cloud &amp; DevOps...</span>
            </div>

            <div class="mt-3 space-y-2" role="tablist" aria-label="Sample vault credentials">
                <button type="button"
                        role="tab"
                        aria-selected="true"
                        data-preview-tab="github"
                        class="w-full text-left flex items-center justify-between gap-3 rounded-xl border border-blue-200 bg-blue-50/70 p-3 transition-colors cursor-pointer">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-900 text-white text-sm">
                            <i class="fa-brands fa-github" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="truncate text-xs sm:text-sm font-bold text-slate-900">GitHub Organization</p>
                            <p class="truncate text-xs text-slate-500">security-admin@passkee.org</p>
                        </div>
                    </div>
                    <span class="shrink-0 rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">Login</span>
                </button>

                <button type="button"
                        role="tab"
                        aria-selected="false"
                        data-preview-tab="postgres"
                        class="w-full text-left flex items-center justify-between gap-3 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-50 p-3 transition-colors cursor-pointer">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-white text-sm">
                            <i class="fa-solid fa-database" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="truncate text-xs sm:text-sm font-bold text-slate-900">PostgreSQL Primary Cluster</p>
                            <p class="truncate text-xs text-slate-500">db-prod-eu.passkee.internal:5432</p>
                        </div>
                    </div>
                    <span class="shrink-0 rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-semibold text-blue-800">Database</span>
                </button>

                <button type="button"
                        role="tab"
                        aria-selected="false"
                        data-preview-tab="ssh"
                        class="w-full text-left flex items-center justify-between gap-3 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-50 p-3 transition-colors cursor-pointer">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white text-sm">
                            <i class="fa-solid fa-terminal" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="truncate text-xs sm:text-sm font-bold text-slate-900">Production Bastion Ed25519</p>
                            <p class="truncate text-xs text-slate-500">SHA256:9fK3vL8xP2mQ...</p>
                        </div>
                    </div>
                    <span class="shrink-0 rounded-md bg-purple-100 px-2 py-0.5 text-[10px] font-semibold text-purple-800">SSH Key</span>
                </button>
            </div>
        </div>

        @* Panel 3: Credential Details *@
        <div class="bg-white p-5 sm:p-6 lg:col-span-5">
            <div data-preview-panel="github" class="space-y-4">
                <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-900 text-white text-lg">
                            <i class="fa-brands fa-github" aria-hidden="true"></i>
                        </span>
                        <div>
                            <h2 class="text-base font-bold text-slate-900">GitHub Organization</h2>
                            <p class="text-xs text-slate-500">Folder: Cloud &amp; DevOps • Updated 2m ago</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
                        <i class="fa-solid fa-share-nodes text-[11px]" aria-hidden="true"></i>
                        <span>Share #Link</span>
                    </span>
                </div>

                <div class="space-y-2.5 text-xs">
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Username / Email</p>
                        <p class="mt-1 font-mono text-xs sm:text-sm font-semibold text-slate-900">security-admin@passkee.org</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 flex items-center justify-between gap-2">
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Password (AES-256-GCM)</p>
                            <p class="mt-1 font-mono text-xs sm:text-sm font-semibold tracking-wider text-slate-900">••••••••••••••••••••</p>
                        </div>
                        <span class="rounded-lg bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-800">Bulletproof (128-bit)</span>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Website URL</p>
                        <p class="mt-1 font-medium text-blue-600">https://github.com/organizations/passkee</p>
                    </div>
                </div>
            </div>

            <div data-preview-panel="postgres" class="hidden space-y-4">
                <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-600 text-white text-lg">
                            <i class="fa-solid fa-database" aria-hidden="true"></i>
                        </span>
                        <div>
                            <h2 class="text-base font-bold text-slate-900">PostgreSQL Primary Cluster</h2>
                            <p class="text-xs text-slate-500">Folder: Cloud &amp; DevOps • TLS Required</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
                        <i class="fa-solid fa-share-nodes text-[11px]" aria-hidden="true"></i>
                        <span>Share #Link</span>
                    </span>
                </div>

                <div class="space-y-2.5 text-xs">
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Host &amp; Port</p>
                        <p class="mt-1 font-mono text-xs sm:text-sm font-semibold text-slate-900">db-prod-eu.passkee.internal:5432</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Database Role &amp; Secret</p>
                        <p class="mt-1 font-mono text-xs sm:text-sm font-semibold text-slate-900">vault_migrator • ••••••••••••••••••••</p>
                    </div>
                </div>
            </div>

            <div data-preview-panel="ssh" class="hidden space-y-4">
                <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-600 text-white text-lg">
                            <i class="fa-solid fa-terminal" aria-hidden="true"></i>
                        </span>
                        <div>
                            <h2 class="text-base font-bold text-slate-900">Production Bastion Ed25519</h2>
                            <p class="text-xs text-slate-500">Folder: Cloud &amp; DevOps • SSH Private Key</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                        <i class="fa-solid fa-shield-halved text-[11px]" aria-hidden="true"></i>
                        <span>E2EE Sealed</span>
                    </span>
                </div>

                <div class="space-y-2.5 text-xs">
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Public Key Fingerprint</p>
                        <p class="mt-1 font-mono text-xs font-semibold text-slate-900 break-all">SHA256:9fK3vL8xP2mQ7wR4tY6uJ1nB5cV8zX0aL3kM9pD2eF4</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Encrypted Private Key Payload</p>
                        <p class="mt-1 font-mono text-xs font-semibold text-slate-900">-----BEGIN OPENSSH PRIVATE KEY----- (Locked in RAM)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

