<div class="mx-auto max-w-6xl overflow-hidden rounded-2xl sm:rounded-3xl border border-slate-200/90 bg-slate-950 shadow-2xl shadow-slate-900/15" data-vault-preview>
    @* Top Workspace Header (mirrors AppHeaderBlock.razor) *@
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:px-6 text-left">
        <div class="flex items-center gap-3">
            <AppLogo Href="/app" Size="ComponentSize.Small" />
        </div>

        <div class="hidden md:flex flex-1 max-w-md items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-xs text-slate-400">
            <i class="fa-solid fa-magnifying-glass text-slate-400" aria-hidden="true"></i>
            <span>Search all items...</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 text-xs font-semibold">
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-slate-700 shadow-2xs">
                <i class="fa-solid fa-key text-sky-600" aria-hidden="true"></i>
                <span>Password</span>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-slate-700 shadow-2xs" title="UUID v4, UUID v7, Hex, Base64">
                <i class="fa-solid fa-fingerprint text-indigo-600" aria-hidden="true"></i>
                <span>GUID</span>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-700">
                <i class="fa-solid fa-lock text-amber-600" aria-hidden="true"></i>
                <span class="hidden sm:inline">Lock</span>
            </span>
            <span class="hidden sm:inline-flex items-center gap-1.5 rounded-lg border border-rose-200 bg-rose-50/70 px-2.5 py-1.5 text-rose-700">
                <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                <span>Logout</span>
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 bg-slate-50 text-left">
        @* Panel 1: Sidebar (mirrors VaultSidebarBlock.razor: Current Vault + Directories) *@
        <aside aria-label="Current vault and directories preview" class="border-b lg:border-b-0 lg:border-r border-slate-200 bg-slate-100/70 p-4 lg:col-span-4 space-y-3">
            @* Current Vault Card *@
            <div class="rounded-2xl border border-slate-200 bg-white p-3.5 shadow-2xs">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Current Vault</span>
                    <div class="flex items-center gap-1">
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[11px] text-slate-600" title="New Vault">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        </span>
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-md border border-sky-200 bg-sky-50 text-[11px] text-sky-700" title="Vault Actions">
                            <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                        </span>
                    </div>
                </div>

                <div class="mt-2 flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                    <div class="flex items-center gap-2 min-w-0">
                        <i class="fa-solid fa-vault text-sky-600 text-xs" aria-hidden="true"></i>
                        <span class="truncate text-xs font-bold text-slate-900">Personal Vault</span>
                    </div>
                    <i class="fa-solid fa-chevron-down text-[10px] text-slate-400" aria-hidden="true"></i>
                </div>

                <div class="mt-2.5 rounded-xl border border-slate-200/90 bg-slate-50/70 p-2 text-[11px] space-y-1">
                    <div class="flex items-center justify-between rounded-lg bg-white px-2 py-1.5 font-medium text-slate-700 shadow-2xs">
                        <span class="inline-flex items-center gap-1.5">
                            <i class="fa-solid fa-file-import text-sky-600" aria-hidden="true"></i>
                            <span>Import</span>
                        </span>
                        <span class="text-[10px] text-slate-400">From KeePass (.kdbx)</span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg px-2 py-1.5 font-medium text-slate-700">
                        <span class="inline-flex items-center gap-1.5">
                            <i class="fa-solid fa-download text-emerald-600" aria-hidden="true"></i>
                            <span>Backup</span>
                        </span>
                        <span class="text-[10px] text-slate-400">Export to KeePass (.kdbx)</span>
                    </div>
                </div>
            </div>

            @* Directories Card *@
            <div class="rounded-2xl border border-slate-200 bg-white p-3.5 shadow-2xs">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Directories</span>
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[11px] text-slate-600" title="New Directory">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </span>
                </div>

                <ul class="mt-2 space-y-1 text-xs font-medium">
                    <li class="flex items-center justify-between rounded-lg px-2.5 py-1.5 text-slate-600">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-inbox text-slate-400" aria-hidden="true"></i>
                            <span>No Directory</span>
                        </span>
                        <span class="text-[10px] text-slate-400">4</span>
                    </li>
                    <li class="flex items-center justify-between rounded-lg bg-sky-50 px-2.5 py-1.5 text-sky-700 font-semibold">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-folder-open text-sky-600" aria-hidden="true"></i>
                            <span>Cloud &amp; DevOps</span>
                        </span>
                        <span class="rounded-md bg-sky-100 px-1.5 py-0.5 text-[10px] font-bold text-sky-800">3</span>
                    </li>
                    <li class="flex items-center justify-between rounded-lg px-2.5 py-1.5 text-slate-600">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-folder text-slate-400" aria-hidden="true"></i>
                            <span>Banking &amp; Cards</span>
                        </span>
                        <span class="text-[10px] text-slate-400">8</span>
                    </li>
                    <li class="flex items-center justify-between rounded-lg px-2.5 py-1.5 text-slate-600">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-folder text-slate-400" aria-hidden="true"></i>
                            <span>SSH &amp; Databases</span>
                        </span>
                        <span class="text-[10px] text-slate-400">11</span>
                    </li>
                    <li class="mt-1 border-t border-slate-100 pt-1.5 flex items-center justify-between rounded-lg px-2.5 py-1.5 text-slate-500">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-box-archive text-slate-400" aria-hidden="true"></i>
                            <span>Archive</span>
                        </span>
                        <span class="text-[10px] text-slate-400">2</span>
                    </li>
                </ul>
            </div>
        </aside>

        @* Panel 2 & 3: Credential List + Selected Credential Modal/Inspector *@
        <div class="bg-white p-4 sm:p-6 lg:col-span-8 space-y-4">
            @* Directory Header + New Item Button (mirrors CredentialListBlock.razor) *@
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-3.5">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                    </span>
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-sm sm:text-base font-bold text-slate-900">Cloud &amp; DevOps</h2>
                            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">3 items</span>
                        </div>
                        <p class="text-[11px] text-slate-500">8 item types: Login • Secure Note • Card • Password • File • Database • SSH Key • Server</p>
                    </div>
                </div>

                <span class="inline-flex items-center gap-1.5 rounded-xl bg-sky-600 px-3.5 py-2 text-xs font-semibold text-white shadow-xs">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>New Item</span>
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
                @* Interactive Item List *@
                <div class="md:col-span-5 space-y-2" role="tablist" aria-label="Sample vault credentials">
                    <button type="button"
                            role="tab"
                            aria-selected="true"
                            data-preview-tab="github"
                            class="w-full text-left flex items-center justify-between gap-2.5 rounded-xl border border-sky-200 bg-sky-50/70 p-3 transition-colors cursor-pointer">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-white text-xs">
                                <i class="fa-solid fa-globe" aria-hidden="true"></i>
                            </span>
                            <div class="min-w-0">
                                <p class="truncate text-xs font-bold text-slate-900">GitHub Organization</p>
                                <p class="truncate text-[11px] text-slate-500">security-admin@passkee.org</p>
                            </div>
                        </div>
                        <span class="shrink-0 rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">Login</span>
                    </button>

                    <button type="button"
                            role="tab"
                            aria-selected="false"
                            data-preview-tab="postgres"
                            class="w-full text-left flex items-center justify-between gap-2.5 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-50 p-3 transition-colors cursor-pointer">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-600 text-white text-xs">
                                <i class="fa-solid fa-database" aria-hidden="true"></i>
                            </span>
                            <div class="min-w-0">
                                <p class="truncate text-xs font-bold text-slate-900">PostgreSQL Primary Cluster</p>
                                <p class="truncate text-[11px] text-slate-500">db-prod-eu.passkee.internal:5432</p>
                            </div>
                        </div>
                        <span class="shrink-0 rounded-md bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">Database</span>
                    </button>

                    <button type="button"
                            role="tab"
                            aria-selected="false"
                            data-preview-tab="ssh"
                            class="w-full text-left flex items-center justify-between gap-2.5 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-50 p-3 transition-colors cursor-pointer">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-600 text-white text-xs">
                                <i class="fa-solid fa-terminal" aria-hidden="true"></i>
                            </span>
                            <div class="min-w-0">
                                <p class="truncate text-xs font-bold text-slate-900">Production Bastion Ed25519</p>
                                <p class="truncate text-[11px] text-slate-500">SHA256:9fK3vL8xP2mQ...</p>
                            </div>
                        </div>
                        <span class="shrink-0 rounded-md bg-purple-100 px-2 py-0.5 text-[10px] font-semibold text-purple-800">SSH Key</span>
                    </button>
                </div>

                @* Selected Item Inspector *@
                <div class="md:col-span-7 rounded-2xl border border-slate-200 bg-slate-50/50 p-4">
                    <div data-preview-panel="github" class="space-y-3">
                        <div class="flex items-start justify-between gap-2 border-b border-slate-200/80 pb-3">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">GitHub Organization</h3>
                                <p class="text-[11px] text-slate-500">Login • Directory: Cloud &amp; DevOps</p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700" title="Share a link to this item">
                                <i class="fa-solid fa-share-nodes text-[10px]" aria-hidden="true"></i>
                                <span>Share Link</span>
                            </span>
                        </div>

                        <div class="space-y-2 text-xs">
                            <div class="rounded-xl border border-slate-200 bg-white p-2.5">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Username / Email</p>
                                <p class="mt-0.5 font-mono text-xs font-semibold text-slate-900">security-admin@passkee.org</p>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-white p-2.5 flex items-center justify-between gap-2">
                                <div>
                                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Password (AES-256-GCM)</p>
                                    <p class="mt-0.5 font-mono text-xs font-semibold tracking-wider text-slate-900">••••••••••••••••••••</p>
                                </div>
                                <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800">Strong</span>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-white p-2.5">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Website URL</p>
                                <p class="mt-0.5 font-medium text-sky-600 truncate">https://github.com/organizations/passkee</p>
                            </div>
                        </div>
                    </div>

                    <div data-preview-panel="postgres" class="hidden space-y-3">
                        <div class="flex items-start justify-between gap-2 border-b border-slate-200/80 pb-3">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">PostgreSQL Primary Cluster</h3>
                                <p class="text-[11px] text-slate-500">Database • Directory: Cloud &amp; DevOps</p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700">
                                <i class="fa-solid fa-share-nodes text-[10px]" aria-hidden="true"></i>
                                <span>Share Link</span>
                            </span>
                        </div>

                        <div class="space-y-2 text-xs">
                            <div class="rounded-xl border border-slate-200 bg-white p-2.5">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Host &amp; Port</p>
                                <p class="mt-0.5 font-mono text-xs font-semibold text-slate-900">db-prod-eu.passkee.internal:5432</p>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-white p-2.5">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Database &amp; Credentials</p>
                                <p class="mt-0.5 font-mono text-xs font-semibold text-slate-900">passkee_prod • vault_migrator • ••••••••••••</p>
                            </div>
                        </div>
                    </div>

                    <div data-preview-panel="ssh" class="hidden space-y-3">
                        <div class="flex items-start justify-between gap-2 border-b border-slate-200/80 pb-3">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">Production Bastion Ed25519</h3>
                                <p class="text-[11px] text-slate-500">SSH Key • Directory: Cloud &amp; DevOps</p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">
                                <i class="fa-solid fa-shield-halved text-[10px]" aria-hidden="true"></i>
                                <span>AES-256-GCM</span>
                            </span>
                        </div>

                        <div class="space-y-2 text-xs">
                            <div class="rounded-xl border border-slate-200 bg-white p-2.5">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Public Key Fingerprint</p>
                                <p class="mt-0.5 font-mono text-xs font-semibold text-slate-900 break-all">SHA256:9fK3vL8xP2mQ7wR4tY6uJ1nB5cV8zX0aL3kM9pD2eF4</p>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-white p-2.5">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Private Key Payload</p>
                                <p class="mt-0.5 font-mono text-xs font-semibold text-slate-900">-----BEGIN OPENSSH PRIVATE KEY----- (Decrypted in RAM)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
