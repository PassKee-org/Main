<section id="password-generator" aria-labelledby="generator-heading" class="content-defer border-b border-slate-200/80 bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-sky-600">Interactive Security Tool</p>
            <h2 id="generator-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
                Create Your First Uncrackable Password Right Now
            </h2>
            <p class="mt-3 text-base text-slate-600">
                Test our client-side cryptographic generator right on this page. PassKee creates and remembers high-entropy passwords like these for every site you use.
            </p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 items-start" data-password-generator>
            @* Left: Interactive Password Generator Widget *@
            <div class="lg:col-span-7 rounded-2xl sm:rounded-3xl border border-slate-200 bg-slate-50/70 p-5 sm:p-8 shadow-sm">
                <div class="rounded-2xl border border-slate-300/90 bg-white p-4 sm:p-5 shadow-2xs">
                    <div class="flex items-center justify-between gap-2 text-xs font-semibold text-slate-500 mb-2">
                        <span class="inline-flex items-center gap-1.5 text-emerald-700" data-pw-strength-badge>
                            <i class="fa-solid fa-shield-check text-emerald-600" aria-hidden="true"></i>
                            <span data-pw-strength-text>Bulletproof • 131 bits of entropy</span>
                        </span>
                        <span class="font-mono text-[11px] text-slate-400" data-pw-crack-inline>Crack time: &gt; 500 billion years</span>
                    </div>

                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                        <output for="pw-length-slider"
                                aria-live="polite"
                                data-pw-output
                                class="block flex-1 rounded-xl bg-slate-900 px-4 py-3.5 font-mono text-sm sm:text-base font-bold tracking-wider text-emerald-300 break-all select-all">k9#mP$9vL2!xR7@qW4&amp;z</output>
                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button"
                                    data-pw-regenerate
                                    aria-label="Generate new random password"
                                    class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer">
                                <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                            </button>
                            <button type="button"
                                    data-pw-copy
                                    class="inline-flex h-11 flex-1 sm:flex-initial items-center justify-center gap-2 rounded-xl bg-sky-600 px-4 text-xs sm:text-sm font-semibold text-white hover:bg-sky-700 transition-colors cursor-pointer">
                                <i class="fa-regular fa-copy" data-pw-copy-icon aria-hidden="true"></i>
                                <span data-pw-copy-label>Copy Password</span>
                            </button>
                        </div>
                    </div>

                    <div class="mt-3.5 h-2 w-full overflow-hidden rounded-full bg-slate-100" aria-hidden="true">
                        <div data-pw-meter class="h-full w-full rounded-full bg-emerald-500 transition-all duration-300"></div>
                    </div>
                </div>

                <div class="mt-6 space-y-5">
                    <div>
                        <div class="flex items-center justify-between text-xs sm:text-sm font-semibold text-slate-800">
                            <label for="pw-length-slider">Password Length</label>
                            <span class="rounded-lg bg-sky-100 px-2.5 py-0.5 font-mono text-xs font-bold text-sky-800">
                                <span data-pw-length-value>20</span> characters
                            </span>
                        </div>
                        <input id="pw-length-slider"
                               type="range"
                               min="8"
                               max="64"
                               value="20"
                               data-pw-length
                               class="mt-2.5 h-2 w-full cursor-pointer appearance-none rounded-lg bg-slate-200 accent-sky-600" />
                        <div class="mt-1 flex justify-between text-[11px] text-slate-400 font-mono">
                            <span>8 chars</span>
                            <span>16 chars</span>
                            <span>32 chars</span>
                            <span>64 chars</span>
                        </div>
                    </div>

                    <fieldset>
                        <legend class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2.5">Character Sets</legend>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-800 hover:border-sky-300">
                                <input type="checkbox" checked data-pw-upper class="h-4 w-4 rounded accent-sky-600" />
                                <span>A–Z Upper</span>
                            </label>
                            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-800 hover:border-sky-300">
                                <input type="checkbox" checked data-pw-lower class="h-4 w-4 rounded accent-sky-600" />
                                <span>a–z Lower</span>
                            </label>
                            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-800 hover:border-sky-300">
                                <input type="checkbox" checked data-pw-digits class="h-4 w-4 rounded accent-sky-600" />
                                <span>0–9 Digits</span>
                            </label>
                            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-800 hover:border-sky-300">
                                <input type="checkbox" checked data-pw-symbols class="h-4 w-4 rounded accent-sky-600" />
                                <span>!@@#$ Symbols</span>
                            </label>
                        </div>
                    </fieldset>
                </div>
            </div>

            @* Right: Crack Time Comparison Cards *@
            <div class="lg:col-span-5 space-y-3.5">
                <h3 class="text-base font-bold text-slate-900">
                    How Long Would It Take Attackers to Crack?
                </h3>

                <div class="rounded-2xl border border-rose-200 bg-rose-50/60 p-4">
                    <div class="flex items-center justify-between gap-2">
                        <code class="rounded-lg bg-white px-2.5 py-1 font-mono text-xs font-bold text-rose-800 border border-rose-200">Password1 / 123456</code>
                        <span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-bold text-rose-800">Less than 1 second</span>
                    </div>
                    <p class="mt-2 text-xs text-slate-600">
                        Exposed immediately by automated credential-stuffing dictionaries and leaked password lists.
                    </p>
                </div>

                <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4">
                    <div class="flex items-center justify-between gap-2">
                        <code class="rounded-lg bg-white px-2.5 py-1 font-mono text-xs font-bold text-amber-900 border border-amber-200">Qwerty2026!</code>
                        <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-bold text-amber-900">~3 hours</span>
                    </div>
                    <p class="mt-2 text-xs text-slate-600">
                        Human-picked patterns with a capital letter, year, and exclamation mark fall quickly to modern GPU clusters.
                    </p>
                </div>

                <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 shadow-2xs">
                    <div class="flex items-center justify-between gap-2">
                        <code class="rounded-lg bg-white px-2.5 py-1 font-mono text-xs font-bold text-emerald-900 border border-emerald-200">k9#mP$9vL2!xR7@@q</code>
                        <span class="rounded-full bg-emerald-600 px-2.5 py-0.5 text-xs font-bold text-white">&gt; 500 billion years</span>
                    </div>
                    <p class="mt-2 text-xs text-slate-700 font-medium">
                        PassKee generates and remembers unique passwords like this for every account—so you only ever remember one Master Password.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

