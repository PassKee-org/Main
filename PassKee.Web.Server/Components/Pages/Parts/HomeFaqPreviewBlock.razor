<section id="faq-preview" aria-labelledby="home-faq-heading" class="content-defer bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Essential Answers</p>
            <h2 id="home-faq-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
                Frequently Asked Questions
            </h2>
            <p class="mt-3 text-base text-slate-600">
                Straightforward answers on how your Secret Key, Emergency Kit, and device sign-in work.
            </p>
        </div>

        <div class="mt-10 space-y-3.5">
            @for (var i = 0; i < TopFaqItems.Count; i++)
            {
                var item = TopFaqItems[i];
                <details name="home-faq" open="@(i == 0)" class="group rounded-2xl border border-slate-200 bg-slate-50/60 open:bg-white open:shadow-sm transition-all">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-base font-bold text-slate-900 hover:text-blue-600">
                        <span>@item.Question</span>
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-200/70 text-slate-600 group-open:rotate-180 group-open:bg-blue-100 group-open:text-blue-700 transition-transform">
                            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                        </span>
                    </summary>
                    <div class="border-t border-slate-100 px-5 pb-5 pt-3.5 text-sm leading-relaxed text-slate-600">
                        <p>@item.Answer</p>
                    </div>
                </details>
            }
        </div>

        <div class="mt-10 rounded-3xl bg-slate-900 p-6 sm:p-10 text-center text-white shadow-xl">
            <h3 class="text-xl sm:text-2xl font-extrabold">Ready to Lock Down Your Digital Life?</h3>
            <p class="mx-auto mt-2 max-w-2xl text-sm sm:text-base text-slate-300">
                Create your encrypted vault in under a minute, or browse our full Knowledge Base to learn more about Zero-Knowledge security.
            </p>
            <div class="mt-6 flex flex-wrap items-center justify-center gap-3.5">
                <a href="/registration" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-500 transition-colors">
                    <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                    <span>Create Free Vault</span>
                </a>
                <a href="/help" class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800 px-5 py-3 text-sm font-semibold text-slate-200 hover:bg-slate-700 transition-colors">
                    <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
                    <span>Open Full Help Center &amp; FAQ</span>
                </a>
            </div>
        </div>
    </div>
</section>

