<section id="faq" aria-labelledby="help-faq-heading" class="content-defer bg-slate-50 py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Knowledge Base</p>
                <h2 id="help-faq-heading" class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">
                    Practical Frequently Asked Questions
                </h2>
            </div>
            <p class="text-xs font-medium text-slate-500" data-faq-count-status>
                Showing direct answers without filler
            </p>
        </div>

        <div class="mt-8 space-y-3.5" data-faq-container>
            @foreach (var item in AllFaqItems)
            {
                var isVisible = MatchesServerFilter(item);
                <details id="@item.Id"
                         open="@isVisible"
                         hidden="@(isVisible ? null : "until-found")"
                         data-faq-item
                         data-faq-category="@item.CategoryId"
                         data-faq-search="@BuildSearchBlob(item)"
                         class="group rounded-2xl border border-slate-200 bg-white shadow-2xs transition-all">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left hover:bg-slate-50/80 rounded-2xl">
                        <div class="space-y-1">
                            <span class="inline-block rounded-md bg-blue-50 px-2 py-0.5 text-[11px] font-bold text-blue-700">
                                @item.CategoryLabel
                            </span>
                            <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600">
                                @item.Question
                            </h3>
                        </div>
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 group-open:rotate-180 group-open:bg-blue-100 group-open:text-blue-700 transition-transform">
                            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                        </span>
                    </summary>
                    <div class="border-t border-slate-100 px-5 pb-5 pt-4 text-sm leading-relaxed text-slate-600">
                        <p>@item.Answer</p>
                    </div>
                </details>
            }
        </div>

        <div data-faq-empty-state class="hidden mt-8 rounded-2xl border border-slate-200 bg-white p-8 text-center">
            <i class="fa-regular fa-circle-question text-2xl text-slate-400" aria-hidden="true"></i>
            <h3 class="mt-3 text-base font-bold text-slate-900">No matching questions found</h3>
            <p class="mt-1 text-xs sm:text-sm text-slate-500">
                Try clearing your search filter or browse all categories below.
            </p>
            <a href="/help" data-faq-reset class="mt-4 inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-700">
                Show All FAQ Topics
            </a>
        </div>

        <div class="mt-12 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-2xs">
            <div>
                <h3 class="text-lg font-bold text-slate-900">Want a Deeper Dive Into Our Cryptography?</h3>
                <p class="mt-1 text-xs sm:text-sm text-slate-600">
                    Read our Security &amp; Zero-Knowledge architecture overview to see how Argon2id, AES-256-GCM, and #fragment links work under the hood.
                </p>
            </div>
            <a href="/security" class="shrink-0 inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-xs sm:text-sm font-semibold text-white hover:bg-slate-800 transition-colors">
                <i class="fa-solid fa-shield-halved text-emerald-400" aria-hidden="true"></i>
                <span>Read Security Architecture</span>
            </a>
        </div>
    </div>
</section>

