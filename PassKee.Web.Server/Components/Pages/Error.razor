@page "/Error"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>Error — PassKee</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-rose-200 bg-white p-8 shadow-sm">
        <h1 class="text-2xl font-bold text-slate-900">An error occurred while processing your request.</h1>
        @if (ShowRequestId)
        {
            <p class="mt-3 text-sm text-slate-600">
                <strong>Request ID:</strong> <code class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-800">@RequestId</code>
            </p>
        }
        <div class="mt-6">
            <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors">
                <i class="fa-solid fa-house" aria-hidden="true"></i>
                <span>Return to PassKee Home</span>
            </a>
        </div>
    </div>
</section>
