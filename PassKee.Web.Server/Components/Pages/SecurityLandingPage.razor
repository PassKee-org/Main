@page "/security"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>PassKee Security Architecture — Protection &amp; Zero-Knowledge</PageTitle>

<HeadContent>
    <meta name="description" content="Learn how PassKee protects your data with the Dual-Lock security model (Master Password + 128-bit Secret Key), why our servers cannot read your passwords, and how to store your Emergency Kit." />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PassKee" />
    <meta property="og:title" content="PassKee Security Architecture — Protection &amp; Zero-Knowledge" />
    <meta property="og:description" content="Your data belongs only to you. Detailed breakdown of PassKee's Zero-Knowledge encryption, Emergency Kit, and #fragment link sharing." />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:image" content="@($"{BaseUrl}/icon-192.png")" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="PassKee Security Architecture — Protection &amp; Zero-Knowledge" />
    <meta name="twitter:description" content="Learn how PassKee protects your vault with Dual-Lock client-side encryption and why our servers can never read or reset your passwords." />

    <script type="application/ld+json">@((MarkupString)JsonLd)</script>
</HeadContent>

<SecurityHeroBlock />
<SecurityZeroKnowledgeBlock />
<SecurityDualKeyBlock />
<SecurityNoResetBlock />
<SecurityLinkSharingBlock />

