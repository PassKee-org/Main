@page "/help"
@page "/faq"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>PassKee Help Center &amp; FAQ — Secret Key, Setup &amp; KeePass Import</PageTitle>

<HeadContent>
    <meta name="description" content="Practical PassKee knowledge base: how to save your 128-bit Secret Key and Emergency Kit, sign in on a new device, configure 15-minute auto-lock, share passwords safely, and import KeePass (.kdbx) files." />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PassKee" />
    <meta property="og:title" content="PassKee Help Center &amp; FAQ — Secret Key, Setup &amp; KeePass Import" />
    <meta property="og:description" content="Step-by-step quick start guide and practical answers on PassKee's Secret Key, Emergency Kit, 15-minute auto-lock, and local .kdbx migration." />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:image" content="@($"{BaseUrl}/icon-192.png")" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="PassKee Help Center &amp; FAQ" />
    <meta name="twitter:description" content="Direct, practical answers on your Secret Key, Emergency Kit, new device sign-in, and KeePass (.kdbx) import." />

    <script type="application/ld+json">@((MarkupString)JsonLd)</script>
</HeadContent>

<HelpSearchHeaderBlock
    SearchQuery="@SearchQuery"
    ActiveCategory="@ActiveCategory" />

<HelpQuickStartBlock />

<HelpFaqListBlock
    SearchQuery="@SearchQuery"
    ActiveCategory="@ActiveCategory" />

