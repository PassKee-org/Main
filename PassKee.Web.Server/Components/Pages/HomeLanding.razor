@page "/"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>PassKee - Zero-Knowledge Password & Secrets Manager</PageTitle>

<section class="py-20 bg-gradient-to-b from-blue-50/50 via-white to-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100/80 text-blue-800 text-xs font-semibold uppercase tracking-wider mb-6">
            <i class="fa-solid fa-lock text-blue-600"></i> Zero-Knowledge Architecture
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Secure Password & Secrets Management with <span class="text-blue-600">Absolute Privacy</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
            PassKee encrypts everything on your device before it ever touches our servers. No one—not even us—can see your master password or decrypt your vault.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
            <a href="/registration" class="inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-lg shadow-blue-500/20 transition-all hover:shadow-blue-500/30">
                <i class="fa-solid fa-user-plus mr-2"></i> Create Free Account
            </a>
            <a href="/login" class="inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-slate-700 bg-white hover:bg-slate-100 border border-slate-300 rounded-xl shadow-xs transition-all">
                <i class="fa-solid fa-right-to-bracket mr-2"></i> Sign In to Vault
            </a>
        </div>
        <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-8 text-left max-w-4xl mx-auto">
            <div class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs">
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-key"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">End-to-End Encrypted</h3>
                <p class="text-sm text-slate-600">Argon2id KDF and AES-256-GCM AEAD encryption keep your vault uncrackable.</p>
            </div>
            <div class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Zero-Knowledge</h3>
                <p class="text-sm text-slate-600">Your Master Key and Secret Key never leave your client device.</p>
            </div>
            <div class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs">
                <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Blazing Fast</h3>
                <p class="text-sm text-slate-600">Powered by WebAssembly for instant cryptographic computations in browser.</p>
            </div>
        </div>
    </div>
</section>

