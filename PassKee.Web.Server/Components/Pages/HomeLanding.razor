@page "/"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>PassKee — Cloud Password Manager with Complete Privacy</PageTitle>

<HeadContent>
    <meta name="description" content="Safely store passwords, bank cards, SSH keys, and notes. Automatic multi-device cloud sync, one-click encrypted sharing, and Zero-Knowledge Dual-Lock protection on your device." />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PassKee" />
    <meta property="og:title" content="PassKee — Cloud Password Manager with Complete Privacy" />
    <meta property="og:description" content="Your passwords under reliable protection, always within reach. Client-side Argon2id and AES-256-GCM encryption with Master Password + 128-bit Secret Key." />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:image" content="@($"{BaseUrl}/icon-192.png")" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="PassKee — Cloud Password Manager with Complete Privacy" />
    <meta name="twitter:description" content="Zero-Knowledge password and secrets manager with Dual-Lock protection, local KeePass (.kdbx) import, and encrypted #fragment link sharing." />

    <script type="application/ld+json">@((MarkupString)JsonLd)</script>
</HeadContent>

<HomeHeroBlock />
<HomePasswordGeneratorBlock />
<HomeDualLockBlock />
<HomeZeroKnowledgeBlock />
<HomeComparisonBlock />
<HomeMigrationBlock />
<HomeFaqPreviewBlock />
